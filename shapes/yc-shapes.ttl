@prefix yc: <https://w3id.org/yugachakra#> .
@prefix ycsh: <https://w3id.org/yugachakra/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

ycsh: sh:declare [ sh:prefix "yc" ; sh:namespace "https://w3id.org/yugachakra#"^^xsd:anyURI ] .

ycsh:EntryShape a sh:NodeShape ;
    sh:targetClass yc:Entry ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path rdfs:comment ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path yc:period ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( yc:period-origins yc:period-satya yc:period-treta yc:period-dvapara yc:period-kali yc:period-deva yc:period-history ) ] ;
    sh:property [ sh:path yc:tier ; sh:maxCount 1 ; sh:in ( yc:tier-core yc:tier-layer yc:tier-vulgate yc:tier-purana yc:tier-folk ) ] ;
    sh:property [ sh:path dcterms:source ; sh:node ycsh:CitationShape ] ;
    sh:sparql [
        sh:message "Every entry outside recorded history needs a source tier" ;
        sh:prefixes ycsh: ;
        sh:select """SELECT $this WHERE {
            $this yc:period ?p . FILTER (?p != yc:period-history)
            FILTER NOT EXISTS { $this yc:tier ?t }
        }""" ] ;
    sh:sparql [
        sh:message "Every entry has exactly one kind: Deva, Avatar, Sage, Person, Event or Story" ;
        sh:prefixes ycsh: ;
        sh:select """SELECT $this WHERE {
            { SELECT $this (COUNT(DISTINCT ?k) AS ?n) WHERE {
                $this a ?k . FILTER (?k IN (yc:Deva, yc:Avatar, yc:Sage, yc:Person, yc:Event, yc:Story))
              } GROUP BY $this }
            FILTER (?n != 1)
        }""" ] .

ycsh:FigureShape a sh:NodeShape ;
    sh:targetClass yc:Figure ;
    sh:property [ sh:path yc:being ; sh:maxCount 1 ;
        sh:in ( yc:being-god yc:being-asura yc:being-rakshasa yc:being-naga yc:being-yaksha yc:being-gandharva
                yc:being-apsara yc:being-vanara yc:being-riksha yc:being-beast yc:being-sage yc:being-human ) ] ;
    sh:property [ sh:path yc:role ; sh:in ( yc:role-king yc:role-woman ) ] ;
    sh:sparql [
        sh:message "Every figure outside recorded history has a class of being" ;
        sh:prefixes ycsh: ;
        sh:select """SELECT $this WHERE {
            $this yc:period ?p . FILTER (?p != yc:period-history)
            FILTER NOT EXISTS { $this yc:being ?b }
        }""" ] .

ycsh:CitationShape a sh:NodeShape ;
    sh:class yc:Citation ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:url ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

ycsh:LinkShape a sh:NodeShape ;
    sh:targetClass yc:Link ;
    sh:property [ sh:path yc:from ; sh:minCount 1 ; sh:maxCount 1 ; sh:class yc:Entry ] ;
    sh:property [ sh:path yc:to ; sh:minCount 1 ; sh:maxCount 1 ; sh:class yc:Entry ] ;
    sh:property [ sh:path yc:relation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class yc:Relation ] ;
    sh:property [ sh:path yc:tier ; sh:maxCount 1 ; sh:in ( yc:tier-layer yc:tier-vulgate yc:tier-purana yc:tier-folk ) ] ;
    sh:property [ sh:path yc:forwardLabel ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path yc:reverseLabel ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path dcterms:source ; sh:node ycsh:CitationShape ] ;
    sh:sparql [
        sh:message "A Link must add a tier, a label or a source; otherwise write the plain triple" ;
        sh:prefixes ycsh: ;
        sh:select """SELECT $this WHERE {
            FILTER NOT EXISTS { $this yc:tier|yc:forwardLabel|yc:reverseLabel|<http://purl.org/dc/terms/source> ?x }
        }""" ] ;
    sh:sparql [
        sh:message "The same link is also written as a plain triple" ;
        sh:prefixes ycsh: ;
        sh:select """SELECT $this WHERE {
            $this yc:from ?f ; yc:relation ?r ; yc:to ?t . ?f ?r ?t .
        }""" ] .

ycsh:RelationEndsShape a sh:NodeShape ;
    sh:targetSubjectsOf yc:parentOf, yc:ancestorOf, yc:kinOf, yc:rebornAs, yc:linkedWith, yc:kills,
        yc:divineOriginOf, yc:tells, yc:succeededBy, yc:leadsTo, yc:meets, yc:involves ;
    sh:class yc:Entry ;
    sh:property [ sh:path yc:parentOf ; sh:class yc:Entry ] ;
    sh:property [ sh:path yc:ancestorOf ; sh:class yc:Entry ] ;
    sh:property [ sh:path yc:kinOf ; sh:class yc:Entry ] ;
    sh:property [ sh:path yc:rebornAs ; sh:class yc:Entry ] ;
    sh:property [ sh:path yc:linkedWith ; sh:class yc:Entry ] ;
    sh:property [ sh:path yc:kills ; sh:class yc:Entry ] ;
    sh:property [ sh:path yc:divineOriginOf ; sh:class yc:Entry ] ;
    sh:property [ sh:path yc:tells ; sh:class yc:Entry ] ;
    sh:property [ sh:path yc:succeededBy ; sh:class yc:Entry ] ;
    sh:property [ sh:path yc:leadsTo ; sh:class yc:Occurrence ] ;
    sh:property [ sh:path yc:meets ; sh:class yc:Occurrence ] ;
    sh:property [ sh:path yc:involves ; sh:class yc:Entry ] .
