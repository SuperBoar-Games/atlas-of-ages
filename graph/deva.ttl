:varuna a aoa:Deva ;
    rdfs:label "Varuna" ;
    rdfs:comment "Aditya and lord of the waters. Rohita is promised to him in sacrifice, and through Agni he gives Arjuna the Gandiva bow." ;
    aoa:period aoa:period-deva ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.227" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxvii> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.18" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] .

:vasus a aoa:Deva ;
    rdfs:label "The Vasus" ;
    rdfs:comment "Eight gods cursed by Vashishtha for stealing his cow Nandini. Dyaus, who led the theft, must live a full human life as Bhishma." ;
    aoa:period aoa:period-deva ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
