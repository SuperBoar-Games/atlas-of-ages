        [ a aoa:Citation ; rdfs:label "MBh 1.67; MBh 1.123" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.71" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.100" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-c> ] ,
