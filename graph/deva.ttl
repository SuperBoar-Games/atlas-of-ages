:agni a yc:Deva ;
    rdfs:label "Agni" ;
    rdfs:comment "Fire god. Draupadi and Dhrishtadyumna rise from Drupada's fire altar. Agni consumes the Khandava forest." ;
    yc:period yc:period-deva ;
    yc:tier yc:tier-core ;
    yc:being yc:being-god ;
    yc:parentOf :nila ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Kishkindha 4.41" ; schema:url <https://valmikiramayan.net/kish/sarga41/kishkindha_41_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.30" ; schema:url <https://valmikiramayan.net/yuddha/sarga30/yuddha_30_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.169; 1.225-230" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxix> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.169" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxix> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.196 (also 3.131)" ; schema:url <https://www.sacred-texts.com/hin/m03/m03196.htm> ] .

:ashvins a yc:Deva ;
    rdfs:label "Ashvins" ;
    rdfs:comment "Twin physician gods. Fathers of Nakula and Sahadeva." ;
    yc:period yc:period-deva ;
    yc:tier yc:tier-core ;
    yc:being yc:being-god ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.66; MBh 1.124" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.67; MBh 1.124" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.123" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxxiii> ] .

:bhudevi a yc:Deva ;
    rdfs:label "Bhudevi" ;
    rdfs:comment "The earth goddess. Raised by Varaha and mother by him of Narakasura. Milked by Prithu, and Sita rises from her furrow." ;
    yc:period yc:period-deva ;
    yc:tier yc:tier-core ;
    yc:being yc:being-god ;
    yc:role yc:role-woman ;
    yc:parentOf :narakasura ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.66" ; schema:url <https://valmikiramayan.net/baala/sarga66/bala_66_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 8.90" ; schema:url <https://sacred-texts.com/hin/m08/m08090.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 12.59" ; schema:url <https://sacred-texts.com/hin/m12/m12a058.htm> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.64" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485605.html> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 3.18; Vishnu Purana 5.29, 1.13" ; schema:url <https://sacred-texts.com/hin/vp/vp146.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 3.18; Vishnu Purana 5.29" ; schema:url <https://vedabase.io/en/library/sb/3/18/> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 4.18; Vishnu Purana 1.13" ; schema:url <https://vedabase.io/en/library/sb/4/18/> ] ,
        [ a yc:Citation ; rdfs:label "Vishnu P. 5.29; Bhagavata 10.59" ; schema:url <https://sacred-texts.com/hin/vp/vp146.htm> ] .

:brahma a yc:Deva ;
    rdfs:label "Brahma" ;
    rdfs:comment "The creator god, born on the lotus from Vishnu's navel. In the Adi Parva his six mind-born sons are Marichi, Atri, Angiras, Pulastya, Pulaha and Kratu; Daksha springs from his toe and Bhrigu from his breast. The Puranas add Vashishtha, Narada and others." ;
    yc:period yc:period-deva ;
    yc:tier yc:tier-core ;
    yc:being yc:being-god ;
    yc:parentOf :atri ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Kishkindha 4.41" ; schema:url <https://valmikiramayan.net/kish/sarga41/kishkindha_41_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.61" ; schema:url <https://valmikiramayan.net/yuddha/sarga61/yuddha_61_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.92" ; schema:url <https://valmikiramayan.net/yuddha/sarga92/yuddha_92_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.2" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424763.html> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.10" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424771.html> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.65; MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 3.8, 3.12; Vishnu Purana 1.7" ; schema:url <https://vedabase.io/en/library/sb/3/12/> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 3.12" ; schema:url <https://vedabase.io/en/library/sb/3/12/> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 3.12; Vishnu Purana 1.7" ; schema:url <https://vedabase.io/en/library/sb/3/12/> ] .

:ganesha a yc:Deva ;
    rdfs:label "Ganesha" ;
    rdfs:comment "Elephant-headed son of Parvati and Shiva, remover of obstacles. Popular versions of the Mahabharata make him the scribe who writes it down as Vyasa dictates." ;
    yc:period yc:period-deva ;
    yc:tier yc:tier-core ;
    yc:being yc:being-god .

:indra a yc:Deva ;
    rdfs:label "Indra" ;
    rdfs:comment "King of the devas, son of Kashyapa and Aditi. Father of Vali and Arjuna. Seduces Ahalya, and takes Karna's armour and earrings in exchange for a one-time spear." ;
    yc:period yc:period-deva ;
    yc:tier yc:tier-core ;
    yc:being yc:being-god ;
    yc:kills :vishvarupa ;
    yc:divineOriginOf :arjuna, :vali ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.39" ; schema:url <https://valmikiramayan.net/baala/sarga39/bala_39_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.48" ; schema:url <https://valmikiramayan.net/baala/sarga48/bala_48_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Kishkindha 4.16" ; schema:url <https://valmikiramayan.net/kish/sarga16/kishkindha_16_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.92" ; schema:url <https://valmikiramayan.net/yuddha/sarga92/yuddha_92_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.29" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424795.html> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.18" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.65; MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.67; MBh 1.123" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.71" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.100" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-c> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.101" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-ci> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.178" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxviii> ] ,
