        [ a yc:Citation ; rdfs:label "Bhagavata 8.9" ; schema:url <https://vedabase.io/en/library/sb/8/9/> ] .

:varuna a yc:Deva ;
    rdfs:label "Varuna" ;
    rdfs:comment "Aditya and lord of the waters. Rohita is promised to him in sacrifice, and through Agni he gives Arjuna the Gandiva bow." ;
    yc:period yc:period-deva ;
    yc:tier yc:tier-core ;
    yc:being yc:being-god ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.227" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxvii> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 6.18" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] .

:vasus a yc:Deva ;
    rdfs:label "The Vasus" ;
    rdfs:comment "Eight gods cursed by Vashishtha for stealing his cow Nandini. Dyaus, who led the theft, must live a full human life as Bhishma." ;
    yc:period yc:period-deva ;
    yc:tier yc:tier-core ;
    yc:being yc:being-god ;
    dcterms:source
