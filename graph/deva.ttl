        [ a aoa:Citation ; rdfs:label "Harivamsa 2.58" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485599.html> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.18" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] .

:kama a aoa:Deva ;
    rdfs:label "Kama" ;
    rdfs:comment "God of desire, burned by Shiva's third eye. The Puranas have him reborn as Krishna's son Pradyumna." ;
    aoa:period aoa:period-deva ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.105" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485646.html> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 10.55" ; schema:url <https://vedabase.io/en/library/sb/10/55/> ] .

:kartikeya a aoa:Deva ;
    rdfs:label "Kartikeya" ;
    rdfs:comment "Skanda, commander of the gods. In the Vana Parva he is born of Agni's seed, cast six times into a golden lake, and kills the demon Mahisha. The Puranas tell of Shiva's seed carried by Agni and Ganga to the six Krittikas, and of his killing Taraka." ;
    aoa:period aoa:period-deva ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.230" ; schema:url <https://www.sacred-texts.com/hin/m03/m03230.htm> ] .

:kubera a aoa:Deva ;
    rdfs:label "Kubera" ;
    rdfs:comment "God of wealth and Vishrava's son. On his father's advice he gives Lanka up to Ravana and moves to Kailasa; Ravana later defeats him and takes his flying chariot Pushpaka." ;
    aoa:period aoa:period-deva ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    aoa:parentOf :nalakuvara ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Aranya 3.48" ; schema:url <https://valmikiramayan.net/aranya/sarga48/aranya_48_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Yuddha 6.121" ; schema:url <https://valmikiramayan.net/yuddha/sarga121/yuddha_121_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.3" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424764.html> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.11" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424772.html> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.15" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424776.html> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.26" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424792.html> ] .

:lakshmi a aoa:Deva ;
    rdfs:label "Lakshmi" ;
    rdfs:comment "Goddess of fortune who rises from the churned ocean and chooses Vishnu. The Puranas see Sita and Rukmini as her incarnations." ;
    aoa:period aoa:period-deva ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Yuddha 6.117" ; schema:url <https://valmikiramayan.net/yuddha/sarga117/yuddha_117_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.18; MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xviii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.105" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485646.html> ] ,
        [ a aoa:Citation ; rdfs:label "Vishnu P. 1.8-1.9" ; schema:url <https://sacred-texts.com/hin/vp/vp044.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Vishnu P. 1.9" ; schema:url <https://sacred-texts.com/hin/vp/vp044.htm> ] .

:parvati a aoa:Deva ;
    rdfs:label "Parvati" ;
    rdfs:comment "Daughter of Himavan and Sati reborn. Wins Shiva through penance. Mother of Kartikeya and Ganesha." ;
    aoa:period aoa:period-deva ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.7; Vishnu Purana 1.8" ; schema:url <https://sacred-texts.com/hin/vp/vp042.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Vishnu P. 1.8" ; schema:url <https://sacred-texts.com/hin/vp/vp042.htm> ] .

:saraswati a aoa:Deva ;
    rdfs:label "Saraswati" ;
    rdfs:comment "Goddess of speech and learning, Brahma's consort, and the deified Sarasvati river." ;
    aoa:period aoa:period-deva ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Yuddha 6.61" ; schema:url <https://valmikiramayan.net/yuddha/sarga61/yuddha_61_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.10" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424771.html> ] .

:shesha a aoa:Deva ;
    rdfs:label "Shesha" ;
    rdfs:comment "Eldest of Kadru's Naga sons, the serpent Vishnu rests on. The Puranas make Lakshmana and Balarama his incarnations." ;
    aoa:period aoa:period-deva ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.35; MBh 1.36; MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.35; MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] .

:shiva a aoa:Deva ;
    rdfs:label "Shiva" ;
    rdfs:comment "Drinks the poison at the churning. His bow is broken by Rama. Grants Draupadi five husbands, fights Arjuna as a hunter and gives him the Pashupata. Ashwatthama is born of a portion of him." ;
    aoa:period aoa:period-deva ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    aoa:parentOf :kartikeya ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Uttara 7.16" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424777.html> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.18" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xviii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.171; 1.199" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxxi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.39-40" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-xl> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.109" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cix> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.230" ; schema:url <https://www.sacred-texts.com/hin/m03/m03230.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 8.34" ; schema:url <https://sacred-texts.com/hin/m08/m08034.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 12.284" ; schema:url <https://sacred-texts.com/hin/m12/m12b111.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.1" ; schema:url <https://vedabase.io/en/library/sb/4/1/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.5" ; schema:url <https://vedabase.io/en/library/sb/4/5/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.7; Vishnu Purana 1.8" ; schema:url <https://sacred-texts.com/hin/vp/vp042.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 10.55" ; schema:url <https://vedabase.io/en/library/sb/10/55/> ] .

:surya a aoa:Deva ;
    rdfs:label "Surya" ;
    rdfs:comment "Sun god, son of Kashyapa and Aditi. Father of Manu (as Vivasvan), Tapati, Sugriva and Karna." ;
    aoa:period aoa:period-deva ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    aoa:divineOriginOf :karna, :manu, :sugriva ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.16" ; schema:url <https://valmikiramayan.net/kish/sarga16/kishkindha_16_frame.htm> ] ,
