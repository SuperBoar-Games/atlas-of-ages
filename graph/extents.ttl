# Matsya: Jaipur, Alwar and Bharatpur, south of Kuru, with Viratanagara (Bairat).
:pol_matsya geo:hasGeometry [ geo:asWKT "POLYGON((75.3 28.1, 76.5 28.3, 77.3 28.1, 77.1 27.5, 77.3 27.0, 76.6 26.4, 75.6 26.4, 75.0 27.0, 75.3 28.1))"^^geo:wktLiteral ;
