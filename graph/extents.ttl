# Shurasena: the Mathura country on the Yamuna, between Matsya and Panchala.
:pol_shurasena geo:hasGeometry [ geo:asWKT "POLYGON((77.3 28.1, 78.0 28.0, 78.3 27.6, 78.4 26.9, 77.9 26.7, 77.3 27.0, 77.1 27.5, 77.3 28.1))"^^geo:wktLiteral ;
