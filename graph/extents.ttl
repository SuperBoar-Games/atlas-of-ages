# Shakya: the small republic of Kapilavastu, at the foot of the hills east of Kosala.
:pol_shakya geo:hasGeometry [ geo:asWKT "POLYGON((82.7 27.75, 83.4 27.75, 83.55 27.4, 83.2 27.2, 82.8 27.3, 82.7 27.75))"^^geo:wktLiteral ;
