# Extents no open dataset maps (epic kingdoms, early janapadas), digitised by hand from the rivers and hills the sources name.

@prefix : <https://w3id.org/atlas-of-ages#> .
@prefix aoa: <https://w3id.org/atlas-of-ages#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

# Kuru: Kurukshetra and Kurujangala, from the Sarasvati (Ghaggar) to the Ganga at Hastinapura.
:pol_kuru geo:hasGeometry [ geo:asWKT "POLYGON((76.3 30.5, 77.6 30.4, 78.15 29.95, 78.1 29.15, 77.9 28.6, 77.3 28.4, 76.5 28.6, 75.9 29.3, 75.7 30.0, 76.3 30.5))"^^geo:wktLiteral ;
    dcterms:source [ a aoa:Citation ; rdfs:label "Raychaudhuri 1923, the Kurus" ; schema:url <https://rarebooksocietyofindia.org/book_archive/196174216674_10151811221586675.pdf> ] ] .
:pol_kuru_vedic geo:hasGeometry [ geo:asWKT "POLYGON((76.3 30.5, 77.6 30.4, 78.15 29.95, 78.1 29.15, 77.9 28.6, 77.3 28.4, 76.5 28.6, 75.9 29.3, 75.7 30.0, 76.3 30.5))"^^geo:wktLiteral ;
    dcterms:source [ a aoa:Citation ; rdfs:label "Raychaudhuri 1923, the Kurus" ; schema:url <https://rarebooksocietyofindia.org/book_archive/196174216674_10151811221586675.pdf> ] ] .

# Panchala: astride the Ganga, north to the hills (Ahichchhatra) and south to the Chambal (Kampilya).
:pol_panchala geo:hasGeometry [ geo:asWKT "POLYGON((78.15 29.95, 78.9 29.9, 79.6 29.3, 80.2 28.5, 80.3 27.5, 80.0 26.9, 79.1 26.5, 78.4 26.9, 78.3 27.6, 78.4 28.2, 78.1 29.15, 78.15 29.95))"^^geo:wktLiteral ;
