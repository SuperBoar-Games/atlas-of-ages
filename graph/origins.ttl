@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

:aditi a aoa:Person ;
    rdfs:label "Aditi" ;
    rdfs:comment "Daksha's daughter and Kashyapa's wife. Mother of the Adityas: Indra, Surya, Varuna and the others, and of Vamana." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :indra, :surya, :vamana, :varuna ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65; MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.6, 6.18" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.6" ; schema:url <https://vedabase.io/en/library/sb/6/6/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.18" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] .

:airavata a aoa:Person ;
    rdfs:label "Airavata" ;
    rdfs:comment "White elephant from the churning and Indra's mount." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-beast ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.18" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xviii> ] .

:angiras a aoa:Sage ;
    rdfs:label "Angiras" ;
    rdfs:comment "Mind-born son of Brahma and father of Brihaspati, guru of the devas." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    aoa:parentOf :brihaspati ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.66; MBh 1.76" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] .

:bharatajain a aoa:Person ;
    rdfs:label "Bharata, Rishabha's son" ;
    rdfs:comment "The Jain texts and the Bhagavata say Bharatavarsha is named after this Bharata. The Mahabharata names it after Dushyanta's son instead." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 5.4" ; schema:url <https://vedabase.io/en/library/sb/5/4/> ] .

:bhrigu a aoa:Sage ;
    rdfs:label "Bhrigu" ;
    rdfs:comment "Mind-born son of Brahma and founder of the Bhrigu line: Shukracharya, Chyavana, and down to Jamadagni and Parashurama." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    aoa:parentOf :chyavana, :shukra ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.122" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxxii> ] .

:brihaspati a aoa:Sage ;
    rdfs:label "Brihaspati" ;
    rdfs:comment "Son of Angiras and guru of the devas, rival of Shukracharya. Sends his son Kacha to learn the Sanjivani art." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    aoa:parentOf :kacha ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.66; MBh 1.76" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.76" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxvi> ] .

:chyavana a aoa:Sage ;
    rdfs:label "Chyavana" ;
    rdfs:comment "Bhrigu's son. The Ashvins restore his youth, and in return he wins them a share of the soma (Vana Parva). Ancestor of Jamadagni." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.122-124, 3.115" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.122" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxxii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.123" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxxiii> ] .

:cosmictime a aoa:Event ;
    rdfs:label "Cosmic time" ;
    rdfs:comment "The four yugas make a cycle of 12,000 divine years (Vana Parva), reckoned in the Puranas as 4,320,000 human years. A thousand such cycles make one day of Brahma, a kalpa, ruled in turn by fourteen Manus." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.187" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxvii> ] ,
        [ a aoa:Citation ; rdfs:label "Vishnu P. 1.3; Bhagavata 3.11" ; schema:url <https://sacred-texts.com/hin/vp/vp037.htm> ] .

:creation a aoa:Event ;
    rdfs:label "Creation from the lotus" ;
    rdfs:comment "Between creations Vishnu sleeps on Shesha in the cosmic ocean. A lotus grows from his navel and Brahma is born in it to make the world again (Vana and Shanti Parvas, Puranas). The Rigveda's older hymns speak of the golden embryo and the cosmic Purusha." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-layer ;
    aoa:involves :brahma, :hiranyagarbha, :purusha, :shesha, :vishnu .

:dadhichi a aoa:Sage ;
    rdfs:label "Dadhichi" ;
    rdfs:comment "Sage who gives up his life so his bones can be made into Indra's vajra (Vana Parva)." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.100" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-c> ] .

:daksha a aoa:Person ;
    rdfs:label "Daksha" ;
    rdfs:comment "Prajapati and son of Brahma. His daughters marry Kashyapa, Chandra, Dharma and Shiva. Shiva destroys his sacrifice after Daksha insults him." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:parentOf :aditi, :danu, :diti, :kadru, :nakshatras, :sati, :vinata ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.66; MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 9.35" ; schema:url <https://sacred-texts.com/hin/m09/m09035.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 12.284" ; schema:url <https://sacred-texts.com/hin/m12/m12b111.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.12, 4.1-4.5, 6.6" ; schema:url <https://vedabase.io/en/library/sb/4/5/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.12; Vishnu Purana 1.7" ; schema:url <https://vedabase.io/en/library/sb/3/12/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.1" ; schema:url <https://vedabase.io/en/library/sb/4/1/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.5" ; schema:url <https://vedabase.io/en/library/sb/4/5/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.6" ; schema:url <https://vedabase.io/en/library/sb/6/6/> ] .

:dakshayajna a aoa:Event, aoa:Catastrophe ;
    rdfs:label "Daksha's sacrifice" ;
    rdfs:comment "Daksha holds a great sacrifice and leaves Shiva out, and Shiva destroys the rite (Shanti Parva, where Uma is at his side). The Puranas add Sati giving up her life there." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-layer ;
    aoa:involves :daksha, :sati, :shiva ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 12.284" ; schema:url <https://sacred-texts.com/hin/m12/m12b111.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.4-4.5" ; schema:url <https://vedabase.io/en/library/sb/4/4/> ] .

:danu a aoa:Person ;
    rdfs:label "Danu" ;
    rdfs:comment "Daksha's daughter and Kashyapa's wife. Mother of the danavas." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65; MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.6" ; schema:url <https://vedabase.io/en/library/sb/6/6/> ] .

:dashavatara a aoa:Event ;
    rdfs:label "Dashavatara" ;
    rdfs:comment "The classic list of ten avatars, as in Jayadeva's Gita Govinda: Matsya, Kurma, Varaha, Narasimha, Vamana, Parashurama, Rama, Balarama or Krishna, the Buddha, and Kalki still to come. The Bhagavata itself counts twenty-two." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-purana ;
    aoa:involves :balarama, :buddha, :kalki, :krishna, :kurma, :matsya, :narasimha, :parashurama, :rama, :vamana, :varaha ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 1.3" ; schema:url <https://vedabase.io/en/library/sb/1/3/> ] .

:devahuti a aoa:Person ;
    rdfs:label "Devahuti" ;
    rdfs:comment "Daughter of Svayambhuva Manu and wife of the sage Kardama. Mother of Kapila (Bhagavata)." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.12, 3.24, 4.1" ; schema:url <https://vedabase.io/en/library/sb/3/24/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.12, 4.1" ; schema:url <https://vedabase.io/en/library/sb/3/12/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.24" ; schema:url <https://vedabase.io/en/library/sb/3/24/> ] .

:dhruva a aoa:Person ;
    rdfs:label "Dhruva" ;
    rdfs:comment "Grandson of Svayambhuva Manu. Slighted as a boy, he does penance until Vishnu makes him the pole star (Vishnu Purana, Bhagavata)." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.8; Vishnu Purana 1.11" ; schema:url <https://vedabase.io/en/library/sb/4/8/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.9; Vishnu Purana 1.12" ; schema:url <https://vedabase.io/en/library/sb/4/9/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.13" ; schema:url <https://vedabase.io/en/library/sb/4/13/> ] ,
        [ a aoa:Citation ; rdfs:label "Vishnu P. 1.11-1.12; Bhagavata 4.8-4.9" ; schema:url <https://sacred-texts.com/hin/vp/vp047.htm> ] .

:dissolution a aoa:Event, aoa:Catastrophe ;
    rdfs:label "Cosmic dissolution" ;
    rdfs:comment "At the end of an age the Samvartaka fire and twelve years of rain consume the worlds (Vana Parva). The Puranas add the dissolution at the end of Brahma's life." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.187" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxvii> ] .

:diti a aoa:Person ;
    rdfs:label "Diti" ;
    rdfs:comment "Daksha's daughter and Kashyapa's wife. Mother of the daityas Hiranyakashipu and Hiranyaksha, and of the Maruts." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :hiranyakashipu ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65; MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.17, 6.18" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.6, 6.18" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.6" ; schema:url <https://vedabase.io/en/library/sb/6/6/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.18" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] .

:halahala a aoa:Event, aoa:Catastrophe ;
    rdfs:label "Halahala poison" ;
    rdfs:comment "Kalakuta, a poison that rises from the churning and threatens to burn the worlds. Shiva drinks it and holds it in his throat, which turns blue." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.18" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xviii> ] .

:hayagriva a aoa:Person ;
    rdfs:label "Hayagriva" ;
    rdfs:comment "Demon who steals the Vedas from the sleeping Brahma. Matsya kills him and returns them (Bhagavata)." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.24" ; schema:url <https://vedabase.io/en/library/sb/8/24/> ] .

:himavan a aoa:Person ;
    rdfs:label "Himavan" ;
    rdfs:comment "King of the mountains. Father of Parvati, and in the Ramayana also of Ganga." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:parentOf :parvati ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Vishnu P. 1.8" ; schema:url <https://sacred-texts.com/hin/vp/vp042.htm> ] .

:hiranyagarbha a aoa:Event ;
    rdfs:label "Hiranyagarbha" ;
    rdfs:comment "The golden embryo or cosmic egg of the Rigveda. In later accounts Brahma is born inside it and splits it into heaven and earth." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core .

:kamadahana a aoa:Event ;
    rdfs:label "Kama burned" ;
    rdfs:comment "Kama shoots Shiva with desire to turn him toward Parvati, and Shiva burns him to ash (Puranas and Kalidasa)." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-purana ;
    aoa:involves :kama, :parvati, :shiva ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 10.55" ; schema:url <https://vedabase.io/en/library/sb/10/55/> ] .

:kamadhenu a aoa:Deva ;
    rdfs:label "Kamadhenu" ;
    rdfs:comment "Wish-granting cow from the churning. In Valmiki she lives with Vashishtha as Shabala, and Vishvamitra fights him for her. In the Mahabharata her daughter Nandini is the cow the Vasus steal." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-beast ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.18; MBh 1.99" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xviii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.99; MBh 1.177" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcix> ] .

:kashyapa a aoa:Sage ;
    rdfs:label "Kashyapa" ;
    rdfs:comment "Sage, grandson of Brahma through Marichi. By Daksha's daughters he fathers the devas (Aditi), the daityas (Diti), the Nagas (Kadru) and the great birds (Vinata)." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    aoa:parentOf :aruna, :garuda, :vasuki ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.16; MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.16; MBh 1.23" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.16" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65; MBh 1.66; MBh 1.16" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65; MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.17" ; schema:url <https://vedabase.io/en/library/sb/3/17/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.6" ; schema:url <https://vedabase.io/en/library/sb/6/6/> ] .

:kratu a aoa:Sage ;
    rdfs:label "Kratu" ;
    rdfs:comment "Mind-born son of Brahma, one of the Prajapatis." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.65; MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] .

:manus a aoa:Event ;
    rdfs:label "Fourteen Manus" ;
    rdfs:comment "Each kalpa has fourteen Manus, each presiding over a manvantara. Svayambhuva was the first. The present age belongs to the seventh, Vaivasvata." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-purana ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.11, 8.1, 8.13" ; schema:url <https://vedabase.io/en/library/sb/8/13/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.1" ; schema:url <https://vedabase.io/en/library/sb/8/1/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.13" ; schema:url <https://vedabase.io/en/library/sb/8/13/> ] ,
        [ a aoa:Citation ; rdfs:label "Vishnu P. 1.3; Bhagavata 3.11" ; schema:url <https://sacred-texts.com/hin/vp/vp037.htm> ] .

:marichi a aoa:Sage ;
    rdfs:label "Marichi" ;
    rdfs:comment "Mind-born son of Brahma and father of Kashyapa." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    aoa:parentOf :kashyapa ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] .

:markandeya a aoa:Sage, aoa:Chiranjivi ;
    rdfs:label "Markandeya" ;
    rdfs:comment "Long-lived sage who wanders inside the flood and sees Vishnu as a child on a banyan branch. He tells Yudhishthira of the flood, the Rama story and Savitri (Vana Parva). Later lists count him among the chiranjivis." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.186, 3.272, 3.292" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cclxxii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.187-188" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.187" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.189" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxix> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.196" ; schema:url <https://www.sacred-texts.com/hin/m03/m03196.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.292" ; schema:url <https://www.sacred-texts.com/hin/m03/m03292.htm> ] .

:maruts a aoa:Deva ;
    rdfs:label "Maruts" ;
    rdfs:comment "Storm gods. Indra splits Diti's unborn son into forty-nine, and they become his companions." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.18" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] .

:matsya a aoa:Avatar ;
    rdfs:label "Matsya" ;
    rdfs:comment "The fish that saves Manu from the flood. In the Vana Parva it reveals itself as Brahma; the Puranas make it Vishnu's first avatar." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.186" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxvi> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 1.3" ; schema:url <https://vedabase.io/en/library/sb/1/3/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.24" ; schema:url <https://vedabase.io/en/library/sb/8/24/> ] .

:nakshatras a aoa:Person ;
    rdfs:label "Twenty-seven nakshatras" ;
    rdfs:comment "Daksha's daughters married to Chandra, the lunar mansions. Chandra loves only Rohini, so Daksha curses him to wane (Shalya Parva)." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.66; MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 9.35" ; schema:url <https://sacred-texts.com/hin/m09/m09035.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.6" ; schema:url <https://vedabase.io/en/library/sb/6/6/> ] .

:parijata a aoa:Event ;
    rdfs:label "Parijata" ;
    rdfs:comment "Heavenly tree from the churning, planted in Indra's garden. Krishna carries it off for Satyabhama (Harivamsa)." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.69" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485610.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.76" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485617.html> ] .

:pralaya a aoa:Event, aoa:Catastrophe ;
    rdfs:label "The great flood" ;
    rdfs:comment "The world drowns at the end of an age. The fish tells Manu to build a boat, load the seeds of all things and the seven seers, and tie it to his horn (Vana Parva; first in the Shatapatha Brahmana)." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:involves :hayagriva, :manu, :markandeya, :matsya, :saptarishis ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.186" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.187" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxvii> ] .

:prasuti a aoa:Person ;
    rdfs:label "Prasuti" ;
    rdfs:comment "Daughter of Svayambhuva Manu and wife of Daksha. Mother of Sati." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.12, 4.1; Vishnu Purana 1.7" ; schema:url <https://vedabase.io/en/library/sb/4/1/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.12; Vishnu Purana 1.7" ; schema:url <https://vedabase.io/en/library/sb/3/12/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.1" ; schema:url <https://vedabase.io/en/library/sb/4/1/> ] .

:prithu a aoa:Person ;
    rdfs:label "Prithu" ;
    rdfs:comment "Born from Vena's right arm. He levels the land and milks the earth for food, and the earth is called Prithvi after him (Shanti Parva, Vishnu Purana)." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 12.59" ; schema:url <https://sacred-texts.com/hin/m12/m12a058.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 1.3, 4.15" ; schema:url <https://vedabase.io/en/library/sb/1/3/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.15; Vishnu Purana 1.13" ; schema:url <https://vedabase.io/en/library/sb/4/15/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.18; Vishnu Purana 1.13" ; schema:url <https://vedabase.io/en/library/sb/4/18/> ] ,
        [ a aoa:Citation ; rdfs:label "Vishnu P. 1.13; Bhagavata 4.15, 4.18" ; schema:url <https://sacred-texts.com/hin/vp/vp048.htm> ] .

:priyavrata a aoa:Person ;
    rdfs:label "Priyavrata" ;
    rdfs:comment "Elder son of Svayambhuva Manu, who divides the earth into seven continents. Ancestor of Rishabha (Bhagavata)." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.12, 5.1-5.4; Vishnu Purana 1.7, 1.11" ; schema:url <https://vedabase.io/en/library/sb/5/1/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.12; Vishnu Purana 1.7" ; schema:url <https://vedabase.io/en/library/sb/3/12/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 5.1-5.4" ; schema:url <https://vedabase.io/en/library/sb/5/2/> ] .

:pulaha a aoa:Sage ;
    rdfs:label "Pulaha" ;
    rdfs:comment "Mind-born son of Brahma, one of the Prajapatis." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.65; MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] .

:pulastya a aoa:Sage ;
    rdfs:label "Pulastya" ;
    rdfs:comment "Mind-born son of Brahma and grandfather of Kubera and Ravana through Vishrava." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    aoa:parentOf :vishrava ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Uttara 7.2" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424763.html> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] .

:purusha a aoa:Event ;
    rdfs:label "Purusha" ;
    rdfs:comment "The cosmic being of the Rigveda's Purusha Sukta, from whose sacrificed body the worlds, gods and social orders are made." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core .

:rahu a aoa:Person ;
    rdfs:label "Rahu & Ketu" ;
    rdfs:comment "Son of Simhika in the Adi Parva. He slips in among the gods to drink the amrita, and Vishnu's discus cuts off his head. The immortal head still chases the sun and moon in eclipses." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.19; MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xix> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.19" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xix> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.6" ; schema:url <https://vedabase.io/en/library/sb/6/6/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.9, 6.6" ; schema:url <https://vedabase.io/en/library/sb/8/9/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.9" ; schema:url <https://vedabase.io/en/library/sb/8/9/> ] .

:rishabha a aoa:Sage ;
    rdfs:label "Rishabha" ;
    rdfs:comment "Descendant of Svayambhuva and the first Jain tirthankara. The Bhagavata also counts him as a partial avatar of Vishnu." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-sage ;
    aoa:parentOf :bharatajain ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 1.3, 5.4" ; schema:url <https://vedabase.io/en/library/sb/5/4/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 5.1-5.4" ; schema:url <https://vedabase.io/en/library/sb/5/2/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 5.4" ; schema:url <https://vedabase.io/en/library/sb/5/4/> ] .

:sanaka a aoa:Sage ;
    rdfs:label "Sanaka Kumaras" ;
    rdfs:comment "Four eternal child sages, mind-born sons of Brahma. They curse Jaya and Vijaya for barring them at Vaikuntha's gate." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.12, 3.16" ; schema:url <https://vedabase.io/en/library/sb/3/16/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.12" ; schema:url <https://vedabase.io/en/library/sb/3/12/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.16" ; schema:url <https://vedabase.io/en/library/sb/3/16/> ] .

:saptarishis a aoa:Event ;
    rdfs:label "Saptarishis" ;
    rdfs:comment "The seven seers of the present manvantara. One common list: Kashyapa, Atri, Vashishtha, Vishvamitra, Gautama, Jamadagni and Bharadvaja. In the flood story they ride in Manu's boat." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:involves :atri, :bharadvaja, :gautama, :jamadagni, :kashyapa, :vashishtha, :vishvamitra ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.186" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxvi> ] .

:sati a aoa:Person ;
    rdfs:label "Sati" ;
    rdfs:comment "Daksha's daughter, married to Shiva. She gives up her life at her father's sacrifice and is reborn as Parvati." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-god ;
    aoa:role aoa:role-woman ;
    aoa:rebornAs :parvati ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.1, 4.4, 4.7; Vishnu Purana 1.8" ; schema:url <https://sacred-texts.com/hin/vp/vp042.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.1" ; schema:url <https://vedabase.io/en/library/sb/4/1/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.7; Vishnu Purana 1.8" ; schema:url <https://sacred-texts.com/hin/vp/vp042.htm> ] .

:svayambhuva a aoa:Person ;
    rdfs:label "Svayambhuva Manu" ;
    rdfs:comment "The first Manu, made by Brahma together with his wife Shatarupa. Ancestor of Dhruva, Prithu and Rishabha." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:parentOf :devahuti ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.12; Vishnu Purana 1.7" ; schema:url <https://vedabase.io/en/library/sb/3/12/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.12, 4.1" ; schema:url <https://vedabase.io/en/library/sb/3/12/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.1" ; schema:url <https://vedabase.io/en/library/sb/8/1/> ] .

:taraka a aoa:Person ;
    rdfs:label "Taraka" ;
    rdfs:comment "Asura who can be killed only by a son of Shiva, which is why the gods need Kartikeya (Puranas)." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 8.33" ; schema:url <https://sacred-texts.com/hin/m08/m08033.htm> ] .

:tripura a aoa:Event, aoa:Catastrophe ;
    rdfs:label "Tripura burned" ;
    rdfs:comment "The asura Maya builds three flying cities of iron, silver and gold for Taraka's sons. When they come together, Shiva destroys all three with one arrow (Karna Parva)." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 8.33" ; schema:url <https://sacred-texts.com/hin/m08/m08033.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 8.34" ; schema:url <https://sacred-texts.com/hin/m08/m08034.htm> ] .

:uchchaihshravas a aoa:Person ;
    rdfs:label "Uchchaihshravas" ;
    rdfs:comment "White horse that rises from the churning. Kadru and Vinata wager on the colour of his tail." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-beast ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.17; MBh 1.18; MBh 1.20" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.20" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xx> ] .

:uttanapada a aoa:Person ;
    rdfs:label "Uttanapada" ;
    rdfs:comment "Younger son of Svayambhuva Manu and father of Dhruva (Vishnu Purana, Bhagavata)." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.12; Vishnu Purana 1.7" ; schema:url <https://vedabase.io/en/library/sb/3/12/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.8; Vishnu Purana 1.11" ; schema:url <https://vedabase.io/en/library/sb/4/8/> ] ,
        [ a aoa:Citation ; rdfs:label "Vishnu P. 1.11; Bhagavata 4.8" ; schema:url <https://sacred-texts.com/hin/vp/vp046.htm> ] .

:vedas a aoa:Event ;
    rdfs:label "The four Vedas" ;
    rdfs:comment "Eternal revelation heard by the seers, spoken by Brahma from his four mouths at each creation. Hayagriva steals it and Matsya brings it back. In each Dvapara Yuga a Vyasa divides it into four." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.12, 8.24, 12.6" ; schema:url <https://vedabase.io/en/library/sb/12/6/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.24" ; schema:url <https://vedabase.io/en/library/sb/8/24/> ] .

:vena a aoa:Person ;
    rdfs:label "Vena" ;
    rdfs:comment "Wicked king killed by the sages. Prithu springs from his right arm (Shanti Parva). The Puranas place him in Dhruva's line." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 12.59" ; schema:url <https://sacred-texts.com/hin/m12/m12a058.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.13-4.15; Vishnu Purana 1.13" ; schema:url <https://vedabase.io/en/library/sb/4/13/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.13" ; schema:url <https://vedabase.io/en/library/sb/4/13/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.15; Vishnu Purana 1.13" ; schema:url <https://vedabase.io/en/library/sb/4/15/> ] .

:vishrava a aoa:Sage ;
    rdfs:label "Vishrava" ;
    rdfs:comment "Son of Pulastya. Father of Kubera by one wife, and of Ravana, Kumbhakarna, Vibhishana and Shurpanakha by the rakshasi Kaikasi." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    aoa:parentOf :kubera, :kumbhakarna, :ravana, :shurpanakha, :vibhishana ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Aranya 3.17" ; schema:url <https://valmikiramayan.net/aranya/sarga17/aranya_17_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Yuddha 6.61" ; schema:url <https://valmikiramayan.net/yuddha/sarga61/yuddha_61_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.2" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424763.html> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.3" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424764.html> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.9" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424770.html> ] .

:vishvarupa a aoa:Person ;
    rdfs:label "Vishvarupa" ;
    rdfs:comment "Three-headed son of Tvashtr and priest of the devas, suspected of favouring the asuras. Indra kills him." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human .

:vritra a aoa:Person, aoa:Catastrophe ;
    rdfs:label "Vritra" ;
    rdfs:comment "Demon Tvashtr makes to avenge his three-headed son. In the Udyoga Parva he swallows Indra, and Indra kills him with foam joined to the thunderbolt, Vishnu entering it. In the Vana Parva the thunderbolt is made from Dadhichi's bones." ;
    aoa:period aoa:period-origins ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.100-101" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-ci> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.101" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-ci> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.9; MBh 5.10" ; schema:url <https://sacred-texts.com/hin/m05/m05010.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.9" ; schema:url <https://sacred-texts.com/hin/m05/m05009.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.10" ; schema:url <https://sacred-texts.com/hin/m05/m05010.htm> ] .

[] a aoa:Link ;
    aoa:from :airavata ;
