    yc:from :airavata ;
    yc:relation yc:linkedWith ;
    yc:to :indra ;
    yc:forwardLabel "Mount of" ;
    yc:reverseLabel "Rides" .

[] a yc:Link ;
    yc:from :bharatajain ;
    yc:relation yc:linkedWith ;
    yc:to :bharata ;
    yc:tier yc:tier-purana ;
    yc:forwardLabel "Rival namesake of Bharatavarsha" ;
    yc:reverseLabel "Rival namesake of Bharatavarsha" .

[] a yc:Link ;
    yc:from :bhrigu ;
    yc:relation yc:ancestorOf ;
