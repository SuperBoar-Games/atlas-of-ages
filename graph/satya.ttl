:aruna a aoa:Person ;
    rdfs:label "Aruna" ;
    rdfs:comment "Vinata's elder son and Surya's charioteer. Father of Jatayu and Sampati." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-beast ;
    aoa:parentOf :jatayu, :sampati ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Aranya 3.14" ; schema:url <https://valmikiramayan.net/aranya/sarga14/aranya_14_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.58" ; schema:url <https://valmikiramayan.net/kish/sarga58/kishkindha_58_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.16; MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.16" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] .

:atri a aoa:Sage ;
    rdfs:label "Atri" ;
    rdfs:comment "Mind-born son of Brahma and one of the Saptarishis. Father of Chandra." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    aoa:parentOf :dattatreya ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.65; MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.1" ; schema:url <https://vedabase.io/en/library/sb/4/1/> ] .

:budha a aoa:Deva ;
    rdfs:label "Budha" ;
    rdfs:comment "Son of Chandra and Tara, lord of Mercury. Marries Ila." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god .

:chandra a aoa:Deva ;
    rdfs:label "Chandra (Soma)" ;
    rdfs:comment "The Moon, born of Atri. The Chandravamsha, the Lunar dynasty of both Kurus and Yadavas, is named after him." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.19" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xix> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.66; MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 9.35" ; schema:url <https://sacred-texts.com/hin/m09/m09035.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.6" ; schema:url <https://vedabase.io/en/library/sb/6/6/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.9" ; schema:url <https://vedabase.io/en/library/sb/8/9/> ] .

:dattatreya a aoa:Sage ;
    rdfs:label "Dattatreya" ;
    rdfs:comment "Son of Atri and Anasuya, the teacher of many teachers, honoured as a partial avatar of Vishnu." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 1.3, 4.1" ; schema:url <https://vedabase.io/en/library/sb/4/1/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 4.1" ; schema:url <https://vedabase.io/en/library/sb/4/1/> ] .

:dhanvantari a aoa:Deva ;
    rdfs:label "Dhanvantari" ;
    rdfs:comment "Physician of the gods, who rises from the churned ocean holding the pot of amrita." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.18" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xviii> ] .

:garuda a aoa:Person, aoa:SpansYugas ;
    rdfs:label "Garuda" ;
    rdfs:comment "King of birds, son of Vinata. Steals the amrita to free his mother and becomes Vishnu's mount. Enemy of the Nagas." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-beast ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.16; MBh 1.33; MBh 1.34" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.16; MBh 1.23" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.16; MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.33" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxxiii> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.11" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485548.html> ] .

:hiranyakashipu a aoa:Person ;
    rdfs:label "Hiranyakashipu" ;
    rdfs:comment "Daitya king, Kashyapa's son by Diti and Jaya's first birth. Killed by Vishnu as Narasimha to protect his son Prahlada." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-asura ;
    aoa:role aoa:role-king ;
    aoa:parentOf :prahlada ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.65; MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.17, 7.1, 7.8" ; schema:url <https://vedabase.io/en/library/sb/7/1/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.17" ; schema:url <https://vedabase.io/en/library/sb/3/17/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.17, 6.18" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 7.1" ; schema:url <https://vedabase.io/en/library/sb/7/1/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 7.8" ; schema:url <https://vedabase.io/en/library/sb/7/8/> ] .

:hiranyaksha a aoa:Person ;
    rdfs:label "Hiranyaksha" ;
    rdfs:comment "Asura brother of Hiranyakashipu, killed by Vishnu as Varaha raising the earth from the ocean." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.17-3.19, 7.1" ; schema:url <https://vedabase.io/en/library/sb/3/18/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.17" ; schema:url <https://vedabase.io/en/library/sb/3/17/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.17, 6.18" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.19" ; schema:url <https://vedabase.io/en/library/sb/3/19/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 7.1" ; schema:url <https://vedabase.io/en/library/sb/7/1/> ] .

:ikshvaku a aoa:Person ;
    rdfs:label "Ikshvaku" ;
    rdfs:comment "Son of Manu and first king of Ayodhya. Founder of the Solar dynasty (Suryavamsha), Rama's line." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:ancestorOf :anaranya, :mahabhisha ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.70" ; schema:url <https://valmikiramayan.net/baala/sarga70/bala_70_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Ayodhya 2.110" ; schema:url <https://valmikiramayan.net/ayodhya/sarga110/ayodhya_110_prose.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.19" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424780.html> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.96" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcvi> ] .

:ila a aoa:Person ;
    rdfs:label "Ila" ;
    rdfs:comment "Child of Manu who lived as both man and woman. Mother of Pururavas, which ties the Lunar line to Manu." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :pururavas ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] .

:jayavijaya a aoa:Person ;
    rdfs:label "Jaya & Vijaya" ;
    rdfs:comment "Gatekeepers of Vaikuntha, cursed by the Sanaka Kumaras to be born three times as Vishnu's enemies (Bhagavata). The yuga of each birth comes from later commentary." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.16, 7.1" ; schema:url <https://vedabase.io/en/library/sb/7/1/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.16" ; schema:url <https://vedabase.io/en/library/sb/3/16/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 7.1" ; schema:url <https://vedabase.io/en/library/sb/7/1/> ] .

:kadru a aoa:Person ;
    rdfs:label "Kadru" ;
    rdfs:comment "Kashyapa's wife and mother of the thousand Nagas. Cheats her sister Vinata in a wager and curses the sons who refused to help her to burn in a future sacrifice." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :kaliya, :shesha, :takshaka, :vasuki ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.16; MBh 1.20; MBh 1.22; MBh 1.23" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.16" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.20" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.20; MBh 1.23" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.21" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.35; MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.35" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.6" ; schema:url <https://vedabase.io/en/library/sb/6/6/> ] .

:kurma a aoa:Avatar ;
    rdfs:label "Kurma" ;
    rdfs:comment "Second avatar, the tortoise who bears Mount Mandara on his back at the churning of the ocean." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.18" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xviii> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.7" ; schema:url <https://vedabase.io/en/library/sb/8/7/> ] .

:manthan a aoa:Event ;
    rdfs:label "Samudra Manthan" ;
    rdfs:comment "Devas and asuras churn the Ocean of Milk with Mount Mandara and Vasuki, Vishnu bearing the mountain as Kurma and Shiva drinking the poison. Retold in the Adi Parva." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:involves :airavata, :bali, :dhanvantari, :halahala, :indra, :kamadhenu, :kurma, :lakshmi, :mohini, :parijata, :rahu, :shiva, :uchchaihshravas, :vasuki ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.18" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xviii> ] .

:manu a aoa:Person ;
    rdfs:label "Vaivasvata Manu" ;
    rdfs:comment "Son of the sun god Vivasvan. Saved from the great flood by Matsya. His children Ila and Ikshvaku start the Lunar and Solar dynasties." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:parentOf :ikshvaku, :ila ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.186" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxvi> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.13, 8.24, 9.1" ; schema:url <https://vedabase.io/en/library/sb/9/1/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.13" ; schema:url <https://vedabase.io/en/library/sb/8/13/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.24" ; schema:url <https://vedabase.io/en/library/sb/8/24/> ] .

:mohini a aoa:Avatar ;
    rdfs:label "Mohini" ;
    rdfs:comment "Vishnu as an enchantress at the churning. She draws the asuras' eyes away and gives the amrita to the devas." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.19" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xix> ] .

:naranarayana a aoa:Avatar ;
    rdfs:label "Nara–Narayana" ;
    rdfs:comment "Twin sages doing penance at Badari, partial forms of Vishnu. The epic identifies them with Arjuna and Krishna." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.67; MBh 1.19" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] .

:narasimha a aoa:Avatar ;
    rdfs:label "Narasimha" ;
    rdfs:comment "Fourth avatar, the man-lion who bursts from a pillar at dusk and kills Hiranyakashipu to protect Prahlada." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 1.3" ; schema:url <https://vedabase.io/en/library/sb/1/3/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 7.8" ; schema:url <https://vedabase.io/en/library/sb/7/8/> ] .

:prahlada a aoa:Person ;
    rdfs:label "Prahlada" ;
    rdfs:comment "Son of Hiranyakashipu and devotee of Vishnu, saved by Narasimha. Grandfather of Bali." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-asura ;
    aoa:ancestorOf :bali ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.18, 7.8" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.18" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 7.8" ; schema:url <https://vedabase.io/en/library/sb/7/8/> ] .

:revati a aoa:Person, aoa:SpansYugas ;
    rdfs:label "Revati" ;
    rdfs:comment "Daughter of King Kakudmi. He takes her to Brahma to ask about a husband, and while they wait whole yugas pass on earth. She marries Balarama in the Dvapara." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.10" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485487.html> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 9.3" ; schema:url <https://vedabase.io/en/library/sb/9/3/> ] .

:varaha a aoa:Avatar ;
    rdfs:label "Varaha" ;
    rdfs:comment "Third avatar, the boar who lifts the earth out of the ocean and kills Hiranyaksha." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 1.3" ; schema:url <https://vedabase.io/en/library/sb/1/3/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.18-3.19" ; schema:url <https://vedabase.io/en/library/sb/3/19/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.18; Vishnu Purana 5.29" ; schema:url <https://vedabase.io/en/library/sb/3/18/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 3.19" ; schema:url <https://vedabase.io/en/library/sb/3/19/> ] ,
        [ a aoa:Citation ; rdfs:label "Vishnu P. 5.29" ; schema:url <https://sacred-texts.com/hin/vp/vp146.htm> ] .

:vasuki a aoa:Person, aoa:SpansYugas ;
    rdfs:label "Vasuki" ;
    rdfs:comment "Naga king, son of Kadru. The rope at the churning of the ocean. In the Adi Parva the Nagas revive the poisoned Bhima. His sister bears Astika." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-naga ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.16; MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.35; MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.38; MBh 1.48" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxxviii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65; MBh 1.18; MBh 1.38; MBh 1.48" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.128" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxviii> ] .

:vinata a aoa:Person ;
    rdfs:label "Vinata" ;
    rdfs:comment "Kadru's sister and Kashyapa's wife. Mother of Aruna and Garuda. Loses the wager and becomes Kadru's slave." ;
    aoa:period aoa:period-satya ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :aruna, :garuda ;
