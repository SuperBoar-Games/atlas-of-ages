# Recorded history, c. 3300 BCE to 1947 CE

@prefix : <https://w3id.org/atlas-of-ages#> .
@prefix aoa: <https://w3id.org/atlas-of-ages#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

:afzal a aoa:Person ;
    rdfs:label "Afzal Khan" ;
    rdfs:comment "Bijapur general killed by Shivaji at their meeting at Pratapgad in 1659." ;
    aoa:period aoa:period-history .

:aitareya a aoa:Event, aoa:Text ;
    rdfs:label "Aitareya Brahmana" ;
    rdfs:comment "Brahmana that tells of Harishchandra, his son Rohita, and the boy Shunahshepa saved by Vishvamitra. It also names Bharata and Janamejaya among anointed kings." ;
    aoa:period aoa:period-history .

:ajanta a aoa:Event ;
    rdfs:label "Ajanta murals" ;
    rdfs:comment "Buddhist caves whose 5th-century murals paint the Jataka tales." ;
    aoa:period aoa:period-history .

:ajatashatru a aoa:Person ;
    rdfs:label "Ajatashatru" ;
    rdfs:comment "Bimbisara's son, who imprisons his father and expands Magadha." ;
    aoa:period aoa:period-history .

:akbar a aoa:Person ;
    rdfs:label "Akbar" ;
    rdfs:comment "Mughal emperor (1556–1605). Has the Mahabharata translated into Persian as the Razmnama, and the Ramayana too." ;
    aoa:period aoa:period-history .

:alexander a aoa:Person ;
    rdfs:label "Alexander" ;
    rdfs:comment "Macedonian king who reaches the Punjab in 326 BCE and defeats Porus at the Hydaspes." ;
    aoa:period aoa:period-history .

:ambedkar a aoa:Person ;
    rdfs:label "B. R. Ambedkar" ;
    rdfs:comment "Chairs the committee that drafts India's constitution, adopted in 1949." ;
    aoa:period aoa:period-history .

:aryabhata a aoa:Sage ;
    rdfs:label "Aryabhata" ;
    rdfs:comment "Astronomer. Writing in 499 CE, he fixes the start of the Kali Yuga at 3102 BCE, the date the tradition still uses." ;
    aoa:period aoa:period-history .

:ashoka a aoa:Person ;
    rdfs:label "Ashoka" ;
    rdfs:comment "Chandragupta's grandson. After the Kalinga war he spreads the Buddha's teaching across Asia." ;
    aoa:period aoa:period-history .

:ashvalayana a aoa:Event, aoa:Text ;
    rdfs:label "Ashvalayana Sutra" ;
    rdfs:comment "Grihya Sutra that lists a Bharata and a Mahabharata among texts to be honoured, among the earliest mentions of the epic by name." ;
    aoa:period aoa:period-history .

:aurangzeb a aoa:Person ;
    rdfs:label "Aurangzeb" ;
    rdfs:comment "Mughal emperor (1658–1707) whose long wars with the Marathas and others overstretch the empire." ;
    aoa:period aoa:period-history .

:aurobindo a aoa:Sage ;
    rdfs:label "Sri Aurobindo" ;
    rdfs:comment "Revolutionary turned yogi. His Essays on the Gita appear from 1916." ;
    aoa:period aoa:period-history .

:babur a aoa:Person ;
    rdfs:label "Babur" ;
    rdfs:comment "Founds the Mughal empire after defeating Ibrahim Lodi at Panipat in 1526." ;
    aoa:period aoa:period-history .

:badami a aoa:Event ;
    rdfs:label "Badami caves" ;
    rdfs:comment "Chalukya cave temples (578 CE) with reliefs of Vishnu as Narasimha and Varaha." ;
    aoa:period aoa:period-history .

:bahadurshah a aoa:Person ;
    rdfs:label "Bahadur Shah Zafar" ;
    rdfs:comment "Last Mughal emperor, proclaimed leader of the 1857 revolt and exiled to Rangoon." ;
    aoa:period aoa:period-history .

:balauttara a aoa:Event, aoa:Text ;
    rdfs:label "Bala & Uttara Kandas" ;
    rdfs:comment "The Ramayana's first and last books, with the bow contest, Rama's divinity and Sita's final exile, usually dated after the core books, by about the 1st century CE." ;
    aoa:period aoa:period-history .

:bankim a aoa:Person ;
    rdfs:label "Bankim Chandra" ;
    rdfs:comment "Bengali novelist. His Krishnacharitra (1886) reads Krishna as a historical figure. Author of \"Vande Mataram\"." ;
    aoa:period aoa:period-history .

:bharavi a aoa:Sage ;
    rdfs:label "Bharavi" ;
    rdfs:comment "Poet of the Kiratarjuniya (6th century) on Arjuna's fight with Shiva disguised as a hunter." ;
    aoa:period aoa:period-history .

:bhasa a aoa:Sage ;
    rdfs:label "Bhasa" ;
    rdfs:comment "Early Sanskrit dramatist. His plays include Urubhanga on Duryodhana's death, Dutavakya on Krishna's peace mission, and Svapnavasavadatta on Udayana." ;
    aoa:period aoa:period-history .

:bimbisara a aoa:Person ;
    rdfs:label "Bimbisara" ;
    rdfs:comment "King of Magadha and patron of the Buddha." ;
    aoa:period aoa:period-history ;
    aoa:parentOf :ajatashatru .

:bindusara a aoa:Person ;
    rdfs:label "Bindusara" ;
    rdfs:comment "Second Maurya emperor, son of Chandragupta and father of Ashoka." ;
    aoa:period aoa:period-history ;
    aoa:parentOf :ashoka .

:bori a aoa:Event, aoa:Text ;
    rdfs:label "Critical edition" ;
    rdfs:comment "The Bhandarkar Institute in Pune begins the critical edition of the Mahabharata in 1919 under V. S. Sukthankar, comparing over a thousand manuscripts. Completed in 1966." ;
    aoa:period aoa:period-history .

:bose a aoa:Person ;
    rdfs:label "Subhas Bose" ;
    rdfs:comment "Nationalist leader who heads the Indian National Army against British rule." ;
    aoa:period aoa:period-history .

:brihadaranyaka a aoa:Event, aoa:Text ;
    rdfs:label "Brihadaranyaka Upanishad" ;
    rdfs:comment "Upanishad in which Janaka of Videha hosts debates at his court and Yajnavalkya teaches." ;
    aoa:period aoa:period-history .

:buddha a aoa:Sage ;
    rdfs:label "Gautama Buddha" ;
    rdfs:comment "Siddhartha of the Shakyas. The Dasaratha Jataka tells the Rama story as one of his past lives, and later Puranas count him as an avatar of Vishnu." ;
    aoa:period aoa:period-history ;
    aoa:parentOf :rahula .

:chaitanya a aoa:Sage ;
    rdfs:label "Chaitanya" ;
    rdfs:comment "Bengali saint (1486–1534) who spreads Krishna devotion through congregational singing. His followers see him as Radha and Krishna in one." ;
    aoa:period aoa:period-history .

:chanakya a aoa:Sage ;
    rdfs:label "Chanakya" ;
    rdfs:comment "Kautilya, Chandragupta's adviser, traditionally the author of the Arthashastra." ;
    aoa:period aoa:period-history .

:chandogya a aoa:Event, aoa:Text ;
    rdfs:label "Chandogya Upanishad" ;
    rdfs:comment "Mentions a Krishna, son of Devaki, taught by the sage Ghora Angirasa. Often read as the earliest reference to Krishna." ;
    aoa:period aoa:period-history .

:chandragupta a aoa:Person ;
    rdfs:label "Chandragupta Maurya" ;
    rdfs:comment "Founds the Maurya empire around 322 BCE." ;
    aoa:period aoa:period-history ;
    aoa:parentOf :bindusara .

:chandragupta2 a aoa:Person ;
    rdfs:label "Chandragupta II" ;
    rdfs:comment "Gupta emperor (c. 380–415 CE), whom tradition links with Kalidasa." ;
    aoa:period aoa:period-history .

:darius a aoa:Person ;
    rdfs:label "Darius I" ;
    rdfs:comment "Achaemenid emperor who annexes Gandhara and the Indus region around 518 BCE." ;
    aoa:period aoa:period-history .

:deogarh a aoa:Event ;
    rdfs:label "Deogarh temple" ;
    rdfs:comment "Dashavatara temple (c. 500 CE), one of the earliest stone temples, with panels of Nara–Narayana and Vishnu resting on Shesha." ;
    aoa:period aoa:period-history .

:dhananda a aoa:Person ;
    rdfs:label "Dhana Nanda" ;
    rdfs:comment "Last Nanda king of Magadha, overthrown by Chandragupta." ;
    aoa:period aoa:period-history .

:divodasa a aoa:Person ;
    rdfs:label "Divodasa" ;
    rdfs:comment "Bharata king in the Rigveda and father of Sudas." ;
    aoa:period aoa:period-history ;
    aoa:parentOf :sudas .

:eic a aoa:Event ;
    rdfs:label "East India Company" ;
    rdfs:comment "British trading company that takes Bengal after Plassey and much of India by 1857." ;
    aoa:period aoa:period-history .

:gandhi a aoa:Person ;
    rdfs:label "Gandhi" ;
    rdfs:comment "Leader of the independence movement. Reads the Gita daily as his guide and holds up Ram Rajya as the ideal of just rule." ;
    aoa:period aoa:period-history .

:ghori a aoa:Person ;
    rdfs:label "Muhammad of Ghor" ;
    rdfs:comment "Ghurid ruler who defeats Prithviraj in 1192. His general Qutb ud-Din Aibak founds the Delhi Sultanate in 1206." ;
    aoa:period aoa:period-history .

:gobindsingh a aoa:Sage ;
    rdfs:label "Guru Gobind Singh" ;
    rdfs:comment "Tenth Sikh Guru. The Dasam Granth, attributed to him, retells the avatar stories of Rama and Krishna." ;
    aoa:period aoa:period-history .

:h_1857 a aoa:Story ;
    rdfs:label "Revolt of 1857" ;
    rdfs:comment "Soldiers and rulers rise against Company rule. After its defeat the Crown takes over in 1858." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_bori ;
    aoa:involves :bahadurshah, :eic, :lakshmibai, :raj .

:h_1947 a aoa:Story ;
    rdfs:label "Independence and Partition" ;
    rdfs:comment "15 August 1947. British rule ends, and India and Pakistan are partitioned." ;
    aoa:period aoa:period-history ;
    aoa:involves :ambedkar, :bose, :gandhi, :jinnah, :nehru, :patel, :raj .

:h_bori a aoa:Story, aoa:Text ;
    rdfs:label "Critical edition begun" ;
    rdfs:comment "1919. Scholars in Pune set out to reconstruct the oldest recoverable Mahabharata text." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_1947 ;
    aoa:involves :bori, :vyasa .

:h_buddha a aoa:Story ;
    rdfs:label "Buddha and Mahavira" ;
    rdfs:comment "c. 5th century BCE. New teachings arise in Magadha under Bimbisara and Ajatashatru." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_maurya ;
    aoa:involves :ajatashatru, :bimbisara, :buddha, :janapadas, :jatakas, :mahavira, :prasenajit, :shuddhodana, :udayana .

:h_gupta a aoa:Story ;
    rdfs:label "Gupta age" ;
    rdfs:comment "c. 320–550 CE. The Puranas take shape, the first stone temples rise, and Kalidasa writes." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_sultanate ;
    aoa:involves :aryabhata, :chandragupta2, :deogarh, :kalidasa, :samudragupta, :udayagiri, :vishnupurana .

:h_helio a aoa:Story ;
    rdfs:label "Heliodorus pillar" ;
    rdfs:comment "c. 110 BCE. The first known inscription by a devotee of Vasudeva-Krishna." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_text ;
    aoa:involves :heliodorus, :krishna, :morawell, :patanjali, :satakarni .

:h_indus a aoa:Story ;
    rdfs:label "Indus civilisation" ;
    rdfs:comment "c. 3300–1300 BCE. The first cities of South Asia. Nothing in them can yet be tied to the epics." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_ten ;
    aoa:involves :harappa .

:h_kuru a aoa:Story ;
    rdfs:label "Kuru kingdom" ;
    rdfs:comment "The first large state of the Vedic age, around Kurukshetra. The Atharvaveda praises King Parikshit, and the Shatapatha Brahmana names Janamejaya performing the horse sacrifice." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_flood ;
    aoa:involves :aitareya, :brihadaranyaka, :chandogya, :janakav, :pgw, :shatapatha, :yajnavalkya .

:h_maratha a aoa:Story ;
    rdfs:label "Maratha kingdom" ;
    rdfs:comment "1674. Shivaji is crowned after years of war with Bijapur and the Mughals." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_plassey ;
    aoa:involves :afzal, :aurangzeb, :ramdas, :sambhaji, :shivaji .

:h_maurya a aoa:Story ;
    rdfs:label "Maurya empire" ;
    rdfs:comment "c. 322 BCE. Chandragupta and Chanakya overthrow the Nandas. Ashoka later carries the Buddha's teaching abroad." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_helio ;
    aoa:involves :alexander, :ashoka, :bindusara, :chanakya, :chandragupta, :dhananda, :megasthenes, :porus .

:h_panipat a aoa:Story ;
    rdfs:label "First Battle of Panipat" ;
    rdfs:comment "1526. Babur defeats Ibrahim Lodi and Mughal rule begins." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_razm ;
    aoa:involves :babur, :ibrahimlodi .

:h_plassey a aoa:Story ;
    rdfs:label "Battle of Plassey" ;
    rdfs:comment "1757. The East India Company defeats Siraj ud-Daulah and takes Bengal." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_1857 ;
    aoa:involves :eic, :siraj .

:h_razm a aoa:Story, aoa:Text ;
    rdfs:label "Razmnama" ;
    rdfs:comment "c. 1584–86. Akbar's court translates the Mahabharata into Persian, with richly illustrated copies." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_maratha ;
    aoa:involves :akbar, :vyasa .

:h_sultanate a aoa:Story ;
    rdfs:label "Delhi Sultanate" ;
    rdfs:comment "1192–1206. Prithviraj falls at Tarain, and the Sultanate is founded in Delhi." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_vijaya ;
    aoa:involves :ghori, :prithviraj .

:h_ten a aoa:Story ;
    rdfs:label "Battle of the Ten Kings" ;
    rdfs:comment "The Rigveda's battle on the Parushni river, where the Bharatas under Sudas defeat a confederacy that includes the Purus." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_kuru ;
    aoa:involves :divodasa, :rigveda, :sarasvati, :sudas .

:h_text a aoa:Story, aoa:Text ;
    rdfs:label "Epics take final form" ;
    rdfs:comment "c. 400 BCE–400 CE. The Mahabharata grows to about 100,000 verses and the Ramayana gains its first and last books." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_gupta ;
    aoa:involves :balauttara, :bhasa, :harivamsat, :mbhcore, :ramcore, :valmiki, :vyasa .

:h_vijaya a aoa:Story ;
    rdfs:label "Vijayanagara" ;
    rdfs:comment "1336. Harihara and Bukka found the empire at Hampi, the traditional Kishkindha." ;
    aoa:period aoa:period-history ;
    aoa:leadsTo :h_panipat ;
    aoa:involves :harihara, :krishnadevaraya .

:harappa a aoa:Event ;
    rdfs:label "Harappan cities" ;
    rdfs:comment "Harappa, Mohenjo-daro, Dholavira and Lothal flourish in the northwest. The script is undeciphered, so no link to the epics can be read from it." ;
    aoa:period aoa:period-history .

:harihara a aoa:Person ;
    rdfs:label "Harihara & Bukka" ;
    rdfs:comment "Brothers who found the Vijayanagara empire in 1336. Its capital Hampi is traditionally identified with Kishkindha." ;
    aoa:period aoa:period-history .

:harivamsat a aoa:Event, aoa:Text ;
    rdfs:label "Harivamsa composed" ;
    rdfs:comment "Appendix to the Mahabharata telling Krishna's life and the Yadava line, usually dated to the 1st–3rd centuries CE." ;
    aoa:period aoa:period-history .

:heliodorus a aoa:Person ;
    rdfs:label "Heliodorus" ;
    rdfs:comment "Greek ambassador who raises a pillar at Vidisha around 110 BCE calling himself a devotee of Vasudeva." ;
    aoa:period aoa:period-history .

:ibrahimlodi a aoa:Person ;
    rdfs:label "Ibrahim Lodi" ;
    rdfs:comment "Last Delhi sultan of the Lodi dynasty, killed at the first battle of Panipat in 1526." ;
    aoa:period aoa:period-history .

:janakav a aoa:Person ;
    rdfs:label "Janaka of Videha" ;
    rdfs:comment "Learned king of Videha in the Upanishads. Janaka is a dynastic title, and Sita's father bears the same name in the Ramayana." ;
    aoa:period aoa:period-history .

:janapadas a aoa:Event ;
    rdfs:label "Sixteen Mahajanapadas" ;
    rdfs:comment "The great kingdoms of the Buddha's time include Kuru, Panchala, Matsya, Shurasena, Kosala, Kashi, Anga, Chedi, Avanti and Gandhara, all kingdoms of the epics." ;
    aoa:period aoa:period-history .

:jatakas a aoa:Event, aoa:Text ;
    rdfs:label "Jatakas" ;
    rdfs:comment "Buddhist birth stories. The Dasaratha Jataka tells a Rama story, and the Ghata Jataka tells of Kamsa and Vasudeva's sons, a Buddhist version of Krishna's family." ;
    aoa:period aoa:period-history .

:jayadeva a aoa:Sage ;
    rdfs:label "Jayadeva" ;
    rdfs:comment "Poet of the Gita Govinda (12th century), which makes Radha central to Krishna devotion." ;
    aoa:period aoa:period-history .

:jinnah a aoa:Person ;
    rdfs:label "M. A. Jinnah" ;
    rdfs:comment "Leader of the Muslim League and first governor-general of Pakistan in 1947." ;
    aoa:period aoa:period-history .

:kabir a aoa:Sage ;
    rdfs:label "Kabir" ;
    rdfs:comment "Weaver-poet (15th century) whose songs centre on the name of Rama, beyond any image." ;
    aoa:period aoa:period-history .

:kalidasa a aoa:Sage ;
    rdfs:label "Kalidasa" ;
    rdfs:comment "Classical poet. His play Shakuntala retells Dushyanta and Shakuntala, and his Raghuvamsha tells the kings from Dilipa to Rama." ;
    aoa:period aoa:period-history .

:kamban a aoa:Sage ;
    rdfs:label "Kamban" ;
    rdfs:comment "Tamil poet of the Ramavataram (12th century), known as the Kamba Ramayanam." ;
    aoa:period aoa:period-history .

:kanishka a aoa:Person ;
    rdfs:label "Kanishka" ;
    rdfs:comment "Kushana emperor (2nd century CE). Kushana Mathura produces early images of Vasudeva and Samkarshana." ;
    aoa:period aoa:period-history .

:krishnadevaraya a aoa:Person ;
    rdfs:label "Krishnadevaraya" ;
    rdfs:comment "Vijayanagara emperor (1509–1529) and patron of Telugu and Kannada poetry." ;
    aoa:period aoa:period-history .

:krittivasa a aoa:Sage ;
    rdfs:label "Krittivasa" ;
    rdfs:comment "Bengali poet of the Krittivasi Ramayana (15th century)." ;
    aoa:period aoa:period-history .

:lakshmibai a aoa:Person ;
    rdfs:label "Rani Lakshmibai" ;
    rdfs:comment "Rani of Jhansi, killed fighting Company forces in 1858." ;
    aoa:period aoa:period-history .

:madhva a aoa:Sage ;
    rdfs:label "Madhvacharya" ;
    rdfs:comment "Philosopher of Dvaita (13th century). His followers hold him to be the third incarnation of Vayu, after Hanuman and Bhima." ;
    aoa:period aoa:period-history .

:mahavira a aoa:Sage ;
    rdfs:label "Mahavira" ;
    rdfs:comment "Twenty-fourth Jain tirthankara and a contemporary of the Buddha." ;
    aoa:period aoa:period-history .

:mbhcore a aoa:Event, aoa:Text ;
    rdfs:label "Bharata core" ;
    rdfs:comment "A shorter epic of the war, the Bharata, is thought to underlie the Mahabharata, which grows from about the 4th century BCE." ;
    aoa:period aoa:period-history .

:megasthenes a aoa:Person ;
    rdfs:label "Megasthenes" ;
    rdfs:comment "Greek envoy at Chandragupta's court. Describes the Sourasenoi of Mathura worshipping a god he calls Heracles, usually taken to be Krishna." ;
    aoa:period aoa:period-history .

:mirabai a aoa:Sage ;
    rdfs:label "Mirabai" ;
    rdfs:comment "Rajput princess and poet (16th century) devoted to Krishna." ;
    aoa:period aoa:period-history .

:morawell a aoa:Event ;
    rdfs:label "Mora well inscription" ;
    rdfs:comment "Inscription near Mathura (1st century CE) honouring five Vrishni heroes: Samkarshana, Vasudeva, Pradyumna, Samba and Aniruddha." ;
    aoa:period aoa:period-history .

:nanak a aoa:Sage ;
    rdfs:label "Guru Nanak" ;
    rdfs:comment "Founder of Sikhism (1469–1539)." ;
    aoa:period aoa:period-history .

:nannaya a aoa:Sage ;
    rdfs:label "Nannaya" ;
    rdfs:comment "Begins the Telugu Mahabharata in the 11th century, later completed by Tikkana and Errana." ;
    aoa:period aoa:period-history .

:nehru a aoa:Person ;
    rdfs:label "Jawaharlal Nehru" ;
    rdfs:comment "First prime minister of India, from 15 August 1947." ;
    aoa:period aoa:period-history .

:pampa a aoa:Sage ;
    rdfs:label "Pampa" ;
    rdfs:comment "Kannada poet. His Vikramarjuna Vijaya (941 CE) retells the Mahabharata with Arjuna as hero." ;
    aoa:period aoa:period-history .

:panini a aoa:Sage ;
    rdfs:label "Panini" ;
    rdfs:comment "Grammarian (c. 4th century BCE). His grammar already names Vasudeva and Arjuna as objects of devotion." ;
    aoa:period aoa:period-history .

:patanjali a aoa:Sage ;
    rdfs:label "Patanjali" ;
    rdfs:comment "Grammarian (c. 150 BCE). His Mahabhashya mentions performances of the killing of Kamsa and the binding of Bali." ;
    aoa:period aoa:period-history .

:patel a aoa:Person ;
    rdfs:label "Sardar Patel" ;
    rdfs:comment "Congress leader who becomes deputy prime minister and integrates the princely states." ;
    aoa:period aoa:period-history .

:pgw a aoa:Event ;
    rdfs:label "Painted Grey Ware sites" ;
    rdfs:comment "Iron Age culture of the Kuru-Panchala region (c. 1200–600 BCE). Its sites include Hastinapura, Indraprastha and Mathura. Excavations at Hastinapura in the 1950s found a settlement cut by a Ganga flood." ;
    aoa:period aoa:period-history .

:porus a aoa:Person ;
    rdfs:label "Porus" ;
    rdfs:comment "King on the Jhelum who fights Alexander in 326 BCE. His name is often linked with the Puru tribe." ;
    aoa:period aoa:period-history .

:prasenajit a aoa:Person ;
    rdfs:label "Prasenajit" ;
    rdfs:comment "King of Kosala and patron of the Buddha. The Puranas place him in Rama's Ikshvaku line." ;
    aoa:period aoa:period-history .

:prithviraj a aoa:Person ;
    rdfs:label "Prithviraj Chauhan" ;
    rdfs:comment "Chahamana king of Ajmer and Delhi, defeated at the second battle of Tarain in 1192." ;
    aoa:period aoa:period-history .

:pushyamitra a aoa:Person ;
    rdfs:label "Pushyamitra Shunga" ;
    rdfs:comment "Maurya general who kills the last Maurya king around 185 BCE and founds the Shunga dynasty." ;
    aoa:period aoa:period-history .

:rahula a aoa:Person ;
    rdfs:label "Rahula" ;
    rdfs:comment "The Buddha's son, later a monk. The Puranas list him in the Ikshvaku line." ;
    aoa:period aoa:period-history .

:raj a aoa:Event ;
    rdfs:label "British Crown" ;
    rdfs:comment "Takes over the rule of India from the East India Company in 1858." ;
    aoa:period aoa:period-history .

:ramanuja a aoa:Sage ;
    rdfs:label "Ramanuja" ;
    rdfs:comment "Philosopher of Vishishtadvaita (11th–12th century) who writes a Gita commentary centred on devotion to Vishnu." ;
    aoa:period aoa:period-history .

:ramcore a aoa:Event, aoa:Text ;
    rdfs:label "Ramayana core" ;
    rdfs:comment "Books 2 to 6 of Valmiki's Ramayana, from Rama's exile to the war, usually dated to around the 5th–4th centuries BCE." ;
    aoa:period aoa:period-history .

:ramdas a aoa:Sage ;
    rdfs:label "Samarth Ramdas" ;
    rdfs:comment "Marathi saint and devotee of Hanuman who founds Maruti shrines across Maharashtra. Tradition makes him Shivaji's guide." ;
    aoa:period aoa:period-history .

:ravivarma a aoa:Person ;
    rdfs:label "Raja Ravi Varma" ;
    rdfs:comment "Painter (1848–1906) whose oil paintings of Shakuntala, Damayanti and the epic heroes shape how many Indians picture them." ;
    aoa:period aoa:period-history .

:sambhaji a aoa:Person ;
    rdfs:label "Sambhaji" ;
    rdfs:comment "Shivaji's son, captured and executed on Aurangzeb's orders in 1689." ;
    aoa:period aoa:period-history .

:samudragupta a aoa:Person ;
    rdfs:label "Samudragupta" ;
    rdfs:comment "Gupta emperor (c. 335–375 CE) whose Allahabad pillar inscription records his conquests." ;
    aoa:period aoa:period-history ;
    aoa:parentOf :chandragupta2 .

:sangam a aoa:Event, aoa:Text ;
    rdfs:label "Sangam poems" ;
    rdfs:comment "Early Tamil poetry. One poem describes monkeys wearing the jewels Sita dropped, and another praises a Chera king for feeding both armies in the great war." ;
    aoa:period aoa:period-history .

:sarasvati a aoa:Event ;
    rdfs:label "Sarasvati river" ;
    rdfs:comment "River the Rigveda praises as the greatest of rivers. In the Mahabharata it has already sunk into the sand at Vinashana, where Balarama follows it on pilgrimage. Many identify it with the Ghaggar-Hakra." ;
    aoa:period aoa:period-history .

:satakarni a aoa:Person ;
    rdfs:label "Gautamiputra Satakarni" ;
    rdfs:comment "Satavahana king (2nd century CE). His mother's inscription at Nashik compares him to Rama, Keshava, Arjuna and Bhimasena." ;
    aoa:period aoa:period-history .

:shankara a aoa:Sage ;
    rdfs:label "Adi Shankara" ;
    rdfs:comment "Philosopher of Advaita (c. 8th century). His commentary on the Bhagavad Gita is the oldest that survives." ;
    aoa:period aoa:period-history .

:shatapatha a aoa:Event, aoa:Text ;
    rdfs:label "Shatapatha Brahmana" ;
    rdfs:comment "Brahmana that first tells Manu's flood with the fish, gives the full story of Pururavas and Urvashi, records the horse sacrifices of Bharata son of Dushyanta, and names Janamejaya." ;
    aoa:period aoa:period-history .

:shivaji a aoa:Person ;
    rdfs:label "Shivaji" ;
    rdfs:comment "Founds the Maratha kingdom and is crowned in 1674." ;
    aoa:period aoa:period-history ;
    aoa:parentOf :sambhaji ;
    aoa:kills :afzal .

:shuddhodana a aoa:Person ;
    rdfs:label "Shuddhodana" ;
    rdfs:comment "Shakya chief and the Buddha's father. The Puranas count the Shakyas in the Ikshvaku line." ;
    aoa:period aoa:period-history ;
    aoa:parentOf :buddha .

:siraj a aoa:Person ;
    rdfs:label "Siraj ud-Daulah" ;
    rdfs:comment "Nawab of Bengal, defeated by Robert Clive at Plassey in 1757." ;
    aoa:period aoa:period-history .

:sudas a aoa:Person ;
    rdfs:label "Sudas" ;
    rdfs:comment "Bharata king in the Rigveda who wins the Battle of the Ten Kings. Vishvamitra and later Vashishtha serve as his priests." ;
    aoa:period aoa:period-history .

:surdas a aoa:Sage ;
    rdfs:label "Surdas" ;
    rdfs:comment "Poet of the Sursagar, songs of Krishna's childhood in Vraja (16th century)." ;
    aoa:period aoa:period-history .

:tagore a aoa:Person ;
    rdfs:label "Rabindranath Tagore" ;
    rdfs:comment "Poet. His \"Karna-Kunti Samvad\" (1900) retells Kunti's meeting with Karna before the war." ;
    aoa:period aoa:period-history .

:teghbahadur a aoa:Sage ;
    rdfs:label "Guru Tegh Bahadur" ;
    rdfs:comment "Ninth Sikh Guru, executed in Delhi in 1675 on Aurangzeb's orders." ;
    aoa:period aoa:period-history ;
    aoa:parentOf :gobindsingh .

:tilak a aoa:Person ;
    rdfs:label "Bal Gangadhar Tilak" ;
    rdfs:comment "Nationalist leader. Writes Gita Rahasya (1915) in Mandalay prison, reading the Gita as a call to action." ;
    aoa:period aoa:period-history .

:tipu a aoa:Person ;
    rdfs:label "Tipu Sultan" ;
    rdfs:comment "Ruler of Mysore, killed defending Srirangapatna against the East India Company in 1799." ;
    aoa:period aoa:period-history .

:tulsidas a aoa:Sage ;
    rdfs:label "Tulsidas" ;
    rdfs:comment "Poet of the Ramcharitmanas (1574) in Awadhi, the most widely read Ramayana in north India." ;
    aoa:period aoa:period-history .

:udayagiri a aoa:Event ;
    rdfs:label "Udayagiri Varaha" ;
    rdfs:comment "Cave shrine near Vidisha (c. 401 CE) with a colossal relief of Vishnu as Varaha lifting the earth." ;
    aoa:period aoa:period-history .

:udayana a aoa:Person ;
    rdfs:label "Udayana" ;
    rdfs:comment "King of Vatsa at Kaushambi and a contemporary of the Buddha. The Puranas place him in the Kuru line. Hero of Bhasa's plays." ;
    aoa:period aoa:period-history .

:udiyan a aoa:Person ;
    rdfs:label "Udiyan Cheralathan" ;
    rdfs:comment "Chera king of the Sangam poems (Purananuru 2), praised for feeding both armies at the great war." ;
    aoa:period aoa:period-history .

:vimalasuri a aoa:Sage ;
    rdfs:label "Vimalasuri" ;
    rdfs:comment "Jain poet of the Paumachariya, a Jain Ramayana in which Lakshmana, not Rama, kills Ravana." ;
    aoa:period aoa:period-history .

:vivekananda a aoa:Sage ;
    rdfs:label "Vivekananda" ;
    rdfs:comment "Monk (1863–1902) who brings Vedanta and the Gita to audiences in the West." ;
    aoa:period aoa:period-history .

:wilkins a aoa:Person ;
    rdfs:label "Charles Wilkins" ;
    rdfs:comment "Publishes the first English translation of the Bhagavad Gita in 1785." ;
    aoa:period aoa:period-history .

:yajnavalkya a aoa:Sage ;
    rdfs:label "Yajnavalkya" ;
    rdfs:comment "Sage at Janaka's court and the central teacher of the Brihadaranyaka Upanishad." ;
    aoa:period aoa:period-history .

