# Kali Yuga

@prefix : <https://w3id.org/yugachakra#> .
@prefix yc: <https://w3id.org/yugachakra#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

:astika a yc:Sage ;
    rdfs:label "Astika" ;
    rdfs:comment "Son of the sage Jaratkaru and Vasuki's sister. Persuades Janamejaya to end the snake sacrifice." ;
    yc:period yc:period-kali ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.38; MBh 1.48" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxxviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.48; MBh 1.58" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xlviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.58" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lviii> ] .

:dvarakasinks a yc:Event, yc:Catastrophe ;
    rdfs:label "Sea swallows Dvaraka" ;
    rdfs:comment "After Krishna's death the ocean rises and swallows Dvaraka as Arjuna leads the survivors away (Mausala Parva)." ;
    yc:period yc:period-kali ;
    yc:tier yc:tier-core ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 16.7" ; schema:url <https://sacred-texts.com/hin/m16/m16007.htm> ] .

:e_final a yc:Story ;
    rdfs:label "Final journey" ;
    rdfs:comment "The Pandavas and Draupadi walk toward the Himalaya and fall one by one. Only Yudhishthira and a dog, who is Dharma, reach the end." ;
    yc:period yc:period-kali ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_heaven ;
    yc:involves :arjuna, :bhima, :draupadi, :twins, :yama, :yudhishthira ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 17.2" ; schema:url <https://sacred-texts.com/hin/m17/m17002.htm> ] .

:e_heaven a yc:Story ;
    rdfs:label "Ascent to heaven" ;
    rdfs:comment "Yudhishthira finds Duryodhana in heaven and his brothers seemingly in hell, a final test of dharma (Svargarohana Parva)." ;
    yc:period yc:period-kali ;
    yc:tier yc:tier-core ;
    yc:involves :duryodhana, :karna, :yudhishthira ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 18.3" ; schema:url <https://sacred-texts.com/hin/m18/m18003.htm> ] .

:endkali a yc:Event, yc:Catastrophe ;
    rdfs:label "End of the Kali Yuga" ;
    rdfs:comment "Markandeya foretells the end of the age: dharma fails, the rains stop, fire and flood sweep the world, and Kalki restores a new age of truth (Vana Parva)." ;
    yc:period yc:period-kali ;
    yc:tier yc:tier-core ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 3.189-190" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxix> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.189" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxix> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 12.2" ; schema:url <https://vedabase.io/en/library/sb/12/2/> ] .

:janamejaya a yc:Person ;
    rdfs:label "Janamejaya" ;
    rdfs:comment "Son of Parikshit. Holds the snake sacrifice to avenge his father, and the epic is first recited there." ;
    yc:period yc:period-kali ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :shatanika ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.20" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xx> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.44; MBh 1.50; MBh 1.60" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xliv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.50; MBh 1.58" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-l> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.50; MBh 1.52" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-l> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.60" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lx> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.95; MBh 1.44" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] .

:jara a yc:Person ;
    rdfs:label "Jara" ;
    rdfs:comment "Hunter who mistakes Krishna, lying in yoga, for a deer and pierces his heel. Folk tradition makes him Vali reborn." ;
    yc:period yc:period-kali ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 16.4" ; schema:url <https://sacred-texts.com/hin/m16/m16004.htm> ] .

:kalki a yc:Avatar ;
    rdfs:label "Kalki" ;
    rdfs:comment "Tenth avatar, foretold to come at the end of the Kali Yuga and restore the age of truth (Vana Parva). The Bhagavata mounts him on the horse Devadatta." ;
    yc:period yc:period-kali ;
    yc:tier yc:tier-core ;
    yc:being yc:being-god ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 3.189-190" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxix> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.189" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxix> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 1.3, 12.2" ; schema:url <https://vedabase.io/en/library/sb/1/3/> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 12.2, 1.3" ; schema:url <https://vedabase.io/en/library/sb/12/2/> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 12.2" ; schema:url <https://vedabase.io/en/library/sb/12/2/> ] .

:sarpasatra a yc:Event, yc:Catastrophe ;
    rdfs:label "Snake sacrifice" ;
    rdfs:comment "Janamejaya's rite draws the Nagas into the fire by the thousand until Astika stops it. The epic is first recited during its pauses." ;
    yc:period yc:period-kali ;
    yc:tier yc:tier-core ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.1; MBh 1.60" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-i> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.20" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xx> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.50; MBh 1.52" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-l> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.52; MBh 1.58; MBh 1.1" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.58" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lviii> ] .

:sauti a yc:Sage ;
    rdfs:label "Sauti (Ugrashravas)" ;
    rdfs:comment "The bard who heard Vaishampayana and retells the epic to Shaunaka's sages in the Naimisha forest. The text opens here, Adi Parva 1.1." ;
    yc:period yc:period-kali ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.1" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-i> ] .

:shatanika a yc:Person ;
    rdfs:label "Shatanika" ;
    rdfs:comment "Son of Janamejaya and father of Ashvamedhadatta, named in the Adi Parva." ;
    yc:period yc:period-kali ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] .

:shringi a yc:Sage ;
    rdfs:label "Shringi" ;
    rdfs:comment "Son of the sage Shamika. Curses Parikshit to die by Takshaka's bite within seven days, after Parikshit drapes a dead snake on his father." ;
    yc:period yc:period-kali ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.40; MBh 1.41; MBh 1.42" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xl> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.41" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xli> ] .

:takshaka a yc:Person, yc:SpansYugas ;
    rdfs:label "Takshaka" ;
    rdfs:comment "Naga king, son of Kadru. Kills Parikshit. Hunted by Janamejaya's sacrifice, he is saved when Astika stops it." ;
    yc:period yc:period-kali ;
    yc:tier yc:tier-core ;
    yc:being yc:being-naga ;
    yc:parentOf :ashvasena ;
    yc:kills :parikshit ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.35; MBh 1.43; MBh 1.58" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.35; MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.43" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xliii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.50; MBh 1.58" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-l> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.58" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.229" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxix> ] .

:vaishampayana a yc:Sage ;
    rdfs:label "Vaishampayana" ;
    rdfs:comment "Disciple of Vyasa. First reciter of the epic, at Janamejaya's snake sacrifice." ;
    yc:period yc:period-kali ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.1" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-i> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.1; MBh 1.60" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-i> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.60; MBh 1.1" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lx> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.60; MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lx> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.60" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lx> ] .

