# Kali Yuga

@prefix : <https://w3id.org/atlas-of-ages#> .
@prefix aoa: <https://w3id.org/atlas-of-ages#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

:astika a aoa:Sage ;
    rdfs:label "Astika" ;
    rdfs:comment "Son of the sage Jaratkaru and Vasuki's sister. Persuades Janamejaya to end the snake sacrifice." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.38; MBh 1.48" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxxviii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.48; MBh 1.58" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xlviii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.58" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lviii> ] .

:dvarakasinks a aoa:Event, aoa:Catastrophe ;
    rdfs:label "Sea swallows Dvaraka" ;
    rdfs:comment "After Krishna's death the ocean rises and swallows Dvaraka as Arjuna leads the survivors away (Mausala Parva)." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 16.7" ; schema:url <https://sacred-texts.com/hin/m16/m16007.htm> ] .

:e_final a aoa:Story ;
    rdfs:label "Final journey" ;
    rdfs:comment "The Pandavas and Draupadi walk toward the Himalaya and fall one by one. Only Yudhishthira and a dog, who is Dharma, reach the end." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-core ;
    aoa:leadsTo :e_heaven ;
    aoa:involves :arjuna, :bhima, :draupadi, :twins, :yama, :yudhishthira ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 17.2" ; schema:url <https://sacred-texts.com/hin/m17/m17002.htm> ] .

:e_heaven a aoa:Story ;
    rdfs:label "Ascent to heaven" ;
    rdfs:comment "Yudhishthira finds Duryodhana in heaven and his brothers seemingly in hell, a final test of dharma (Svargarohana Parva)." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-core ;
    aoa:involves :duryodhana, :karna, :yudhishthira ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 18.3" ; schema:url <https://sacred-texts.com/hin/m18/m18003.htm> ] .

:endkali a aoa:Event, aoa:Catastrophe ;
    rdfs:label "End of the Kali Yuga" ;
    rdfs:comment "Markandeya foretells the end of the age: dharma fails, the rains stop, fire and flood sweep the world, and Kalki restores a new age of truth (Vana Parva)." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.189-190" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxix> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.189" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxix> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 12.2" ; schema:url <https://vedabase.io/en/library/sb/12/2/> ] .

:h_flood a aoa:Story, aoa:Catastrophe ;
    rdfs:label "Hastinapura washed away" ;
    rdfs:comment "The Ganga floods Hastinapura in Nichakshu's reign and the Kurus move to Kaushambi." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-purana ;
    aoa:leadsTo :h_buddha ;
    aoa:involves :janamejaya, :nichakshu, :shatanika ;
    dcterms:source [ a aoa:Citation ; rdfs:label "Vishnu P. 4.21" ; schema:url <https://sacred-texts.com/hin/vp/vp114.htm> ] .

:janamejaya a aoa:Person ;
    rdfs:label "Janamejaya" ;
    rdfs:comment "Son of Parikshit. Holds the snake sacrifice to avenge his father, and the epic is first recited there." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:parentOf :shatanika ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.20" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.44; MBh 1.50; MBh 1.60" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xliv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.50; MBh 1.58" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-l> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.50; MBh 1.52" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-l> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.60" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.95; MBh 1.44" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] .

:jara a aoa:Person ;
    rdfs:label "Jara" ;
    rdfs:comment "Hunter who mistakes Krishna, lying in yoga, for a deer and pierces his heel. Folk tradition makes him Vali reborn." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 16.4" ; schema:url <https://sacred-texts.com/hin/m16/m16004.htm> ] .

:kalki a aoa:Avatar ;
    rdfs:label "Kalki" ;
    rdfs:comment "Tenth avatar, foretold to come at the end of the Kali Yuga and restore the age of truth (Vana Parva). The Bhagavata mounts him on the horse Devadatta." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.189-190" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxix> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.189" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxxix> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 1.3, 12.2" ; schema:url <https://vedabase.io/en/library/sb/1/3/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 12.2, 1.3" ; schema:url <https://vedabase.io/en/library/sb/12/2/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 12.2" ; schema:url <https://vedabase.io/en/library/sb/12/2/> ] .

:kshemaka a aoa:Person ;
    rdfs:label "Kshemaka" ;
    rdfs:comment "Named in the Puranas as the last king of the Kuru line." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source [ a aoa:Citation ; rdfs:label "Vishnu P. 4.21" ; schema:url <https://sacred-texts.com/hin/vp/vp114.htm> ] .

:nichakshu a aoa:Person ;
    rdfs:label "Nichakshu" ;
    rdfs:comment "Later Kuru king. When the Ganga washes away Hastinapura, he moves the capital to Kaushambi." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source [ a aoa:Citation ; rdfs:label "Vishnu P. 4.21" ; schema:url <https://sacred-texts.com/hin/vp/vp114.htm> ] .

:ripunjaya a aoa:Person ;
    rdfs:label "Ripunjaya" ;
    rdfs:comment "Last king of Jarasandha's Brihadratha line in Magadha, overthrown by his own minister in the Puranic lists." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source [ a aoa:Citation ; rdfs:label "Vishnu P. 4.23-4.24" ; schema:url <https://sacred-texts.com/hin/vp/vp116.htm> ] .

:sarpasatra a aoa:Event, aoa:Catastrophe ;
    rdfs:label "Snake sacrifice" ;
    rdfs:comment "Janamejaya's rite draws the Nagas into the fire by the thousand until Astika stops it. The epic is first recited during its pauses." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.1; MBh 1.60" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-i> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.20" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.50; MBh 1.52" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-l> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.52; MBh 1.58; MBh 1.1" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.58" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lviii> ] .

:sauti a aoa:Sage ;
    rdfs:label "Sauti (Ugrashravas)" ;
    rdfs:comment "The bard who heard Vaishampayana and retells the epic to Shaunaka's sages in the Naimisha forest. The text opens here, Adi Parva 1.1." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.1" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-i> ] .

:shatanika a aoa:Person ;
    rdfs:label "Shatanika" ;
    rdfs:comment "Son of Janamejaya and father of Ashvamedhadatta, named in the Adi Parva." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] .

:shringi a aoa:Sage ;
    rdfs:label "Shringi" ;
    rdfs:comment "Son of the sage Shamika. Curses Parikshit to die by Takshaka's bite within seven days, after Parikshit drapes a dead snake on his father." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.40; MBh 1.41; MBh 1.42" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xl> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.41" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xli> ] .

:takshaka a aoa:Person, aoa:SpansYugas ;
    rdfs:label "Takshaka" ;
    rdfs:comment "Naga king, son of Kadru. Kills Parikshit. Hunted by Janamejaya's sacrifice, he is saved when Astika stops it." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-naga ;
    aoa:parentOf :ashvasena ;
    aoa:kills :parikshit ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.35; MBh 1.43; MBh 1.58" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.35; MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.43" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xliii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.50; MBh 1.58" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-l> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.58" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lviii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.229" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxix> ] .

:vaishampayana a aoa:Sage ;
    rdfs:label "Vaishampayana" ;
    rdfs:comment "Disciple of Vyasa. First reciter of the epic, at Janamejaya's snake sacrifice." ;
    aoa:period aoa:period-kali ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.1" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-i> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.1; MBh 1.60" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-i> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.60; MBh 1.1" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.60; MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.60" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lx> ] .

