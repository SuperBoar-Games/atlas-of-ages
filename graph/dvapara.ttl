:kuntibhoja a yc:Person ;
    rdfs:label "Kuntibhoja" ;
    rdfs:comment "King who adopts Pritha from his cousin Shura. She is called Kunti after him." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.67; MBh 1.111" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] .

:kuvalayapida a yc:Person ;
    rdfs:label "Kuvalayapida" ;
    rdfs:comment "Kamsa's war elephant, set on Krishna at the arena gate. Krishna kills it and takes its tusk." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.29" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485570.html> ] .

:lakshmanakumara a yc:Person ;
    rdfs:label "Lakshmana Kumara" ;
    rdfs:comment "Duryodhana's son. Killed by Abhimanyu on the thirteenth day." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 7.44" ; schema:url <https://sacred-texts.com/hin/m07/m07043.htm> ] .

:madri a yc:Person ;
    rdfs:label "Madri" ;
    rdfs:comment "Pandu's second wife. Uses Kunti's mantra to bear twins by the Ashvins, and joins Pandu on his pyre." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :twins ;
