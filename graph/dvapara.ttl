:chitrasena a yc:Person ;
    rdfs:label "Chitrasena" ;
    rdfs:comment "Gandharva king who taught Arjuna music in heaven. He captures Duryodhana on his cattle expedition, and the Pandavas have him freed, to Duryodhana's shame." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-gandharva ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 3.44, 3.238, 3.244-246" ; schema:url <https://www.sacred-texts.com/hin/m03/m03244.htm> ] ,
