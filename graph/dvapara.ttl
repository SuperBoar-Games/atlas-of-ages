        [ a aoa:Citation ; rdfs:label "MBh 7.186" ; schema:url <https://sacred-texts.com/hin/m07/m07183.htm> ] .

:vishnupurana a aoa:Event ;
    rdfs:label "Vishnu Purana" ;
    rdfs:comment "Purana that Parashara tells Maitreya. Its king lists carry the Kuru, Ikshvaku and Magadha lines into the Kali Yuga as prophecy. Scholars date it to c. 4th–5th century CE." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-purana ;
    dcterms:source [ a aoa:Citation ; rdfs:label "Vishnu P. 1.1" ; schema:url <https://sacred-texts.com/hin/vp/vp035.htm> ] .

:vishvarupa_d a aoa:Event ;
    rdfs:label "Cosmic form at court" ;
    rdfs:comment "When Duryodhana tries to seize Krishna during the peace mission, Krishna shows his universal form to the Kaurava court." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 5.131" ; schema:url <https://sacred-texts.com/hin/m05/m05131.htm> ] .

:vrishasena a aoa:Person ;
    rdfs:label "Vrishasena" ;
    rdfs:comment "Karna's son. Arjuna kills him in front of Karna, avenging Abhimanyu." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 8.85" ; schema:url <https://sacred-texts.com/hin/m08/m08085.htm> ] .

:vyasa a aoa:Sage, aoa:Chiranjivi ;
    rdfs:label "Vyasa" ;
    rdfs:comment "Krishna Dvaipayana, composer of the epic. By niyoga the biological father of Dhritarashtra, Pandu and Vidura." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    aoa:parentOf :shuka, :vidura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.60; MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.63; MBh 1.106" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
