        [ a aoa:Citation ; rdfs:label "Harivamsa 2.2" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485538.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.4" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485541.html> ] .

:dhaumya a aoa:Sage ;
    rdfs:label "Dhaumya" ;
    rdfs:comment "Priest of the Pandavas from their journey to Draupadi's svayamvara on, who goes with them into exile." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.185; 2.79" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.185" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxxxv> ] .

:dhenuka a aoa:Person ;
    rdfs:label "Dhenukasura" ;
    rdfs:comment "Donkey demon guarding a palm grove. Balarama hurls him into the trees." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.13" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485550.html> ] .

:dhrishtadyumna a aoa:Person ;
    rdfs:label "Dhrishtadyumna" ;
    rdfs:comment "Born from Drupada's sacrificial fire. Commands the Pandava army and kills Drona. Ashwatthama kills him in the night raid." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:kills :drona ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.169" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxix> ] ,
