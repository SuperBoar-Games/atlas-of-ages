        [ a yc:Citation ; rdfs:label "MBh 4.11" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 4.37" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 4.72" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-lxxii> ] .

:uttarakumara a yc:Person ;
    rdfs:label "Uttara Kumara" ;
    rdfs:comment "Virata's son. Arjuna, disguised as Brihannala, drives his chariot against the Kauravas. Killed by Shalya." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 4.35-38" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxxviii> ] ,
