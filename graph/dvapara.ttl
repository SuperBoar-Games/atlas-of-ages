# Dvapara Yuga

@prefix : <https://w3id.org/atlas-of-ages#> .
@prefix aoa: <https://w3id.org/atlas-of-ages#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

:abhimanyu a aoa:Person ;
    rdfs:label "Abhimanyu" ;
    rdfs:comment "Son of Arjuna and Subhadra. Breaks into the chakravyuha, kills Lakshmana Kumara, and is killed inside it by Dushasana's son." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:parentOf :parikshit ;
    aoa:kills :brihadbala, :lakshmanakumara ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.95; MBh 1.40" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.223" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 4.72" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-lxxii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 7.32; MBh 7.44; MBh 7.47; MBh 7.49" ; schema:url <https://sacred-texts.com/hin/m07/m07046.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 7.44" ; schema:url <https://sacred-texts.com/hin/m07/m07043.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 7.45" ; schema:url <https://sacred-texts.com/hin/m07/m07044.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 7.47; MBh 7.49" ; schema:url <https://sacred-texts.com/hin/m07/m07048.htm> ] .

:adhiratha a aoa:Person ;
    rdfs:label "Adhiratha & Radha" ;
    rdfs:comment "The charioteer and his wife who find Karna in a basket and raise him, so he is called Radheya." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.67; MBh 1.111" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.141" ; schema:url <https://sacred-texts.com/hin/m05/m05141.htm> ] .

:aghasura a aoa:Person ;
    rdfs:label "Aghasura" ;
    rdfs:comment "Python demon, brother of Putana and Baka, who swallows the cowherd boys. Krishna swells inside him until he bursts (Bhagavata)." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-asura .

:akrura a aoa:Person ;
    rdfs:label "Akrura" ;
    rdfs:comment "Yadava elder whom Kamsa sends to bring Krishna and Balarama to Mathura. Later keeps the Syamantaka gem." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.22" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485562.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.27" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485568.html> ] .

:akshayapatra a aoa:Event ;
    rdfs:label "Akshaya patra" ;
    rdfs:comment "Bowl given to Yudhishthira by Surya that feeds everyone each day until Draupadi has eaten. When Durvasa arrives after she has eaten, Krishna eats a last grain and the sage's hunger vanishes." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.3, 3.261" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cclxi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.3" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-iii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.261" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cclxi> ] .

:alambusha a aoa:Person ;
    rdfs:label "Alambusha" ;
    rdfs:comment "Name of two rakshasas fighting for the Kauravas: the son of Rishyashringa, who kills Iravan, and Jatasura's son, whom Ghatotkacha kills." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-rakshasa ;
    aoa:kills :iravan ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 6.91" ; schema:url <https://sacred-texts.com/hin/m06/m06091.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 6.91; MBh 7.108; MBh 7.174" ; schema:url <https://sacred-texts.com/hin/m07/m07105.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 7.108" ; schema:url <https://sacred-texts.com/hin/m07/m07105.htm> ] .

:amba a aoa:Person ;
    rdfs:label "Amba" ;
    rdfs:comment "Kashi princess abducted by Bhishma for Vichitravirya. Rejected by Shalva and everyone else, she vows Bhishma's death and is reborn as Shikhandi." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:rebornAs :shikhandi ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.102" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.175-176; MBh 5.189-190" ; schema:url <https://sacred-texts.com/hin/m05/m05176.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.175; MBh 5.176" ; schema:url <https://sacred-texts.com/hin/m05/m05176.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.175" ; schema:url <https://sacred-texts.com/hin/m05/m05175.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.190; MBh 5.191" ; schema:url <https://sacred-texts.com/hin/m05/m05190.htm> ] .

:ambika a aoa:Person ;
    rdfs:label "Ambika & Ambalika" ;
    rdfs:comment "Kashi princesses abducted by Bhishma, Vichitravirya's widows. By Vyasa, Ambika bears Dhritarashtra (she shut her eyes) and Ambalika bears Pandu (she turned pale)." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.102; MBh 1.106" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.102" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.106" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cvi> ] .

:aniruddha a aoa:Person ;
    rdfs:label "Aniruddha" ;
    rdfs:comment "Pradyumna's son. Bana imprisons him for loving his daughter Usha, and Krishna fights Bana to free him." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.104" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485645.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.122" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485663.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.131" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485672.html> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 10.62-10.63" ; schema:url <https://vedabase.io/en/library/sb/10/63/> ] .

:arishta a aoa:Person ;
    rdfs:label "Arishtasura" ;
    rdfs:comment "Bull demon who attacks the cowherds. Krishna breaks off its horn." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.21" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485561.html> ] .

:arjuna a aoa:Person ;
    rdfs:label "Arjuna" ;
    rdfs:comment "Son of Indra and Nara reborn. Wins Draupadi, hears the Gita, and kills Bhishma, Bhagadatta, Jayadratha and Karna." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:parentOf :abhimanyu, :babruvahana, :iravan ;
    aoa:kills :bhagadatta, :jayadratha, :karna, :susharma, :vrishasena ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.67; MBh 1.123" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
