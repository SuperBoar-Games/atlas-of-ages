        [ a yc:Citation ; rdfs:label "MBh 6.47" ; schema:url <https://sacred-texts.com/hin/m06/m06047.htm> ] .

:vasudeva a yc:Person ;
    rdfs:label "Vasudeva" ;
    rdfs:comment "Son of Shura. Father of Krishna, Balarama and Subhadra. Carries the newborn Krishna to Gokula; in the Bhagavata he crosses the Yamuna from Kamsa's prison." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:parentOf :balarama, :krishna, :subhadra ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.67; MBh 1.111" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.221" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxi> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 1.34" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485511.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 1.35" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485512.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 1.37" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485514.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.4" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485541.html> ] .

:vatsa a yc:Person ;
    rdfs:label "Vatsasura" ;
    rdfs:comment "Demon disguised as a calf. Krishna swings him against a tree (Bhagavata)." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-purana ;
    yc:being yc:being-asura .

:vichitravirya a yc:Person ;
    rdfs:label "Vichitravirya" ;
    rdfs:comment "Shantanu and Satyavati's younger son. Dies childless, so his widows bear sons by Vyasa, legally his." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.95; MBh 1.101" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.102; MBh 1.106" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.106" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cvi> ] .

:vidura a yc:Person ;
    rdfs:label "Vidura" ;
    rdfs:comment "Son of Vyasa and a maid. Yama reborn, cursed by the sage Mandavya. Warns the Pandavas about the house of lac." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.63; MBh 1.106" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.67; MBh 1.108" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.106; MBh 1.108; MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.147; 1.149" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxlvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.33" ; schema:url <https://sacred-texts.com/hin/m05/m05033.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 15.26" ; schema:url <https://sacred-texts.com/hin/m15/m15026.htm> ] .

:vikarna a yc:Person ;
    rdfs:label "Vikarna" ;
    rdfs:comment "The one Kaurava who protests Draupadi's treatment at the dice game. Bhima kills him in the war with regret." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.117" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-lxvii> ] .

:virata a yc:Person ;
    rdfs:label "Virata" ;
    rdfs:comment "King of Matsya. The Pandavas spend their year in disguise at his court. Killed by Drona." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :shveta, :uttara, :uttarakumara ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 4.9" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-ix> ] ,
        [ a yc:Citation ; rdfs:label "MBh 4.30-31" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxxi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 4.35" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 4.37" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 6.48" ; schema:url <https://sacred-texts.com/hin/m06/m06048.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.186" ; schema:url <https://sacred-texts.com/hin/m07/m07183.htm> ] .

:vishvarupa_d a yc:Event ;
    rdfs:label "Cosmic form at court" ;
    rdfs:comment "When Duryodhana tries to seize Krishna during the peace mission, Krishna shows his universal form to the Kaurava court." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 5.131" ; schema:url <https://sacred-texts.com/hin/m05/m05131.htm> ] .

:vrishasena a yc:Person ;
    rdfs:label "Vrishasena" ;
    rdfs:comment "Karna's son. Arjuna kills him in front of Karna, avenging Abhimanyu." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 8.85" ; schema:url <https://sacred-texts.com/hin/m08/m08085.htm> ] .

:vyasa a yc:Sage, yc:Chiranjivi ;
    rdfs:label "Vyasa" ;
    rdfs:comment "Krishna Dvaipayana, composer of the epic. By niyoga the biological father of Dhritarashtra, Pandu and Vidura." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    yc:parentOf :shuka, :vidura ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.60; MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lx> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.63; MBh 1.106" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.106" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cvi> ] ,
