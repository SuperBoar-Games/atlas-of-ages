:sudama a yc:Person ;
    rdfs:label "Sudama" ;
    rdfs:comment "Poor brahmin and Krishna's classmate. Visits Dvaraka with a gift of flattened rice and goes home rich (Bhagavata)." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-purana ;
    yc:being yc:being-human .

:sudeshna a yc:Person ;
    rdfs:label "Sudeshna" ;
    rdfs:comment "Virata's queen and Kichaka's sister. Draupadi serves her as the maid Sairandhri." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :uttara ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 4.9, 4.14" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-ix> ] ,
