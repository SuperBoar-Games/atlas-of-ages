:paundraka a yc:Person ;
    rdfs:label "Paundraka" ;
    rdfs:comment "King who dresses as Krishna and calls himself the true Vasudeva. Krishna kills him." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-purana ;
    yc:being yc:being-human ;
    yc:role yc:role-king .

:pradyumna a yc:Person ;
    rdfs:label "Pradyumna" ;
    rdfs:comment "Son of Krishna and Rukmini, Kama reborn in the Puranas. Dies in the Yadava brawl." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:parentOf :aniruddha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 16.3" ; schema:url <https://sacred-texts.com/hin/m16/m16003.htm> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.104" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485645.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.105" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485646.html> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 10.55" ; schema:url <https://vedabase.io/en/library/sb/10/55/> ] .

:pralamba a yc:Person ;
    rdfs:label "Pralambasura" ;
    rdfs:comment "Demon who joins the boys' games and carries off Balarama, who crushes him with his fist." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-asura ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.14" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485551.html> ] .

:pratipa a yc:Person ;
    rdfs:label "Pratipa" ;
    rdfs:comment "Kuru king, father of Shantanu and Bahlika." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :bahlika, :shantanu ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.94; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] .

:purochana a yc:Person ;
    rdfs:label "Purochana" ;
    rdfs:comment "Duryodhana's minister, who builds the house of lac and is to set it alight. Bhima burns it first, with Purochana inside." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.146; 1.150" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxlvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.146" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxlvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.150" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cl> ] .

:putana a yc:Person ;
    rdfs:label "Putana" ;
    rdfs:comment "Kamsa's nurse, who comes to Gokula as a bird-like demoness and suckles the infant Krishna, who sucks out her life. The Bhagavata adds the poisoned milk." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.6" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485543.html> ] .

:radha a yc:Person ;
    rdfs:label "Radha" ;
    rdfs:comment "Gopi of Vrindavan and Krishna's beloved in later devotion (Brahmavaivarta Purana, Gita Govinda). Not named in the Mahabharata or the Bhagavata." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-purana ;
    yc:being yc:being-human ;
    yc:role yc:role-woman .

:rohini a yc:Person ;
    rdfs:label "Rohini" ;
    rdfs:comment "Vasudeva's other wife, sheltered in Gokula. Balarama is transferred to her womb from Devaki's." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 1.35" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485512.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.4" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485541.html> ] .

:rukmi a yc:Person ;
    rdfs:label "Rukmi" ;
    rdfs:comment "Rukmini's brother, who fights Krishna when he carries her off. Balarama kills him after a quarrel over dice." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.60" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485601.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.62" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485603.html> ] .

:rukmini a yc:Person ;
    rdfs:label "Rukmini" ;
    rdfs:comment "Princess of Vidarbha betrothed to Shishupala. Krishna carries her off and marries her." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :pradyumna ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.60" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485601.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.61" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485602.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.104" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485645.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.105" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485646.html> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 10.55" ; schema:url <https://vedabase.io/en/library/sb/10/55/> ] ,
        [ a yc:Citation ; rdfs:label "Vishnu P. 1.9" ; schema:url <https://sacred-texts.com/hin/vp/vp044.htm> ] .

:sahadevam a yc:Person ;
    rdfs:label "Sahadeva of Magadha" ;
    rdfs:comment "Jarasandha's son, put on the throne of Magadha by Krishna after his father's death. Fights for the Pandavas." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 2.14; 2.24" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xxiv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.24" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xxiv> ] .

:samba a yc:Person ;
    rdfs:label "Samba" ;
    rdfs:comment "Son of Krishna and Jambavati. He dresses as a woman longing for a son to mock visiting sages, and they curse him to bring forth an iron club. That club destroys the Yadavas." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 16.1" ; schema:url <https://sacred-texts.com/hin/m16/m16001.htm> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.104" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485645.html> ] .

:sandipani a yc:Sage ;
    rdfs:label "Sandipani" ;
    rdfs:comment "Krishna and Balarama's teacher at Avanti. As his fee, Krishna brings back his drowned son from Yama's realm." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.33" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485574.html> ] .

:sanjaya a yc:Person ;
    rdfs:label "Sanjaya" ;
    rdfs:comment "Dhritarashtra's charioteer. Given divine sight by Vyasa, he describes the war to the blind king, the Gita included." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 6.2; MBh 6.25" ; schema:url <https://sacred-texts.com/hin/m06/m06002.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 6.2" ; schema:url <https://sacred-texts.com/hin/m06/m06002.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 15.37" ; schema:url <https://sacred-texts.com/hin/m15/m15037.htm> ] .

:satrajit a yc:Person ;
    rdfs:label "Satrajit" ;
    rdfs:comment "Yadava noble given the Syamantaka gem by Surya. When it goes missing the Vrishnis suspect Krishna, who recovers it from Jambavan, returns it, and marries Satrajit's daughter Satyabhama." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-human ;
    yc:parentOf :satyabhama ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 1.38" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485515.html> ] .

:satyabhama a yc:Person ;
    rdfs:label "Satyabhama" ;
    rdfs:comment "Krishna's wife, daughter of Satrajit of the Syamantaka gem. In the Puranas she fights Narakasura beside Krishna." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 1.38" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485515.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.76" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485617.html> ] .

:satyaki a yc:Person ;
    rdfs:label "Satyaki" ;
    rdfs:comment "Yadava warrior and Arjuna's student. Fights for the Pandavas, kills Bhurishravas, and dies in the Yadava brawl after killing Kritavarma." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:kills :kritavarma ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 7.142" ; schema:url <https://sacred-texts.com/hin/m07/m07139.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.143" ; schema:url <https://sacred-texts.com/hin/m07/m07140.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 16.3" ; schema:url <https://sacred-texts.com/hin/m16/m16003.htm> ] .

:satyavati a yc:Person ;
    rdfs:label "Satyavati" ;
    rdfs:comment "Fisherman's daughter. Mother of Vyasa by Parashara, and of Chitrangada and Vichitravirya by Shantanu." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :chitrangada, :vichitravirya, :vyasa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.63; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.95; MBh 1.101" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.100" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-c> ] .

:shakata a yc:Person ;
    rdfs:label "Shakatasura" ;
    rdfs:comment "A cart the infant Krishna kicks over (Harivamsa). The Bhagavata makes it a demon hidden in the cart." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-asura ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.6" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485543.html> ] .

:shakuni a yc:Person ;
    rdfs:label "Shakuni" ;
    rdfs:comment "Gandhari's brother and Duryodhana's adviser. Plays the dice game for him. Killed by Sahadeva." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:parentOf :uluka ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.110" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cx> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.59-64" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-lxiv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.161" ; schema:url <https://sacred-texts.com/hin/m05/m05161.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 9.28" ; schema:url <https://sacred-texts.com/hin/m09/m09028.htm> ] .

:shalva a yc:Person ;
    rdfs:label "Shalva" ;
    rdfs:comment "King of Saubha whom Amba loves. He rejects her after Bhishma takes her. Later attacks Dvaraka in a flying city and is killed by Krishna." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.102" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.175; MBh 5.176" ; schema:url <https://sacred-texts.com/hin/m05/m05176.htm> ] .

:shalya a yc:Person ;
    rdfs:label "Shalya" ;
    rdfs:comment "King of Madra and Madri's brother. Tricked into fighting for Duryodhana, he drives Karna's chariot and kills Uttara Kumara. Killed by Yudhishthira." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:kills :uttarakumara ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.113" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxiii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.8; MBh 6.47" ; schema:url <https://sacred-texts.com/hin/m05/m05008.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 6.47" ; schema:url <https://sacred-texts.com/hin/m06/m06047.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 8.34" ; schema:url <https://sacred-texts.com/hin/m08/m08034.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 9.17" ; schema:url <https://sacred-texts.com/hin/m09/m09017.htm> ] .

:shantanu a yc:Person ;
    rdfs:label "Shantanu" ;
    rdfs:comment "King of Hastinapura and Mahabhisha reborn. Marries Ganga, then Satyavati." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :bhishma, :chitrangada, :vichitravirya ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.94; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.95; MBh 1.101" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.96; MBh 1.97; MBh 1.98; MBh 1.100" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.96; MBh 1.97" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.98; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.98" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.100" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-c> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.130" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxx> ] .

:shikhandi a yc:Person ;
    rdfs:label "Shikhandi" ;
    rdfs:comment "Amba reborn as Drupada's child. Bhishma will not fight Shikhandi, so Arjuna shoots from behind Shikhandi. Ashwatthama cuts Shikhandi down in the night raid." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 5.190; MBh 5.191" ; schema:url <https://sacred-texts.com/hin/m05/m05190.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.190; MBh 5.193" ; schema:url <https://sacred-texts.com/hin/m05/m05193.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.190; MBh 6.119; MBh 6.120" ; schema:url <https://sacred-texts.com/hin/m06/m06119.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.195" ; schema:url <https://sacred-texts.com/hin/m05/m05195.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 6.119" ; schema:url <https://sacred-texts.com/hin/m06/m06119.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 10.8" ; schema:url <https://sacred-texts.com/hin/m10/m10008.htm> ] .

:shini a yc:Person ;
    rdfs:label "Shini" ;
    rdfs:comment "Yadava warrior who wins Devaki for Vasudeva at her svayamvara and humiliates Somadatta in the fight. Satyaki's grandfather." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 7.143" ; schema:url <https://sacred-texts.com/hin/m07/m07140.htm> ] .

:shishupala a yc:Person ;
    rdfs:label "Shishupala" ;
    rdfs:comment "King of Chedi and Krishna's cousin. Krishna promised to forgive him a hundred insults and kills him at the Rajasuya. Jaya's third birth in the Bhagavata." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.42; 2.44" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xlii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.42" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xlii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.44" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xliv> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.60" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485601.html> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 7.1" ; schema:url <https://vedabase.io/en/library/sb/7/1/> ] .

:shrutashrava a yc:Person ;
    rdfs:label "Shrutashrava" ;
    rdfs:comment "Vasudeva's sister and Shishupala's mother. Krishna promises her he will forgive her son a hundred insults." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :shishupala ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 2.42; 2.44" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xlii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.42" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xlii> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 1.34" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485511.html> ] .

:shuka a yc:Sage ;
    rdfs:label "Shuka" ;
    rdfs:comment "Vyasa's son. Tells the Bhagavata Purana to the dying Parikshit." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] .

:shura a yc:Person ;
    rdfs:label "Shura" ;
    rdfs:comment "Yadava chief. Father of Vasudeva, and of Pritha, whom he gives in adoption to his cousin Kuntibhoja." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:parentOf :kunti, :shrutashrava, :vasudeva ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.67; MBh 1.111" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 1.34" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485511.html> ] .

:shveta a yc:Person ;
    rdfs:label "Shveta" ;
    rdfs:comment "Virata's son, killed by Bhishma on the first day." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 6.48; MBh 6.49" ; schema:url <https://sacred-texts.com/hin/m06/m06048.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 6.48" ; schema:url <https://sacred-texts.com/hin/m06/m06048.htm> ] .

:somadatta a yc:Person ;
    rdfs:label "Somadatta" ;
    rdfs:comment "Bahlika's son and Bhurishravas's father. His feud with Shini's line ends with Satyaki killing Bhurishravas." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :bhurishravas ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 7.143" ; schema:url <https://sacred-texts.com/hin/m07/m07140.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.143; MBh 7.156" ; schema:url <https://sacred-texts.com/hin/m07/m07140.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.156" ; schema:url <https://sacred-texts.com/hin/m07/m07153.htm> ] .

:sthunakarna a yc:Person ;
    rdfs:label "Sthunakarna" ;
    rdfs:comment "Yaksha who trades sexes with Shikhandi, so Shikhandi lives as a man." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-yaksha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 5.194; MBh 5.195" ; schema:url <https://sacred-texts.com/hin/m05/m05195.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.195" ; schema:url <https://sacred-texts.com/hin/m05/m05195.htm> ] .

:subhadra a yc:Person ;
    rdfs:label "Subhadra" ;
    rdfs:comment "Sister of Krishna and Balarama. On Krishna's advice Arjuna carries her off, and she becomes Abhimanyu's mother." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :abhimanyu ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.221; 1.223" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxi> ] ,
