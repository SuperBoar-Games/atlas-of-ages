        [ a aoa:Citation ; rdfs:label "Bhagavata 10.62" ; schema:url <https://vedabase.io/en/library/sb/10/62/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 10.63" ; schema:url <https://vedabase.io/en/library/sb/10/63/> ] .

:barbarika a aoa:Person ;
    rdfs:label "Barbarika" ;
    rdfs:comment "Ghatotkacha's son. Krishna asks for his head before the war. Worshipped today as Khatu Shyam." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-folk ;
    aoa:being aoa:being-human .

:bhagadatta a aoa:Person ;
    rdfs:label "Bhagadatta" ;
    rdfs:comment "King of Pragjyotisha who fights from a great elephant for Duryodhana. His Vaishnava weapon came from Naraka. Arjuna kills him." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 7.17; MBh 7.27; MBh 7.28" ; schema:url <https://sacred-texts.com/hin/m07/m07027.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 7.27; MBh 7.28" ; schema:url <https://sacred-texts.com/hin/m07/m07027.htm> ] .

:bhanumati a aoa:Person ;
    rdfs:label "Bhanumati" ;
    rdfs:comment "Duryodhana's wife, mother of Lakshmana Kumara and Lakshmana." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :lakshmanakumara .

:bhima a aoa:Person ;
    rdfs:label "Bhima" ;
    rdfs:comment "Son of Vayu, so Hanuman's half-brother. Kills Hidimba, Baka, Jarasandha, Kichaka, Dushasana, Bahlika and Duryodhana." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:parentOf :ghatotkacha ;
    aoa:kills :bahlika, :baka, :hidimba, :jarasandha, :jatasura, :kichaka, :kirmira, :vikarna ;
    dcterms:source
