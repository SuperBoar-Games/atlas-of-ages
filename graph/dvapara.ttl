:yajurveda a aoa:Event ;
    rdfs:label "Yajurveda" ;
    rdfs:comment "The Veda of sacrificial formulas, which Vyasa gives to Vaishampayana. Yajnavalkya later sees its White recension. Scholars date it to c. 1200–800 BCE." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-purana ;
    dcterms:source [ a aoa:Citation ; rdfs:label "Vishnu P. 3.4-3.5" ; schema:url <https://sacred-texts.com/hin/vp/vp078.htm> ] .

:yaksha a aoa:Event ;
    rdfs:label "Yaksha's questions" ;
    rdfs:comment "At a lake a yaksha kills four Pandavas who drink without answering him. Yudhishthira answers his riddles and wins them back. The yaksha is Yama, his father." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.311-312" ; schema:url <https://www.sacred-texts.com/hin/m03/m03311.htm> ] ,
