:chitrangadam a yc:Person ;
    rdfs:label "Chitrangada of Manipur" ;
    rdfs:comment "Princess of Manipur and Arjuna's wife. Mother of Babruvahana." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :babruvahana ;
