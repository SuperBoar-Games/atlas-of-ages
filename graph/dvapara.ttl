        [ a aoa:Citation ; rdfs:label "MBh 3.312" ; schema:url <https://www.sacred-texts.com/hin/m03/m03312.htm> ] .

:yogamaya a aoa:Deva ;
    rdfs:label "Yogamaya" ;
    rdfs:comment "The goddess born to Yashoda the night Krishna is born. Vasudeva swaps her for Krishna. When Kamsa tries to dash her on a stone she rises up and warns him his killer lives." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-layer ;
