:keshi a aoa:Person ;
    rdfs:label "Keshi" ;
    rdfs:comment "Horse demon. Krishna seizes its mouth and tears it in two, hence the name Keshava; the Bhagavata has him thrust his arm down its throat." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.24" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485565.html> ] .

:kichaka a aoa:Person ;
    rdfs:label "Kichaka" ;
    rdfs:comment "Virata's commander and Sudeshna's brother. Harasses Draupadi and is killed by Bhima." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 4.14, 4.22" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xiv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 4.14" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xiv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 4.22" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxii> ] .

:kindama a aoa:Sage ;
    rdfs:label "Kindama" ;
    rdfs:comment "Sage who mates with his wife in the form of deer. Pandu shoots him, and Kindama curses Pandu to die if he approaches a woman." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.118" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxviii> ] .

:kirmira a aoa:Person ;
    rdfs:label "Kirmira" ;
    rdfs:comment "Rakshasa, brother of Baka, who blocks the Pandavas' way into the Kamyaka forest. Bhima kills him." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-rakshasa ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.11" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-xi> ] .

:kripa a aoa:Person, aoa:Chiranjivi ;
    rdfs:label "Kripa" ;
    rdfs:comment "Kuru teacher, Gautama's grandson. A chiranjivi who survives the war and joins the night raid." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.130" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 10.8" ; schema:url <https://sacred-texts.com/hin/m10/m10008.htm> ] .

:kripi a aoa:Person ;
    rdfs:label "Kripi" ;
    rdfs:comment "Kripa's twin sister, Drona's wife, mother of Ashwatthama." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :ashwatthama ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.130-131" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.130" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.131" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxxi> ] .

:krishna a aoa:Avatar ;
    rdfs:label "Krishna" ;
    rdfs:comment "Eighth avatar of Vishnu and Narayana reborn. Cousin of the Pandavas through Kunti, friend and charioteer of Arjuna. His death opens the Kali Yuga." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    aoa:parentOf :pradyumna, :samba ;
    aoa:kills :aghasura, :arishta, :bakac, :kuvalayapida, :narakasura, :shakata, :shalva, :shishupala, :trinavarta, :vatsa ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Uttara 7.70" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424844.html> ] ,
