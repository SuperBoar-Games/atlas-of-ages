:kripi a yc:Person ;
    rdfs:label "Kripi" ;
    rdfs:comment "Kripa's twin sister, Drona's wife, mother of Ashwatthama." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :ashwatthama ;
