        [ a aoa:Citation ; rdfs:label "MBh 7.143" ; schema:url <https://sacred-texts.com/hin/m07/m07140.htm> ] .

:brahmastra a aoa:Event, aoa:Catastrophe ;
    rdfs:label "Brahmastras unleashed" ;
    rdfs:comment "Ashwatthama and Arjuna fire the ultimate weapon at each other. Vyasa and Narada step between them. Arjuna withdraws his, and Ashwatthama turns his on the Pandava wombs (Sauptika Parva)." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 10.13" ; schema:url <https://sacred-texts.com/hin/m10/m10013.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 10.14" ; schema:url <https://sacred-texts.com/hin/m10/m10014.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 10.15" ; schema:url <https://sacred-texts.com/hin/m10/m10015.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 10.16" ; schema:url <https://sacred-texts.com/hin/m10/m10016.htm> ] .

:brihadbala a aoa:Person ;
    rdfs:label "Brihadbala" ;
    rdfs:comment "Ikshvaku king of Kosala, descended from Rama's son Kusha. Fights for the Kauravas and is killed by Abhimanyu." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 7.45" ; schema:url <https://sacred-texts.com/hin/m07/m07044.htm> ] .

:brihadratha a aoa:Person ;
    rdfs:label "Brihadratha" ;
    rdfs:comment "King of Magadha who gets Jarasandha from a sage's mango, eaten by his two queens. Each bears half a child." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:parentOf :jarasandha ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 2.17" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xvii> ] .

:chanura a aoa:Person ;
    rdfs:label "Chanura & Mushtika" ;
    rdfs:comment "Kamsa's wrestlers. Krishna kills Chanura and Balarama kills Mushtika, just before Krishna kills Kamsa." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.30" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485571.html> ] .

:chitrangada a aoa:Person ;
    rdfs:label "Chitrangada" ;
    rdfs:comment "Shantanu and Satyavati's elder son. Killed young by a gandharva of the same name." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.95; MBh 1.101" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.101" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ci> ] .

:chitrangadam a aoa:Person ;
    rdfs:label "Chitrangada of Manipur" ;
    rdfs:comment "Princess of Manipur and Arjuna's wife. Mother of Babruvahana." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :babruvahana ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.217; 1.219" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.217" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxvii> ] .

:chitrasena a aoa:Person ;
    rdfs:label "Chitrasena" ;
    rdfs:comment "Gandharva king who taught Arjuna music in heaven. He captures Duryodhana on his cattle expedition, and the Pandavas have him freed, to Duryodhana's shame." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-gandharva ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.44, 3.238, 3.244-246" ; schema:url <https://www.sacred-texts.com/hin/m03/m03244.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.44, 3.244-246" ; schema:url <https://www.sacred-texts.com/hin/m03/m03246.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.238, 3.244" ; schema:url <https://www.sacred-texts.com/hin/m03/m03244.htm> ] .

:dantavakra a aoa:Person ;
    rdfs:label "Dantavakra" ;
    rdfs:comment "King of Karusha, Shishupala's ally. Vijaya's third birth, killed by Krishna (Bhagavata)." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bhagavata 7.1" ; schema:url <https://vedabase.io/en/library/sb/7/1/> ] .

:daushasani a aoa:Person ;
    rdfs:label "Dushasana's son" ;
    rdfs:comment "Dushasana's son. After six warriors strip Abhimanyu of chariot and weapons, he fells him with a mace blow as he rises." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:kills :abhimanyu ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 7.47; MBh 7.49" ; schema:url <https://sacred-texts.com/hin/m07/m07046.htm> ] .

:devaki a aoa:Person ;
    rdfs:label "Devaki" ;
    rdfs:comment "Kamsa's cousin and Vasudeva's wife. Mother of Krishna. Her seventh child, Balarama, is moved to Rohini's womb." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :krishna ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 7.143" ; schema:url <https://sacred-texts.com/hin/m07/m07140.htm> ] ,
