:bhishma a aoa:Person ;
    rdfs:label "Bhishma" ;
    rdfs:comment "Devavrata, the Vasu Dyaus reborn. Vows lifelong celibacy so Shantanu can marry Satyavati, and can choose the hour of his death. Teaches Yudhishthira from his bed of arrows." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:kills :shveta ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.67; MBh 1.99" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
