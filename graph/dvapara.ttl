        [ a yc:Citation ; rdfs:label "MBh 1.131" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxxi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.131-132; 1.140" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxxii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.133-134" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxxiii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.134" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxxiv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.186" ; schema:url <https://sacred-texts.com/hin/m07/m07183.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.186; MBh 7.191; MBh 7.193" ; schema:url <https://sacred-texts.com/hin/m07/m07189.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.191; MBh 7.193" ; schema:url <https://sacred-texts.com/hin/m07/m07189.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.193" ; schema:url <https://sacred-texts.com/hin/m07/m07189.htm> ] .

:drupada a yc:Person ;
    rdfs:label "Drupada" ;
    rdfs:comment "King of Panchala and Drona's childhood friend. Insults Drona, is captured by Arjuna, and holds a sacrifice for children who will avenge him." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :dhrishtadyumna, :draupadi, :shikhandi ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.131-132; 1.140; 1.169" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxl> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.131-132; 1.140" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxxii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.169" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxix> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.190; MBh 5.193" ; schema:url <https://sacred-texts.com/hin/m05/m05193.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.186" ; schema:url <https://sacred-texts.com/hin/m07/m07183.htm> ] .

:duhshala a yc:Person ;
    rdfs:label "Duhshala" ;
    rdfs:comment "The only Kaurava daughter, married to Jayadratha." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.116; MBh 1.117" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.117" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxvii> ] .

:durvasa a yc:Sage, yc:SpansYugas ;
    rdfs:label "Durvasa" ;
    rdfs:comment "Short-tempered sage. Pleased by Kunti's service, he gives her the mantra that calls any god." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.111; MBh 1.122" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.111" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.261" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cclxi> ] .

:duryodhana a yc:Person ;
    rdfs:label "Duryodhana" ;
    rdfs:comment "Eldest of the hundred Kauravas. Poisons Bhima as a boy, is humiliated in the Maya Sabha, and takes the kingdom through the dice game." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :lakshmanakumara ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.115; MBh 1.117" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.128; 2.46; 2.59-64" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.128" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.138" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxxviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.146" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxlvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.59-64" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-lxiv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.238, 3.244" ; schema:url <https://www.sacred-texts.com/hin/m03/m03244.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.131" ; schema:url <https://sacred-texts.com/hin/m05/m05131.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.44" ; schema:url <https://sacred-texts.com/hin/m07/m07043.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 9.34" ; schema:url <https://sacred-texts.com/hin/m09/m09034.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 9.58" ; schema:url <https://sacred-texts.com/hin/m09/m09058.htm> ] .

:dushasana a yc:Person ;
    rdfs:label "Dushasana" ;
    rdfs:comment "Drags Draupadi into the assembly and tries to disrobe her. Bhima kills him and drinks his blood." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:parentOf :daushasani ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.117" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.66-67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 8.83" ; schema:url <https://sacred-texts.com/hin/m08/m08083.htm> ] .

:e_dice a yc:Story ;
    rdfs:label "Game of dice" ;
    rdfs:comment "Shakuni wins everything from Yudhishthira. Dushasana drags Draupadi into the hall; only Vikarna protests." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_forest ;
    yc:involves :bhishma, :dhritarashtra, :draupadi, :duryodhana, :dushasana, :karna, :shakuni, :vidura, :vikarna, :yudhishthira ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 2.60-67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-lxvii> ] .

:e_ekachakra a yc:Story ;
    rdfs:label "Ekachakra" ;
    rdfs:comment "In hiding as brahmins, the Pandavas live in Ekachakra, where Bhima kills Bakasura." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_svayam ;
    yc:involves :baka, :bhima, :kunti, :vyasa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.158-165" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clix> ] .

:e_fee a yc:Story ;
    rdfs:label "Drona's fee" ;
    rdfs:comment "The students capture Drupada for Drona, who takes half his kingdom. Ekalavya has already paid with his thumb." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_lac ;
    yc:involves :arjuna, :drona, :drupada, :ekalavya ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.134; 1.140" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxl> ] .

:e_forest a yc:Story ;
    rdfs:label "Twelve years in the forest" ;
    rdfs:comment "Arjuna fights Shiva as a hunter, Bhima meets Hanuman, Nahusha is freed, Jayadratha tries to take Draupadi, and Yudhishthira answers the Yaksha." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_virata ;
    yc:involves :akshayapatra, :arjuna, :bhima, :chitrasena, :dhaumya, :draupadi, :hanuman, :indra, :jatasura, :jayadratha, :kirmira, :markandeya, :nahusha, :nalak, :nivatakavachas, :savitri, :shiva, :urvashi, :yaksha, :yama, :yudhishthira ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 3.39-40, 3.146-150, 3.178-180, 3.267, 3.311-312" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-xxxix> ] .

:e_gita a yc:Story ;
    rdfs:label "Bhagavad Gita" ;
    rdfs:comment "Krishna's teaching to Arjuna before the battle, relayed to Dhritarashtra by Sanjaya." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_war ;
    yc:involves :arjuna, :dhritarashtra, :krishna, :sanjaya ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 6.25" ; schema:url <https://sacred-texts.com/hin/m06/m06025.htm> ] .

:e_khandava a yc:Story, yc:Catastrophe ;
    rdfs:label "Khandava & Indraprastha" ;
    rdfs:comment "Krishna and Arjuna burn the Khandava forest for Agni. Mayasura, spared, builds the Maya Sabha." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_rajasuya ;
    yc:involves :agni, :arjuna, :ashvasena, :indra, :krishna, :mayasura, :takshaka ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.225-230; 2.1" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxx> ] .

:e_lac a yc:Story ;
    rdfs:label "House of lac" ;
    rdfs:comment "Duryodhana builds a flammable house for the Pandavas at Varanavata. Warned by Vidura, they escape through a tunnel. Bhima kills Hidimba and marries Hidimbi." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_ekachakra ;
    yc:involves :bhima, :duryodhana, :hidimba, :hidimbi, :kunti, :purochana, :vidura ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.146-150; 1.154-157" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cl> ] .

:e_lament a yc:Story ;
    rdfs:label "Lament and curses" ;
    rdfs:comment "Kunti reveals Karna was her son. Gandhari curses Krishna's clan. Bhishma teaches Yudhishthira from his bed of arrows. Later comes the Ashvamedha, where Babruvahana fells Arjuna." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_mausala ;
    yc:involves :babruvahana, :bhishma, :dhritarashtra, :gandhari, :karna, :krishna, :kunti, :ulupi, :yudhishthira ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 11.27" ; schema:url <https://sacred-texts.com/hin/m11/m11026.htm> ] .

:e_mausala a yc:Story, yc:Catastrophe ;
    rdfs:label "Destruction of the Yadavas" ;
    rdfs:comment "Samba's iron club and Gandhari's curse come true. The Yadavas kill each other at Prabhasa, and Jara's arrow ends Krishna's life (Mausala Parva)." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_final ;
    yc:involves :aniruddha, :balarama, :gandhari, :jara, :krishna, :kritavarma, :pradyumna, :samba, :satyaki ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 16.3" ; schema:url <https://sacred-texts.com/hin/m16/m16003.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 16.7" ; schema:url <https://sacred-texts.com/hin/m16/m16007.htm> ] .

:e_peace a yc:Story ;
    rdfs:label "Krishna's peace mission" ;
    rdfs:comment "Krishna asks Hastinapura for five villages and is refused. He tells Karna of his birth, and Kunti meets Karna." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_gita ;
    yc:involves :duryodhana, :gandhari, :karna, :krishna, :kunti, :uluka, :vidura, :vishvarupa_d ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 5.150; MBh 5.140; MBh 5.145" ; schema:url <https://sacred-texts.com/hin/m05/m05150.htm> ] .

:e_poison a yc:Story ;
    rdfs:label "Bhima poisoned" ;
    rdfs:comment "Duryodhana poisons Bhima and throws him in the Ganga. The Nagas revive him with a drink that gives him great strength." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_tourney ;
    yc:involves :bhima, :duryodhana, :vasuki ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.128" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxviii> ] .

:e_raid a yc:Story, yc:Catastrophe ;
    rdfs:label "Night raid" ;
    rdfs:comment "Ashwatthama, Kripa and Kritavarma attack the sleeping Pandava camp (Sauptika Parva)." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_lament ;
    yc:involves :ashwatthama, :dhrishtadyumna, :kripa, :kritavarma, :parikshit, :shikhandi, :upapandavas ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 10.8" ; schema:url <https://sacred-texts.com/hin/m10/m10008.htm> ] .

:e_rajasuya a yc:Story ;
    rdfs:label "Rajasuya" ;
    rdfs:comment "Yudhishthira's imperial sacrifice. Bhima kills Jarasandha first, and Krishna kills Shishupala at the ceremony." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_dice ;
    yc:involves :bhima, :jarasandha, :krishna, :shishupala, :yudhishthira ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 2.24; 2.44" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xliv> ] .

:e_svayam a yc:Story ;
    rdfs:label "Draupadi's svayamvara" ;
    rdfs:comment "Arjuna, disguised as a brahmin, hits the target and wins Draupadi. Karna is turned away." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_khandava ;
    yc:involves :arjuna, :dhrishtadyumna, :draupadi, :drupada, :karna, :krishna ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.189-190" ; schema:url <https://www.sacred-texts.com/hin/m01/m01191.htm> ] .

:e_tourney a yc:Story ;
    rdfs:label "The tournament" ;
    rdfs:comment "Drona's students show their skill. Karna matches Arjuna, is mocked for his birth, and Duryodhana makes him king of Anga." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_fee ;
    yc:involves :arjuna, :drona, :duryodhana, :karna, :kripa, :kunti ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.137-139" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxxviii> ] .

:e_virata a yc:Story ;
    rdfs:label "Year in disguise" ;
    rdfs:comment "The Pandavas hide at Virata's court. Bhima kills Kichaka and Arjuna defends Matsya with Uttara Kumara." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_peace ;
    yc:involves :arjuna, :bhima, :draupadi, :kichaka, :sudeshna, :susharma, :uttara, :uttarakumara, :virata ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 4.22, 4.38" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxii> ] .

:e_war a yc:Story, yc:Catastrophe ;
    rdfs:label "Kurukshetra war" ;
    rdfs:comment "Eighteen days of battle. Bhishma, Drona, Karna, Shalya and Duryodhana fall in turn." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:leadsTo :e_raid ;
    yc:involves :abhimanyu, :alambusha, :ashvasena, :ashwathamahata, :ashwatthama, :bahlika, :barbarika, :bhagadatta, :bhishma, :bhurishravas, :brihadbala, :daushasani, :dhrishtadyumna, :drona, :drupada, :duryodhana, :ghatotkacha, :iravan, :jayadratha, :karna, :kripa, :kritavarma, :lakshmanakumara, :sahadevam, :satyaki, :shalya, :shikhandi, :shveta, :susharma, :uttarakumara, :virata, :vrishasena, :yuyutsu .

:ekalavya a yc:Person ;
    rdfs:label "Ekalavya" ;
    rdfs:comment "Nishada prince who teaches himself archery before a clay image of Drona. Drona demands his right thumb as fee." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.134" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxxiv> ] .

:forestfire a yc:Event, yc:Catastrophe ;
    rdfs:label "Forest fire" ;
    rdfs:comment "Fifteen years after the war Dhritarashtra, Gandhari and Kunti retire to the forest and die in a forest fire. Sanjaya escapes (Ashramavasika Parva)." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 15.37" ; schema:url <https://sacred-texts.com/hin/m15/m15037.htm> ] .

:gandhari a yc:Person ;
    rdfs:label "Gandhari" ;
    rdfs:comment "Princess of Gandhara who blindfolds herself for life. Mother of the hundred. After the war she curses Krishna that his clan will destroy itself." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :duryodhana, :dushasana, :vikarna ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.110" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cx> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.115; MBh 1.117" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.117" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 11.25" ; schema:url <https://sacred-texts.com/hin/m11/m11024.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 15.37" ; schema:url <https://sacred-texts.com/hin/m15/m15037.htm> ] .

:ganga a yc:Deva ;
    rdfs:label "Ganga" ;
    rdfs:comment "River goddess. Agrees to bear the cursed Vasus and drowns seven of them at birth to free them. The eighth, Devavrata, lives." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-god ;
    yc:role yc:role-woman ;
    yc:parentOf :bhishma ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.96; MBh 1.98" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.96" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.98" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.108-109" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cix> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.109" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cix> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 8.21" ; schema:url <https://vedabase.io/en/library/sb/8/21/> ] .

:ghatotkacha a yc:Person ;
    rdfs:label "Ghatotkacha" ;
    rdfs:comment "Bhima's son by Hidimbi. Kills Alambusha. Karna spends Indra's one-time spear to kill him, which saves Arjuna." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    yc:kills :alambusha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.157" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.108; MBh 7.179" ; schema:url <https://sacred-texts.com/hin/m07/m07176.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.108" ; schema:url <https://sacred-texts.com/hin/m07/m07105.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.179" ; schema:url <https://sacred-texts.com/hin/m07/m07176.htm> ] .

:hidimba a yc:Person ;
    rdfs:label "Hidimba" ;
    rdfs:comment "Rakshasa who sends his sister Hidimbi to kill the Pandavas. Bhima kills him." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.154; 1.156" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cliv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.154; 1.157" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.156" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clvi> ] .

:hidimbi a yc:Person ;
    rdfs:label "Hidimbi" ;
    rdfs:comment "Rakshasi who marries Bhima after he kills her brother Hidimba." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    yc:role yc:role-woman ;
    yc:parentOf :ghatotkacha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.154; 1.157" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.156-157" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.157" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clvii> ] .

:iravan a yc:Person ;
    rdfs:label "Iravan" ;
    rdfs:comment "Arjuna's son by Ulupi. Killed by the rakshasa Alambusha on the eighth day." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 6.91" ; schema:url <https://sacred-texts.com/hin/m06/m06091.htm> ] .

:jaimini a yc:Sage ;
    rdfs:label "Jaimini" ;
    rdfs:comment "Vyasa's disciple, given the Samaveda. Founder of the Mimamsa school." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 12.6" ; schema:url <https://vedabase.io/en/library/sb/12/6/> ] .

:jambavati a yc:Person ;
    rdfs:label "Jambavati" ;
    rdfs:comment "Jambavan's daughter, married to Krishna after the Syamantaka fight. Mother of Samba." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-riksha ;
    yc:role yc:role-woman ;
    yc:parentOf :samba ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 1.38" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485515.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.104" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485645.html> ] .

:jarar a yc:Person ;
    rdfs:label "Jara (rakshasi)" ;
    rdfs:comment "Rakshasi who finds the two halves of a baby thrown away and joins them, giving Jarasandha his life and his name. Bhima kills him by tearing him apart again." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 2.17-18; 2.24" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.17-18" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xvii> ] .

:jarasandha a yc:Person ;
    rdfs:label "Jarasandha" ;
    rdfs:comment "Emperor of Magadha and Kamsa's father-in-law. Attacks Mathura again and again. Bhima kills him in a wrestling match before the Rajasuya." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :sahadevam ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 2.14; 2.17-18; 2.24" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xxiv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.14" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xiv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.14; 2.24" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xxiv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.17" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.17-18" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.24" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xxiv> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.34" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485575.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.57" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485598.html> ] .

:jatasura a yc:Person ;
    rdfs:label "Jatasura" ;
    rdfs:comment "Rakshasa disguised as a brahmin who carries off Yudhishthira, the twins and Draupadi. Bhima kills him." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 3.156" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clvi> ] .

:jayadratha a yc:Person ;
    rdfs:label "Jayadratha" ;
    rdfs:comment "King of Sindhu. Tries to abduct Draupadi in the forest and holds the line while Abhimanyu dies. Killed by Arjuna." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.117" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.267, 3.271" ; schema:url <https://www.sacred-texts.com/hin/m03/m03267.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.267" ; schema:url <https://www.sacred-texts.com/hin/m03/m03267.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.41; MBh 7.145" ; schema:url <https://sacred-texts.com/hin/m07/m07142.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.145" ; schema:url <https://sacred-texts.com/hin/m07/m07142.htm> ] .

:k_akrura a yc:Story ;
    rdfs:label "Akrura's summons" ;
    rdfs:comment "Kamsa sends Keshi and Arishta, then Akrura, to bring the brothers to Mathura. Krishna leaves Vrindavan for good." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:leadsTo :k_kamsa ;
    yc:involves :akrura, :arishta, :balarama, :kamsa, :keshi, :krishna, :radha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.22" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485562.html> ] .

:k_birth a yc:Story ;
    rdfs:label "Birth in prison" ;
    rdfs:comment "Krishna is born to Devaki, and Vasudeva carries him to Yashoda's house in Gokula, bringing back her newborn daughter (Harivamsa). The Bhagavata adds the prison, the sleeping guards and the Yamuna crossing." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:leadsTo :k_gokula ;
    yc:involves :devaki, :kamsa, :krishna, :nandayashoda, :vasudeva, :yogamaya ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.4" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485541.html> ] .

:k_dvaraka a yc:Story ;
    rdfs:label "Sieges and Dvaraka" ;
    rdfs:comment "Jarasandha attacks Mathura again and again, joined by Kalayavana. Krishna moves the Yadavas to Dvaraka, built on land the sea gives up." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:leadsTo :k_rukmini ;
    yc:involves :balarama, :jarasandha, :kalayavana, :krishna, :muchukunda, :uddhava ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.57" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485598.html> ] .

:k_gokula a yc:Story ;
    rdfs:label "Gokula" ;
    rdfs:comment "The infant Krishna kills Putana, kicks apart Shakatasura and strangles Trinavarta. Yashoda ties him to a mortar for stealing butter." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:leadsTo :k_vraja ;
    yc:involves :balarama, :krishna, :nandayashoda, :putana, :rohini, :shakata, :trinavarta ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.6" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485543.html> ] .

:k_govardhana a yc:Story, yc:Catastrophe ;
    rdfs:label "Govardhana lifted" ;
    rdfs:comment "Krishna turns the cowherds from Indra's worship to the hill. Indra sends seven days of rain, and Krishna holds up Govardhana as a shelter." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:leadsTo :k_rasa ;
    yc:involves :indra, :krishna, :nandayashoda ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.18" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485557.html> ] .

:k_kaliya a yc:Story ;
    rdfs:label "Kaliya subdued" ;
    rdfs:comment "Krishna jumps into the poisoned pool, dances on Kaliya's heads, and sends the Naga back to the sea." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:leadsTo :k_govardhana ;
    yc:involves :garuda, :kaliya, :krishna ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.12" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485549.html> ] .

:k_kamsa a yc:Story ;
    rdfs:label "Kamsa slain" ;
    rdfs:comment "At the Mathura arena Krishna kills Kuvalayapida, Chanura and Kamsa, frees his parents and restores Ugrasena." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:leadsTo :k_school ;
    yc:involves :balarama, :chanura, :devaki, :kamsa, :krishna, :kuvalayapida, :ugrasena, :vasudeva ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.30" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485571.html> ] .

:k_rasa a yc:Story ;
    rdfs:label "Rasa lila" ;
    rdfs:comment "The autumn night dance with the gopis on the banks of the Yamuna." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:leadsTo :k_akrura ;
    yc:involves :krishna, :radha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.20" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485560.html> ] .

:k_rukmini a yc:Story ;
    rdfs:label "Rukmini's abduction" ;
    rdfs:comment "Krishna carries off Rukmini on the eve of her wedding to Shishupala and defeats Rukmi." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:leadsTo :k_syamantaka ;
    yc:involves :balarama, :krishna, :rukmi, :rukmini, :shishupala ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.60" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485601.html> ] .

:k_school a yc:Story ;
    rdfs:label "Sandipani's school" ;
    rdfs:comment "Krishna and Balarama study at Avanti with Sudama, and Krishna brings back his teacher's son from the dead." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:leadsTo :k_dvaraka ;
    yc:involves :balarama, :krishna, :sandipani, :sudama, :yama ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.33" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485574.html> ] .

:k_syamantaka a yc:Story ;
    rdfs:label "Syamantaka gem" ;
    rdfs:comment "Satrajit's gem goes missing and Krishna is blamed. He tracks it to Jambavan's cave, wins it in a long fight, and marries Jambavati and Satyabhama." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:involves :akrura, :jambavan, :jambavati, :krishna, :satrajit, :satyabhama ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 1.38" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485515.html> ] .

:k_vraja a yc:Story ;
    rdfs:label "Vrindavan demons" ;
    rdfs:comment "The family moves to Vrindavan. Krishna and Balarama kill Vatsa, Baka, Agha, Dhenuka and Pralamba while herding cows." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:leadsTo :k_kaliya ;
    yc:involves :aghasura, :bakac, :balarama, :brahma, :dhenuka, :krishna, :pralamba, :vatsa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.9" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485546.html> ] .

:kalayavana a yc:Person ;
    rdfs:label "Kalayavana" ;
    rdfs:comment "Foreign king who besieges Mathura with Jarasandha. Krishna leads him into Muchukunda's cave, and Muchukunda's waking glance burns him." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.57" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485598.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.58" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485599.html> ] .

:kaliya a yc:Person, yc:SpansYugas ;
    rdfs:label "Kaliya" ;
    rdfs:comment "Many-headed Naga, a son of Kadru, poisoning the Yamuna after fleeing Garuda. Krishna dances on his heads and sends him back to the sea." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-naga ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.35" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xxxv> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.11" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485548.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.12" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485549.html> ] .

:kamsa a yc:Person ;
    rdfs:label "Kamsa" ;
    rdfs:comment "Keeps Devaki under guard after a prophecy that her eighth child will kill him, and kills six of her sons. The Bhagavata makes it a prison. Killed by Krishna." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 2.14" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xiv> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 1.37" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485514.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.1" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485537.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.2" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485538.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.4" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485541.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.22" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485562.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.34" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485575.html> ] .

:karna a yc:Person ;
    rdfs:label "Karna" ;
    rdfs:comment "Kunti's son by Surya, born with armour and earrings and set adrift. Raised by a charioteer, made king of Anga by Duryodhana, and Arjuna's rival." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :vrishasena ;
    yc:kills :ghatotkacha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.67; MBh 1.111" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.111" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.138-139" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxxviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.138" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxxviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.308" ; schema:url <https://www.sacred-texts.com/hin/m03/m03308.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.140; MBh 5.145" ; schema:url <https://sacred-texts.com/hin/m05/m05145.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.141; MBh 5.145" ; schema:url <https://sacred-texts.com/hin/m05/m05145.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.141" ; schema:url <https://sacred-texts.com/hin/m05/m05141.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.179" ; schema:url <https://sacred-texts.com/hin/m07/m07176.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 8.85" ; schema:url <https://sacred-texts.com/hin/m08/m08085.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 8.90" ; schema:url <https://sacred-texts.com/hin/m08/m08090.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 8.91" ; schema:url <https://sacred-texts.com/hin/m08/m08091.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 11.27" ; schema:url <https://sacred-texts.com/hin/m11/m11026.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 12.3" ; schema:url <https://sacred-texts.com/hin/m12/m12a003.htm> ] .

:keshi a yc:Person ;
    rdfs:label "Keshi" ;
    rdfs:comment "Horse demon. Krishna seizes its mouth and tears it in two, hence the name Keshava; the Bhagavata has him thrust his arm down its throat." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-asura ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.24" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485565.html> ] .

:kichaka a yc:Person ;
    rdfs:label "Kichaka" ;
    rdfs:comment "Virata's commander and Sudeshna's brother. Harasses Draupadi and is killed by Bhima." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 4.14, 4.22" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xiv> ] ,
