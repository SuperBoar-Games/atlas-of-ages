:drona a yc:Person ;
    rdfs:label "Drona" ;
    rdfs:comment "Son of Bharadvaja and teacher of both Kauravas and Pandavas. Gets his weapons from Parashurama. Kills Drupada and Virata, and is killed by Dhrishtadyumna after the \"Ashwatthama is dead\" ruse." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:parentOf :ashwatthama ;
    yc:kills :drupada, :virata ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
