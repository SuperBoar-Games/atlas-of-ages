:bhurishravas a aoa:Person ;
    rdfs:label "Bhurishravas" ;
    rdfs:comment "Bahlika's grandson. Fighting Satyaki, he loses his arm to Arjuna's arrow, and Satyaki beheads him as he sits in meditation." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 7.142; MBh 7.143; MBh 7.156" ; schema:url <https://sacred-texts.com/hin/m07/m07139.htm> ] ,
