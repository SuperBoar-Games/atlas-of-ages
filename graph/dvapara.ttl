:kritavarma a aoa:Person ;
    rdfs:label "Kritavarma" ;
    rdfs:comment "Yadava warrior who fights for Duryodhana and joins the night raid. Satyaki kills him in the Yadava brawl." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 16.3" ; schema:url <https://sacred-texts.com/hin/m16/m16003.htm> ] .

:kunti a aoa:Person ;
    rdfs:label "Kunti" ;
    rdfs:comment "Pritha, Vasudeva's sister. Uses Durvasa's mantra to bear Karna by Surya, then three sons for Pandu." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :arjuna, :bhima, :karna, :yudhishthira ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.67; MBh 1.111" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.111; MBh 1.122; MBh 1.123" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.111" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.112" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.123" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.140; MBh 5.145" ; schema:url <https://sacred-texts.com/hin/m05/m05145.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 11.27" ; schema:url <https://sacred-texts.com/hin/m11/m11026.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 15.37" ; schema:url <https://sacred-texts.com/hin/m15/m15037.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.34" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485511.html> ] .

:kuntibhoja a aoa:Person ;
    rdfs:label "Kuntibhoja" ;
    rdfs:comment "King who adopts Pritha from his cousin Shura. She is called Kunti after him." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.67; MBh 1.111" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] .

:kuvalayapida a aoa:Person ;
    rdfs:label "Kuvalayapida" ;
    rdfs:comment "Kamsa's war elephant, set on Krishna at the arena gate. Krishna kills it and takes its tusk." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.29" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485570.html> ] .

:lakshmanakumara a aoa:Person ;
    rdfs:label "Lakshmana Kumara" ;
    rdfs:comment "Duryodhana's son. Killed by Abhimanyu on the thirteenth day." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 7.44" ; schema:url <https://sacred-texts.com/hin/m07/m07043.htm> ] .

:madri a aoa:Person ;
    rdfs:label "Madri" ;
    rdfs:comment "Pandu's second wife. Uses Kunti's mantra to bear twins by the Ashvins, and joins Pandu on his pyre." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :twins ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.113" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.124; MBh 1.125" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxiv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.124" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxiv> ] .

:nandayashoda a aoa:Person ;
    rdfs:label "Nanda & Yashoda" ;
    rdfs:comment "Cowherd chief of Gokula and his wife, who raise Krishna." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.5" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485542.html> ] .

:narakasura a aoa:Person ;
    rdfs:label "Narakasura" ;
    rdfs:comment "Asura king of Pragjyotisha. Krishna kills him and frees 16,100 captive women (16,000 in the Bhagavata). The Puranas make him the son of Varaha and Bhudevi." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.64" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485605.html> ] ,
        [ a aoa:Citation ; rdfs:label "Vishnu P. 5.29; Bhagavata 10.59" ; schema:url <https://sacred-texts.com/hin/vp/vp146.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Vishnu P. 5.29" ; schema:url <https://sacred-texts.com/hin/vp/vp146.htm> ] .

:neminatha a aoa:Sage ;
    rdfs:label "Neminatha" ;
    rdfs:comment "Twenty-second Jain tirthankara. Jain tradition makes him Krishna's cousin, who renounces the world on his wedding day." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-folk ;
    aoa:being aoa:being-sage .

:nivatakavachas a aoa:Person ;
    rdfs:label "Nivatakavachas" ;
    rdfs:comment "Ocean-dwelling demons whom Arjuna destroys for Indra as his fee for the divine weapons, along with the city of Hiranyapura." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.167-172" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.167-169" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxvii> ] .

:paila a aoa:Sage ;
    rdfs:label "Paila" ;
    rdfs:comment "Vyasa's disciple, given the Rigveda to preserve." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 12.6" ; schema:url <https://vedabase.io/en/library/sb/12/6/> ] .

:panchajana a aoa:Person ;
    rdfs:label "Panchajana" ;
    rdfs:comment "Sea demon who has swallowed Sandipani's son. Krishna kills him and takes his shell as the conch Panchajanya." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.33" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485574.html> ] .

:pandu a aoa:Person ;
    rdfs:label "Pandu" ;
    rdfs:comment "Son of Vyasa and Ambalika. After Kindama's curse he cannot father children, and he dies when he embraces Madri." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.106; MBh 1.118; MBh 1.125" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.106" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.112" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.113" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.118" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxviii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.122; MBh 1.123" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.123" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.124" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxiv> ] .

:parashara a aoa:Sage ;
    rdfs:label "Parashara" ;
    rdfs:comment "Grandson of Vashishtha. Fathers Vyasa with Satyavati on a river island." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    aoa:parentOf :vyasa ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.63; MBh 1.180" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.179; MBh 1.180" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxxix> ] .

:parikshit a aoa:Person ;
    rdfs:label "Parikshit" ;
    rdfs:comment "Son of Abhimanyu and Uttara. Ashwatthama's weapon kills him in the womb and Krishna revives him. Rules as Kali begins and dies by Takshaka's bite." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:parentOf :janamejaya ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.40; MBh 1.41; MBh 1.43; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xl> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.41" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xli> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.43" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xliii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.95; MBh 1.40" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.95; MBh 1.44" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 10.16" ; schema:url <https://sacred-texts.com/hin/m10/m10016.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 14.69" ; schema:url <https://sacred-texts.com/hin/m14/m14069.htm> ] .

:paundraka a aoa:Person ;
    rdfs:label "Paundraka" ;
    rdfs:comment "King who dresses as Krishna and calls himself the true Vasudeva. Krishna kills him." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king .

:pradyumna a aoa:Person ;
    rdfs:label "Pradyumna" ;
    rdfs:comment "Son of Krishna and Rukmini, Kama reborn in the Puranas. Dies in the Yadava brawl." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:parentOf :aniruddha ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 16.3" ; schema:url <https://sacred-texts.com/hin/m16/m16003.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.104" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485645.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.105" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485646.html> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 10.55" ; schema:url <https://vedabase.io/en/library/sb/10/55/> ] .

:pralamba a aoa:Person ;
    rdfs:label "Pralambasura" ;
    rdfs:comment "Demon who joins the boys' games and carries off Balarama, who crushes him with his fist." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.14" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485551.html> ] .

:pratipa a aoa:Person ;
    rdfs:label "Pratipa" ;
    rdfs:comment "Kuru king, father of Shantanu and Bahlika." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:parentOf :bahlika, :shantanu ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.94; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] .

:purochana a aoa:Person ;
    rdfs:label "Purochana" ;
    rdfs:comment "Duryodhana's minister, who builds the house of lac and is to set it alight. Bhima burns it first, with Purochana inside." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.146; 1.150" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxlvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.146" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxlvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.150" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cl> ] .

:putana a aoa:Person ;
    rdfs:label "Putana" ;
    rdfs:comment "Kamsa's nurse, who comes to Gokula as a bird-like demoness and suckles the infant Krishna, who sucks out her life. The Bhagavata adds the poisoned milk." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-rakshasa ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.6" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485543.html> ] .

:radha a aoa:Person ;
    rdfs:label "Radha" ;
    rdfs:comment "Gopi of Vrindavan and Krishna's beloved in later devotion (Brahmavaivarta Purana, Gita Govinda). Not named in the Mahabharata or the Bhagavata." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman .

:rigveda a aoa:Event ;
    rdfs:label "Rigveda" ;
    rdfs:comment "The first Veda, of hymns, which Vyasa gives to Paila. Its hymns, which scholars date to c. 1500–1200 BCE, already name Pururavas and Urvashi, Nahusha, Yayati, Mandhata, Ikshvaku, the Yadu and Puru tribes and the Bharatas." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-purana ;
    dcterms:source [ a aoa:Citation ; rdfs:label "Vishnu P. 3.4" ; schema:url <https://sacred-texts.com/hin/vp/vp078.htm> ] .

:rohini a aoa:Person ;
    rdfs:label "Rohini" ;
    rdfs:comment "Vasudeva's other wife, sheltered in Gokula. Balarama is transferred to her womb from Devaki's." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.35" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485512.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.4" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485541.html> ] .

:rukmi a aoa:Person ;
    rdfs:label "Rukmi" ;
    rdfs:comment "Rukmini's brother, who fights Krishna when he carries her off. Balarama kills him after a quarrel over dice." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.60" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485601.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.62" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485603.html> ] .

:rukmini a aoa:Person ;
    rdfs:label "Rukmini" ;
    rdfs:comment "Princess of Vidarbha betrothed to Shishupala. Krishna carries her off and marries her." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :pradyumna ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.60" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485601.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.61" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485602.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.104" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485645.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.105" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485646.html> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 10.55" ; schema:url <https://vedabase.io/en/library/sb/10/55/> ] ,
        [ a aoa:Citation ; rdfs:label "Vishnu P. 1.9" ; schema:url <https://sacred-texts.com/hin/vp/vp044.htm> ] .

:sahadevam a aoa:Person ;
    rdfs:label "Sahadeva of Magadha" ;
    rdfs:comment "Jarasandha's son, put on the throne of Magadha by Krishna after his father's death. Fights for the Pandavas." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 2.14; 2.24" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xxiv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 2.24" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xxiv> ] .

:samaveda a aoa:Event ;
    rdfs:label "Samaveda" ;
    rdfs:comment "The Veda of chants, mostly Rigvedic verses set to melody for the soma rite, which Vyasa gives to Jaimini. Scholars date it to c. 1200–1000 BCE." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-purana ;
    dcterms:source [ a aoa:Citation ; rdfs:label "Vishnu P. 3.4" ; schema:url <https://sacred-texts.com/hin/vp/vp078.htm> ] .

:samba a aoa:Person ;
    rdfs:label "Samba" ;
    rdfs:comment "Son of Krishna and Jambavati. He dresses as a woman longing for a son to mock visiting sages, and they curse him to bring forth an iron club. That club destroys the Yadavas." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 16.1" ; schema:url <https://sacred-texts.com/hin/m16/m16001.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.104" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485645.html> ] .

:sandipani a aoa:Sage ;
    rdfs:label "Sandipani" ;
    rdfs:comment "Krishna and Balarama's teacher at Avanti. As his fee, Krishna brings back his drowned son from Yama's realm." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.33" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485574.html> ] .

:sanjaya a aoa:Person ;
    rdfs:label "Sanjaya" ;
    rdfs:comment "Dhritarashtra's charioteer. Given divine sight by Vyasa, he describes the war to the blind king, the Gita included." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 6.2; MBh 6.25" ; schema:url <https://sacred-texts.com/hin/m06/m06002.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 6.2" ; schema:url <https://sacred-texts.com/hin/m06/m06002.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 15.37" ; schema:url <https://sacred-texts.com/hin/m15/m15037.htm> ] .

:satrajit a aoa:Person ;
    rdfs:label "Satrajit" ;
    rdfs:comment "Yadava noble given the Syamantaka gem by Surya. When it goes missing the Vrishnis suspect Krishna, who recovers it from Jambavan, returns it, and marries Satrajit's daughter Satyabhama." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-human ;
    aoa:parentOf :satyabhama ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.38" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485515.html> ] .

:satyabhama a aoa:Person ;
    rdfs:label "Satyabhama" ;
    rdfs:comment "Krishna's wife, daughter of Satrajit of the Syamantaka gem. In the Puranas she fights Narakasura beside Krishna." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.38" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485515.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.76" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485617.html> ] .

:satyaki a aoa:Person ;
    rdfs:label "Satyaki" ;
    rdfs:comment "Yadava warrior and Arjuna's student. Fights for the Pandavas, kills Bhurishravas, and dies in the Yadava brawl after killing Kritavarma." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:kills :kritavarma ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 7.142" ; schema:url <https://sacred-texts.com/hin/m07/m07139.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 7.143" ; schema:url <https://sacred-texts.com/hin/m07/m07140.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 16.3" ; schema:url <https://sacred-texts.com/hin/m16/m16003.htm> ] .

:satyavati a aoa:Person ;
    rdfs:label "Satyavati" ;
    rdfs:comment "Fisherman's daughter. Mother of Vyasa by Parashara, and of Chitrangada and Vichitravirya by Shantanu." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :chitrangada, :vichitravirya, :vyasa ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.63; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.95; MBh 1.101" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.100" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-c> ] .

:shakata a aoa:Person ;
    rdfs:label "Shakatasura" ;
    rdfs:comment "A cart the infant Krishna kicks over (Harivamsa). The Bhagavata makes it a demon hidden in the cart." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.6" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485543.html> ] .

:shakuni a aoa:Person ;
    rdfs:label "Shakuni" ;
    rdfs:comment "Gandhari's brother and Duryodhana's adviser. Plays the dice game for him. Killed by Sahadeva." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:parentOf :uluka ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.110" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 2.59-64" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-lxiv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.161" ; schema:url <https://sacred-texts.com/hin/m05/m05161.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 9.28" ; schema:url <https://sacred-texts.com/hin/m09/m09028.htm> ] .

:shalva a aoa:Person ;
    rdfs:label "Shalva" ;
    rdfs:comment "King of Saubha whom Amba loves. He rejects her after Bhishma takes her. Later attacks Dvaraka in a flying city and is killed by Krishna." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.102" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.175; MBh 5.176" ; schema:url <https://sacred-texts.com/hin/m05/m05176.htm> ] .

:shalya a aoa:Person ;
    rdfs:label "Shalya" ;
    rdfs:comment "King of Madra and Madri's brother. Tricked into fighting for Duryodhana, he drives Karna's chariot and kills Uttara Kumara. Killed by Yudhishthira." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:kills :uttarakumara ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.113" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.8; MBh 6.47" ; schema:url <https://sacred-texts.com/hin/m05/m05008.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 6.47" ; schema:url <https://sacred-texts.com/hin/m06/m06047.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 8.34" ; schema:url <https://sacred-texts.com/hin/m08/m08034.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 9.17" ; schema:url <https://sacred-texts.com/hin/m09/m09017.htm> ] .

:shantanu a aoa:Person ;
    rdfs:label "Shantanu" ;
    rdfs:comment "King of Hastinapura and Mahabhisha reborn. Marries Ganga, then Satyavati." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:parentOf :bhishma, :chitrangada, :vichitravirya ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.94; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.95; MBh 1.101" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.96; MBh 1.97; MBh 1.98; MBh 1.100" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.96; MBh 1.97" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.98; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcviii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.98" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcviii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.100" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-c> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.130" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxx> ] .

:shikhandi a aoa:Person ;
    rdfs:label "Shikhandi" ;
    rdfs:comment "Amba reborn as Drupada's child. Bhishma will not fight Shikhandi, so Arjuna shoots from behind Shikhandi. Ashwatthama cuts Shikhandi down in the night raid." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 5.190; MBh 5.191" ; schema:url <https://sacred-texts.com/hin/m05/m05190.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.190; MBh 5.193" ; schema:url <https://sacred-texts.com/hin/m05/m05193.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.190; MBh 6.119; MBh 6.120" ; schema:url <https://sacred-texts.com/hin/m06/m06119.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.195" ; schema:url <https://sacred-texts.com/hin/m05/m05195.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 6.119" ; schema:url <https://sacred-texts.com/hin/m06/m06119.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 10.8" ; schema:url <https://sacred-texts.com/hin/m10/m10008.htm> ] .

:shini a aoa:Person ;
    rdfs:label "Shini" ;
    rdfs:comment "Yadava warrior who wins Devaki for Vasudeva at her svayamvara and humiliates Somadatta in the fight. Satyaki's grandfather." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 7.143" ; schema:url <https://sacred-texts.com/hin/m07/m07140.htm> ] .

:shishupala a aoa:Person ;
    rdfs:label "Shishupala" ;
    rdfs:comment "King of Chedi and Krishna's cousin. Krishna promised to forgive him a hundred insults and kills him at the Rajasuya. Jaya's third birth in the Bhagavata." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 2.42; 2.44" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xlii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 2.42" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xlii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 2.44" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xliv> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.60" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485601.html> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 7.1" ; schema:url <https://vedabase.io/en/library/sb/7/1/> ] .

:shrutashrava a aoa:Person ;
    rdfs:label "Shrutashrava" ;
    rdfs:comment "Vasudeva's sister and Shishupala's mother. Krishna promises her he will forgive her son a hundred insults." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :shishupala ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 2.42; 2.44" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xlii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 2.42" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xlii> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.34" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485511.html> ] .

:shuka a aoa:Sage ;
    rdfs:label "Shuka" ;
    rdfs:comment "Vyasa's son. Tells the Bhagavata Purana to the dying Parikshit." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] .

:shura a aoa:Person ;
    rdfs:label "Shura" ;
    rdfs:comment "Yadava chief. Father of Vasudeva, and of Pritha, whom he gives in adoption to his cousin Kuntibhoja." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:parentOf :kunti, :shrutashrava, :vasudeva ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.67; MBh 1.111" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.34" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485511.html> ] .

:shveta a aoa:Person ;
    rdfs:label "Shveta" ;
    rdfs:comment "Virata's son, killed by Bhishma on the first day." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 6.48; MBh 6.49" ; schema:url <https://sacred-texts.com/hin/m06/m06048.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 6.48" ; schema:url <https://sacred-texts.com/hin/m06/m06048.htm> ] .

:somadatta a aoa:Person ;
    rdfs:label "Somadatta" ;
    rdfs:comment "Bahlika's son and Bhurishravas's father. His feud with Shini's line ends with Satyaki killing Bhurishravas." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:parentOf :bhurishravas ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 7.143" ; schema:url <https://sacred-texts.com/hin/m07/m07140.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 7.143; MBh 7.156" ; schema:url <https://sacred-texts.com/hin/m07/m07140.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 7.156" ; schema:url <https://sacred-texts.com/hin/m07/m07153.htm> ] .

:sthunakarna a aoa:Person ;
    rdfs:label "Sthunakarna" ;
    rdfs:comment "Yaksha who trades sexes with Shikhandi, so Shikhandi lives as a man." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-yaksha ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 5.194; MBh 5.195" ; schema:url <https://sacred-texts.com/hin/m05/m05195.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.195" ; schema:url <https://sacred-texts.com/hin/m05/m05195.htm> ] .

:subhadra a aoa:Person ;
    rdfs:label "Subhadra" ;
    rdfs:comment "Sister of Krishna and Balarama. On Krishna's advice Arjuna carries her off, and she becomes Abhimanyu's mother." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :abhimanyu ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.221; 1.223" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.221" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.221-223" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.223" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxiii> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.35" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485512.html> ] .

:sudama a aoa:Person ;
    rdfs:label "Sudama" ;
    rdfs:comment "Poor brahmin and Krishna's classmate. Visits Dvaraka with a gift of flattened rice and goes home rich (Bhagavata)." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human .

:sudeshna a aoa:Person ;
    rdfs:label "Sudeshna" ;
    rdfs:comment "Virata's queen and Kichaka's sister. Draupadi serves her as the maid Sairandhri." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :uttara ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 4.9, 4.14" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-ix> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 4.9" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-ix> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 4.14" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xiv> ] .

:sumantu a aoa:Sage ;
    rdfs:label "Sumantu" ;
    rdfs:comment "Vyasa's disciple, given the Atharvaveda." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 12.6" ; schema:url <https://vedabase.io/en/library/sb/12/6/> ] .

:susharma a aoa:Person ;
    rdfs:label "Susharma" ;
    rdfs:comment "King of Trigarta, who raids Matsya's cattle and leads the Samshaptakas, sworn to kill Arjuna. Arjuna kills him." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 4.30-33" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 4.30-31" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxxi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 7.17" ; schema:url <https://sacred-texts.com/hin/m07/m07017.htm> ] .

:trinavarta a aoa:Person ;
    rdfs:label "Trinavarta" ;
    rdfs:comment "Whirlwind demon who carries off the infant Krishna and is strangled by him (Bhagavata)." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-asura .

:twins a aoa:Person ;
    rdfs:label "Nakula & Sahadeva" ;
    rdfs:comment "Madri's twin sons by the Ashvins. Sahadeva kills Shakuni." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.67; MBh 1.124" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.124" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxiv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 9.28" ; schema:url <https://sacred-texts.com/hin/m09/m09028.htm> ] .

:uddhava a aoa:Person ;
    rdfs:label "Uddhava" ;
    rdfs:comment "Krishna's cousin and closest counsellor. Carries his message to the gopis and hears the Uddhava Gita before the end." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-human .

:ugrasena a aoa:Person ;
    rdfs:label "Ugrasena" ;
    rdfs:comment "Yadava king of Mathura, deposed by his son Kamsa and restored by Krishna." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:parentOf :kamsa ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.37" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485514.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.32" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485573.html> ] .

:uluka a aoa:Person ;
    rdfs:label "Uluka" ;
    rdfs:comment "Shakuni's son and Duryodhana's insulting envoy to the Pandavas before the war. Sahadeva kills him." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 5.161; MBh 5.162" ; schema:url <https://sacred-texts.com/hin/m05/m05161.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.161" ; schema:url <https://sacred-texts.com/hin/m05/m05161.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 9.28" ; schema:url <https://sacred-texts.com/hin/m09/m09028.htm> ] .

:ulupi a aoa:Person ;
    rdfs:label "Ulupi" ;
    rdfs:comment "Naga princess who marries Arjuna. Revives him after Babruvahana kills him." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-naga ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :iravan ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.216" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 6.91" ; schema:url <https://sacred-texts.com/hin/m06/m06091.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 14.80" ; schema:url <https://sacred-texts.com/hin/m14/m14080.htm> ] .

:upapandavas a aoa:Person ;
    rdfs:label "Upapandavas" ;
    rdfs:comment "Draupadi's five sons, one by each Pandava. Ashwatthama kills them in the night raid." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.223" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 10.8" ; schema:url <https://sacred-texts.com/hin/m10/m10008.htm> ] .

:uparichara a aoa:Person ;
    rdfs:label "Uparichara Vasu" ;
    rdfs:comment "King of Chedi whose seed, carried off by a hawk, is swallowed by the cursed apsara Adrika living as a fish. Satyavati is born from her." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] .

:uttara a aoa:Person ;
    rdfs:label "Uttara" ;
    rdfs:comment "Virata's daughter and Arjuna's dance pupil. Marries Abhimanyu and is Parikshit's mother." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :parikshit ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 4.11, 4.72" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-lxxii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 4.11" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 4.37" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 4.72" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-lxxii> ] .

:uttarakumara a aoa:Person ;
    rdfs:label "Uttara Kumara" ;
    rdfs:comment "Virata's son. Arjuna, disguised as Brihannala, drives his chariot against the Kauravas. Killed by Shalya." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 4.35-38" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxxviii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 4.35" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 4.36-38" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxxviii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 6.47" ; schema:url <https://sacred-texts.com/hin/m06/m06047.htm> ] .

:vasudeva a aoa:Person ;
    rdfs:label "Vasudeva" ;
    rdfs:comment "Son of Shura. Father of Krishna, Balarama and Subhadra. Carries the newborn Krishna to Gokula; in the Bhagavata he crosses the Yamuna from Kamsa's prison." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:parentOf :balarama, :krishna, :subhadra ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.67; MBh 1.111" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.221" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxi> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.34" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485511.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.35" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485512.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.37" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485514.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 2.4" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485541.html> ] .

:vatsa a aoa:Person ;
    rdfs:label "Vatsasura" ;
    rdfs:comment "Demon disguised as a calf. Krishna swings him against a tree (Bhagavata)." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-purana ;
    aoa:being aoa:being-asura .

:vichitravirya a aoa:Person ;
    rdfs:label "Vichitravirya" ;
    rdfs:comment "Shantanu and Satyavati's younger son. Dies childless, so his widows bear sons by Vyasa, legally his." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.95; MBh 1.101" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.102; MBh 1.106" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.106" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cvi> ] .

:vidura a aoa:Person ;
    rdfs:label "Vidura" ;
    rdfs:comment "Son of Vyasa and a maid. Yama reborn, cursed by the sage Mandavya. Warns the Pandavas about the house of lac." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.63; MBh 1.106" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.67; MBh 1.108" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.106; MBh 1.108; MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.147; 1.149" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxlvii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 5.33" ; schema:url <https://sacred-texts.com/hin/m05/m05033.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 15.26" ; schema:url <https://sacred-texts.com/hin/m15/m15026.htm> ] .

:vikarna a aoa:Person ;
    rdfs:label "Vikarna" ;
    rdfs:comment "The one Kaurava who protests Draupadi's treatment at the dice game. Bhima kills him in the war with regret." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
