        [ a yc:Citation ; rdfs:label "MBh 16.7" ; schema:url <https://sacred-texts.com/hin/m16/m16007.htm> ] .

:ashvasena a yc:Person ;
    rdfs:label "Ashvasena" ;
    rdfs:comment "Takshaka's son, who escapes the Khandava fire. At Kurukshetra he rides Karna's arrow at Arjuna, and Krishna saves Arjuna by pressing the chariot into the ground." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-naga ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.229-230" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxix> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.229" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxix> ] ,
        [ a yc:Citation ; rdfs:label "MBh 8.90" ; schema:url <https://sacred-texts.com/hin/m08/m08090.htm> ] .

:ashwathamahata a yc:Event ;
    rdfs:label "Ashwatthama is dead" ;
    rdfs:comment "On Krishna's advice Bhima kills an elephant named Ashwatthama, and Yudhishthira tells Drona that Ashwatthama is dead, muttering \"the elephant\". Drona lays down his arms." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 7.191; MBh 7.193" ; schema:url <https://sacred-texts.com/hin/m07/m07187.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.191" ; schema:url <https://sacred-texts.com/hin/m07/m07187.htm> ] .

:ashwatthama a yc:Person, yc:Chiranjivi ;
    rdfs:label "Ashwatthama" ;
    rdfs:comment "Son of Drona and Kripi, born of a portion of Shiva. Leads the night raid and is cursed by Krishna to wander for 3,000 years." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:kills :dhrishtadyumna, :shikhandi, :upapandavas ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.131" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxxi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 10.8" ; schema:url <https://sacred-texts.com/hin/m10/m10008.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 10.13" ; schema:url <https://sacred-texts.com/hin/m10/m10013.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 10.16" ; schema:url <https://sacred-texts.com/hin/m10/m10016.htm> ] .

:babruvahana a yc:Person ;
    rdfs:label "Babruvahana" ;
    rdfs:comment "Arjuna's son by Chitrangada. Kills his father in a fight during the Ashvamedha. Ulupi revives Arjuna." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.217; 1.219" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxix> ] ,
        [ a yc:Citation ; rdfs:label "MBh 14.79" ; schema:url <https://sacred-texts.com/hin/m14/m14079.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 14.80" ; schema:url <https://sacred-texts.com/hin/m14/m14080.htm> ] .

:bahlika a yc:Person ;
    rdfs:label "Bahlika" ;
    rdfs:comment "Shantanu's brother. The oldest warrior at Kurukshetra, fighting for the Kauravas. Bhima kills him." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :somadatta ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.94; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.156" ; schema:url <https://sacred-texts.com/hin/m07/m07153.htm> ] .

:baka a yc:Person ;
    rdfs:label "Bakasura" ;
    rdfs:comment "Rakshasa who takes a cartload of food, two buffaloes and a person from Ekachakra village in turn. Bhima kills him." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.162; 1.165" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.165" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.11" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-xi> ] .

:bakac a yc:Person ;
    rdfs:label "Bakasura (crane)" ;
    rdfs:comment "Crane demon, Putana's brother, who swallows Krishna. Krishna tears his beak apart. Not the Baka whom Bhima kills (Bhagavata)." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-purana ;
    yc:being yc:being-asura .

:balarama a yc:Person ;
    rdfs:label "Balarama" ;
    rdfs:comment "Krishna's elder brother, Shesha incarnate in the Puranas. Teaches the mace to both Bhima and Duryodhana and stays out of the war." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:kills :dhenuka, :pralamba ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 9.34" ; schema:url <https://sacred-texts.com/hin/m09/m09034.htm> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 1.10" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485487.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.2" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485538.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.4" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485541.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.13" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485550.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.14" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485551.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.30" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485571.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.33" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485574.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.62" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485603.html> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 9.3" ; schema:url <https://vedabase.io/en/library/sb/9/3/> ] .

:bana a yc:Person ;
    rdfs:label "Bana" ;
    rdfs:comment "Thousand-armed asura, Bali's son and Shiva's devotee. Krishna cuts off most of his arms (Harivamsa)." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-asura ;
