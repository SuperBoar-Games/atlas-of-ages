:dhenuka a yc:Person ;
    rdfs:label "Dhenukasura" ;
    rdfs:comment "Donkey demon guarding a palm grove. Balarama hurls him into the trees." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-asura ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.13" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485550.html> ] .

:dhrishtadyumna a yc:Person ;
    rdfs:label "Dhrishtadyumna" ;
    rdfs:comment "Born from Drupada's sacrificial fire. Commands the Pandava army and kills Drona. Ashwatthama kills him in the night raid." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:kills :drona ;
    dcterms:source
