:virata a aoa:Person ;
    rdfs:label "Virata" ;
    rdfs:comment "King of Matsya. The Pandavas spend their year in disguise at his court. Killed by Drona." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:parentOf :shveta, :uttara, :uttarakumara ;
