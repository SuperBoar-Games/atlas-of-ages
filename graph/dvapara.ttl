:brahmastra a yc:Event, yc:Catastrophe ;
    rdfs:label "Brahmastras unleashed" ;
    rdfs:comment "Ashwatthama and Arjuna fire the ultimate weapon at each other. Vyasa and Narada step between them. Arjuna withdraws his, and Ashwatthama turns his on the Pandava wombs (Sauptika Parva)." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 10.13" ; schema:url <https://sacred-texts.com/hin/m10/m10013.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 10.14" ; schema:url <https://sacred-texts.com/hin/m10/m10014.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 10.15" ; schema:url <https://sacred-texts.com/hin/m10/m10015.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 10.16" ; schema:url <https://sacred-texts.com/hin/m10/m10016.htm> ] .

:brihadbala a yc:Person ;
    rdfs:label "Brihadbala" ;
    rdfs:comment "Ikshvaku king of Kosala, descended from Rama's son Kusha. Fights for the Kauravas and is killed by Abhimanyu." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 7.45" ; schema:url <https://sacred-texts.com/hin/m07/m07044.htm> ] .

:brihadratha a yc:Person ;
    rdfs:label "Brihadratha" ;
    rdfs:comment "King of Magadha who gets Jarasandha from a sage's mango, eaten by his two queens. Each bears half a child." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :jarasandha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 2.17" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-xvii> ] .

:chanura a yc:Person ;
    rdfs:label "Chanura & Mushtika" ;
    rdfs:comment "Kamsa's wrestlers. Krishna kills Chanura and Balarama kills Mushtika, just before Krishna kills Kamsa." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.30" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485571.html> ] .

:chitrangada a yc:Person ;
    rdfs:label "Chitrangada" ;
    rdfs:comment "Shantanu and Satyavati's elder son. Killed young by a gandharva of the same name." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.95; MBh 1.101" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
