:yaksha a yc:Event ;
    rdfs:label "Yaksha's questions" ;
    rdfs:comment "At a lake a yaksha kills four Pandavas who drink without answering him. Yudhishthira answers his riddles and wins them back. The yaksha is Yama, his father." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    dcterms:source
