:bana a aoa:Person ;
    rdfs:label "Bana" ;
    rdfs:comment "Thousand-armed asura, Bali's son and Shiva's devotee. Krishna cuts off most of his arms (Harivamsa)." ;
    aoa:period aoa:period-dvapara ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
