        [ a yc:Citation ; rdfs:label "MBh 3.312" ; schema:url <https://www.sacred-texts.com/hin/m03/m03312.htm> ] .

:yogamaya a yc:Deva ;
    rdfs:label "Yogamaya" ;
    rdfs:comment "The goddess born to Yashoda the night Krishna is born. Vasudeva swaps her for Krishna. When Kamsa tries to dash her on a stone she rises up and warns him his killer lives." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-god ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.4" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485541.html> ] .

:yudhishthira a yc:Person ;
    rdfs:label "Yudhishthira" ;
    rdfs:comment "Eldest Pandava, son of Dharma (Yama). Gambles everything away, kills Shalya, rules after the war." ;
