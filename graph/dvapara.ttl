        [ a yc:Citation ; rdfs:label "MBh 4.14" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xiv> ] .

:sumantu a yc:Sage ;
    rdfs:label "Sumantu" ;
    rdfs:comment "Vyasa's disciple, given the Atharvaveda." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 12.6" ; schema:url <https://vedabase.io/en/library/sb/12/6/> ] .

:susharma a yc:Person ;
    rdfs:label "Susharma" ;
    rdfs:comment "King of Trigarta, who raids Matsya's cattle and leads the Samshaptakas, sworn to kill Arjuna. Arjuna kills him." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 4.30-33" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxx> ] ,
        [ a yc:Citation ; rdfs:label "MBh 4.30-31" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-4-virata-parva/section-xxxi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 7.17" ; schema:url <https://sacred-texts.com/hin/m07/m07017.htm> ] .

:trinavarta a yc:Person ;
    rdfs:label "Trinavarta" ;
    rdfs:comment "Whirlwind demon who carries off the infant Krishna and is strangled by him (Bhagavata)." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-purana ;
    yc:being yc:being-asura .

:twins a yc:Person ;
    rdfs:label "Nakula & Sahadeva" ;
    rdfs:comment "Madri's twin sons by the Ashvins. Sahadeva kills Shakuni." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.67; MBh 1.124" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.124" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxiv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 9.28" ; schema:url <https://sacred-texts.com/hin/m09/m09028.htm> ] .

:uddhava a yc:Person ;
    rdfs:label "Uddhava" ;
    rdfs:comment "Krishna's cousin and closest counsellor. Carries his message to the gopis and hears the Uddhava Gita before the end." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-purana ;
    yc:being yc:being-human .

:ugrasena a yc:Person ;
    rdfs:label "Ugrasena" ;
    rdfs:comment "Yadava king of Mathura, deposed by his son Kamsa and restored by Krishna." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :kamsa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 1.37" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485514.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.32" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485573.html> ] .

:uluka a yc:Person ;
    rdfs:label "Uluka" ;
    rdfs:comment "Shakuni's son and Duryodhana's insulting envoy to the Pandavas before the war. Sahadeva kills him." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 5.161; MBh 5.162" ; schema:url <https://sacred-texts.com/hin/m05/m05161.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.161" ; schema:url <https://sacred-texts.com/hin/m05/m05161.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 9.28" ; schema:url <https://sacred-texts.com/hin/m09/m09028.htm> ] .

:ulupi a yc:Person ;
    rdfs:label "Ulupi" ;
    rdfs:comment "Naga princess who marries Arjuna. Revives him after Babruvahana kills him." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-naga ;
    yc:role yc:role-woman ;
    yc:parentOf :iravan ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.216" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 6.91" ; schema:url <https://sacred-texts.com/hin/m06/m06091.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 14.80" ; schema:url <https://sacred-texts.com/hin/m14/m14080.htm> ] .

:upapandavas a yc:Person ;
    rdfs:label "Upapandavas" ;
    rdfs:comment "Draupadi's five sons, one by each Pandava. Ashwatthama kills them in the night raid." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.223" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxiii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 10.8" ; schema:url <https://sacred-texts.com/hin/m10/m10008.htm> ] .

:uparichara a yc:Person ;
    rdfs:label "Uparichara Vasu" ;
    rdfs:comment "King of Chedi whose seed, carried off by a hawk, is swallowed by the cursed apsara Adrika living as a fish. Satyavati is born from her." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.63" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxiii> ] .

:uttara a yc:Person ;
    rdfs:label "Uttara" ;
    rdfs:comment "Virata's daughter and Arjuna's dance pupil. Marries Abhimanyu and is Parikshit's mother." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :parikshit ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
