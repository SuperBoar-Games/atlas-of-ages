:pandu a yc:Person ;
    rdfs:label "Pandu" ;
    rdfs:comment "Son of Vyasa and Ambalika. After Kindama's curse he cannot father children, and he dies when he embraces Madri." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
