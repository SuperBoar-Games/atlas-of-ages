:narakasura a yc:Person ;
    rdfs:label "Narakasura" ;
    rdfs:comment "Asura king of Pragjyotisha. Krishna kills him and frees 16,100 captive women (16,000 in the Bhagavata). The Puranas make him the son of Varaha and Bhudevi." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-asura ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.64" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485605.html> ] ,
