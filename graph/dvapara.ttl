:kindama a yc:Sage ;
    rdfs:label "Kindama" ;
    rdfs:comment "Sage who mates with his wife in the form of deer. Pandu shoots him, and Kindama curses Pandu to die if he approaches a woman." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.118" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxviii> ] .

:kirmira a yc:Person ;
    rdfs:label "Kirmira" ;
    rdfs:comment "Rakshasa, brother of Baka, who blocks the Pandavas' way into the Kamyaka forest. Bhima kills him." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 3.11" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-xi> ] .

:kripa a yc:Person, yc:Chiranjivi ;
    rdfs:label "Kripa" ;
    rdfs:comment "Kuru teacher, Gautama's grandson. A chiranjivi who survives the war and joins the night raid." ;
