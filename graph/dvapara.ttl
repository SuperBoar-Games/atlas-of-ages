:panchajana a yc:Person ;
    rdfs:label "Panchajana" ;
    rdfs:comment "Sea demon who has swallowed Sandipani's son. Krishna kills him and takes his shell as the conch Panchajanya." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-asura ;
