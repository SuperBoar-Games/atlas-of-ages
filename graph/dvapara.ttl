        [ a yc:Citation ; rdfs:label "MBh 3.238, 3.244" ; schema:url <https://www.sacred-texts.com/hin/m03/m03244.htm> ] .

:dantavakra a yc:Person ;
    rdfs:label "Dantavakra" ;
    rdfs:comment "King of Karusha, Shishupala's ally. Vijaya's third birth, killed by Krishna (Bhagavata)." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bhagavata 7.1" ; schema:url <https://vedabase.io/en/library/sb/7/1/> ] .

:daushasani a yc:Person ;
    rdfs:label "Dushasana's son" ;
    rdfs:comment "Dushasana's son. After six warriors strip Abhimanyu of chariot and weapons, he fells him with a mace blow as he rises." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:kills :abhimanyu ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 7.47; MBh 7.49" ; schema:url <https://sacred-texts.com/hin/m07/m07046.htm> ] .

:devaki a yc:Person ;
    rdfs:label "Devaki" ;
    rdfs:comment "Kamsa's cousin and Vasudeva's wife. Mother of Krishna. Her seventh child, Balarama, is moved to Rohini's womb." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
