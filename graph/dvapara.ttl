:dhaumya a yc:Sage ;
    rdfs:label "Dhaumya" ;
    rdfs:comment "Priest of the Pandavas from their journey to Draupadi's svayamvara on, who goes with them into exile." ;
    yc:period yc:period-dvapara ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.185; 2.79" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxxxv> ] ,
