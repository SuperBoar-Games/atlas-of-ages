:urvashi a yc:Person, yc:SpansYugas ;
    rdfs:label "Urvashi" ;
    rdfs:comment "Apsara who lives with Pururavas on conditions the Gandharvas trick him into breaking. Mother of Ayu. In the Dvapara she curses Arjuna to live as a eunuch, and Indra limits the curse to one year." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-apsara ;
    yc:role yc:role-woman ;
    yc:parentOf :ayu ;
