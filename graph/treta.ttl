        [ a yc:Citation ; rdfs:label "MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.46" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-xlvi> ] .

:vali a yc:Person ;
    rdfs:label "Vali" ;
    rdfs:comment "Vanara king, son of Indra. Rama kills him from hiding while he fights Sugriva. In the Uttara Kanda he once humbled Ravana." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-vanara ;
    yc:role yc:role-king ;
    yc:parentOf :angada ;
