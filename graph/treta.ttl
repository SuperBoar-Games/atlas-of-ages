:rama a aoa:Avatar ;
    rdfs:label "Rama" ;
    rdfs:comment "Seventh avatar of Vishnu. In the Vana Parva the sage Markandeya tells his whole story (the Ramopakhyana) to Yudhishthira." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    aoa:role aoa:role-king ;
