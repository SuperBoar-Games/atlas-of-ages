        [ a yc:Citation ; rdfs:label "MBh 1.80" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxx> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.83" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxxiii> ] .

:shatrughna a yc:Person ;
    rdfs:label "Shatrughna" ;
    rdfs:comment "Lakshmana's twin, who stays by Bharata. Kills the demon Lavana and founds Mathura, the city where Krishna is later born." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.18" ; schema:url <https://valmikiramayan.net/baala/sarga18/bala_18_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.73" ; schema:url <https://valmikiramayan.net/baala/sarga73/bala_73_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.78" ; schema:url <https://valmikiramayan.net/ayodhya/sarga78/ayodhya_78_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.115" ; schema:url <https://valmikiramayan.net/ayodhya/sarga115/ayodhya_115_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.69" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424843.html> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.70" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424844.html> ] .

:shibi a yc:Person ;
    rdfs:label "Shibi" ;
    rdfs:comment "King who offers his own flesh to save a dove from a hawk. The birds are Agni and Indra, testing him." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 3.196 (also 3.131)" ; schema:url <https://www.sacred-texts.com/hin/m03/m03196.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.196" ; schema:url <https://www.sacred-texts.com/hin/m03/m03196.htm> ] .

:shravana a yc:Person ;
    rdfs:label "Shravana" ;
    rdfs:comment "Young ascetic fetching water for his blind, aged parents. Valmiki leaves him unnamed; later tradition calls him Shravana. Dasharatha shoots him by mistake, and the father curses Dasharatha to die grieving for a son." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Ayodhya 2.63" ; schema:url <https://valmikiramayan.net/ayodhya/sarga63/ayodhya_63_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.64" ; schema:url <https://valmikiramayan.net/ayodhya/sarga64/ayodhya_64_prose.htm> ] .

:shrutakirti a yc:Person ;
    rdfs:label "Shrutakirti" ;
    rdfs:comment "Shatrughna's wife, a niece of Janaka." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.72" ; schema:url <https://valmikiramayan.net/baala/sarga72/bala_72_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.73" ; schema:url <https://valmikiramayan.net/baala/sarga73/bala_73_frame.htm> ] .

:shukra a yc:Sage ;
    rdfs:label "Shukracharya" ;
    rdfs:comment "Guru of the asuras, master of the Sanjivani revival art. Curses Yayati with old age for secretly taking Sharmishtha." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    yc:parentOf :devayani ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.76; MBh 1.83" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.76" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.83" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxxiii> ] .

:shurpanakha a yc:Person ;
    rdfs:label "Shurpanakha" ;
    rdfs:comment "Ravana's sister. Lakshmana cuts off her ears and nose when she attacks Sita, and she urges Ravana to take revenge." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Aranya 3.17" ; schema:url <https://valmikiramayan.net/aranya/sarga17/aranya_17_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Aranya 3.18" ; schema:url <https://valmikiramayan.net/aranya/sarga18/aranya_18_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.9" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424770.html> ] .

:simhika a yc:Person ;
    rdfs:label "Simhika" ;
    rdfs:comment "Sea demoness who seizes shadows. Hanuman kills her on his leap. The Mahabharata names her the mother of Rahu." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    yc:role yc:role-woman ;
    yc:parentOf :rahu ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Sundara 5.1" ; schema:url <https://valmikiramayan.net/sundara/sarga1/sundara_1_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 6.6" ; schema:url <https://vedabase.io/en/library/sb/6/6/> ] .

:sita a yc:Person ;
    rdfs:label "Sita" ;
    rdfs:comment "Found in a furrow by Janaka and won by Rama. Some Puranas say a shadow-Sita is reborn as Draupadi." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :lavakusha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.4" ; schema:url <https://valmikiramayan.net/baala/sarga4/bala_4_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.66" ; schema:url <https://valmikiramayan.net/baala/sarga66/bala_66_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.73" ; schema:url <https://valmikiramayan.net/baala/sarga73/bala_73_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Aranya 3.49" ; schema:url <https://valmikiramayan.net/aranya/sarga49/aranya_49_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Sundara 5.15" ; schema:url <https://valmikiramayan.net/sundara/sarga15/sundara_15_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Sundara 5.27" ; schema:url <https://valmikiramayan.net/sundara/sarga27/sundara_27_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.33" ; schema:url <https://valmikiramayan.net/yuddha/sarga33/yuddha_33_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.48" ; schema:url <https://valmikiramayan.net/yuddha/sarga48/yuddha_48_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.117" ; schema:url <https://valmikiramayan.net/yuddha/sarga117/yuddha_117_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.17" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424778.html> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.66" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424840.html> ] ,
        [ a yc:Citation ; rdfs:label "Vishnu P. 1.9" ; schema:url <https://sacred-texts.com/hin/vp/vp044.htm> ] .

:sugriva a yc:Person ;
    rdfs:label "Sugriva" ;
    rdfs:comment "Vanara prince, son of Surya. Allies with Rama to win back his kingdom from Vali." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-vanara ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Kishkindha 4.5" ; schema:url <https://valmikiramayan.net/kish/sarga5/kishkindha_5_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Kishkindha 4.8" ; schema:url <https://valmikiramayan.net/kish/sarga8/kishkindha_8_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Kishkindha 4.16" ; schema:url <https://valmikiramayan.net/kish/sarga16/kishkindha_16_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Kishkindha 4.18" ; schema:url <https://valmikiramayan.net/kish/sarga18/kishkindha_18_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Kishkindha 4.33" ; schema:url <https://valmikiramayan.net/kish/sarga33/kishkindha_33_frame.htm> ] .

:sumali a yc:Person ;
    rdfs:label "Sumali" ;
    rdfs:comment "Rakshasa chief driven out of Lanka by Vishnu. He marries his daughter Kaikasi to Vishrava for grandsons as mighty as Kubera, and later urges Ravana to take Lanka back." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-rakshasa ;
    yc:parentOf :kaikasi ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Uttara 7.9" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424770.html> ] .

:sumantra a yc:Person ;
    rdfs:label "Sumantra" ;
    rdfs:comment "Dasharatha's charioteer and minister, who drives Rama into exile." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Ayodhya 2.40" ; schema:url <https://valmikiramayan.net/ayodhya/sarga40/ayodhya_5F40_prose.htm> ] .

:sumitra a yc:Person ;
    rdfs:label "Sumitra" ;
    rdfs:comment "Dasharatha's queen, mother of Lakshmana and Shatrughna." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :lakshmana, :shatrughna ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.16" ; schema:url <https://valmikiramayan.net/baala/sarga16/bala_16_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.18" ; schema:url <https://valmikiramayan.net/baala/sarga18/bala_18_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.40" ; schema:url <https://valmikiramayan.net/ayodhya/sarga40/ayodhya_5F40_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.64" ; schema:url <https://valmikiramayan.net/ayodhya/sarga64/ayodhya_64_prose.htm> ] .

:sundaupasunda a yc:Person, yc:Catastrophe ;
    rdfs:label "Sunda & Upasunda" ;
    rdfs:comment "Asura brothers who conquer the three worlds, then kill each other over the apsara Tilottama. Narada tells their story to the Pandavas so they agree a rule for sharing Draupadi." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-asura ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.211-214" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxiv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.214" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxiv> ] .

:surasa a yc:Person ;
    rdfs:label "Surasa" ;
    rdfs:comment "Mother of serpents, sent to test Hanuman mid-leap. He shrinks, enters her mouth and slips out." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-naga ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Sundara 5.1" ; schema:url <https://valmikiramayan.net/sundara/sarga1/sundara_1_prose.htm> ] .

:sushena a yc:Person ;
    rdfs:label "Sushena" ;
    rdfs:comment "Vanara physician and Tara's father, who revives Lakshmana with the herbs Hanuman brings." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-vanara ;
    yc:parentOf :tara ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Kishkindha 4.22" ; schema:url <https://valmikiramayan.net/kish/sarga22/kishkindha_22_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Kishkindha 4.42" ; schema:url <https://valmikiramayan.net/kish/sarga42/kishkindha_42_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.101" ; schema:url <https://valmikiramayan.net/yuddha/sarga101/yuddha_101_frame.htm> ] .

:t_abduct a yc:Story ;
    rdfs:label "Sita abducted" ;
    rdfs:comment "Maricha lures Rama away as a golden deer. Ravana carries Sita off and cuts down Jatayu." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:leadsTo :t_kish ;
    yc:involves :jatayu, :maricha, :rama, :ravana, :sita ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Aranya 3.49" ; schema:url <https://valmikiramayan.net/aranya/sarga49/aranya_49_frame.htm> ] .

:t_ahalya a yc:Story ;
    rdfs:label "Tataka & Ahalya" ;
    rdfs:comment "Rama guards Vishvamitra's sacrifice, kills Tataka, and frees Ahalya on the way to Mithila." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:leadsTo :t_bow ;
    yc:involves :ahalya, :gautama, :lakshmana, :rama, :tataka, :vishvamitra ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.49" ; schema:url <https://valmikiramayan.net/baala/sarga49/bala_49_frame.htm> ] .

:t_bow a yc:Story ;
    rdfs:label "Bow of Shiva" ;
    rdfs:comment "Rama breaks Shiva's bow at Janaka's court and wins Sita. Parashurama confronts him and yields." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:leadsTo :t_exile ;
    yc:involves :janaka, :parashurama, :rama, :shiva, :sita, :vishvamitra ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.67" ; schema:url <https://valmikiramayan.net/baala/sarga67/bala_67_frame.htm> ] .

:t_exile a yc:Story ;
    rdfs:label "Exile" ;
    rdfs:comment "Kaikeyi's boons send Rama, Sita and Lakshmana to the forest for fourteen years. Bharata rules in his name." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:leadsTo :t_panch ;
    yc:involves :bharatar, :dasharatha, :guha, :kaikeyi, :kausalya, :lakshmana, :manthara, :rama, :shatrughna, :sita, :sumantra, :sumitra, :urmila ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Ayodhya 2.11" ; schema:url <https://valmikiramayan.net/ayodhya/sarga11/ayodhya_11_prose.htm> ] .

:t_kish a yc:Story ;
    rdfs:label "Kishkindha pact" ;
    rdfs:comment "Rama kills Vali and makes Sugriva king. The vanaras search for Sita." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:leadsTo :t_leap ;
    yc:involves :angada, :hanuman, :kabandha, :rama, :ruma, :shabari, :sugriva, :tara, :vali ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Kishkindha 4.26" ; schema:url <https://valmikiramayan.net/kish/sarga26/kishkindha_26_frame.htm> ] .

:t_lanka a yc:Story ;
    rdfs:label "War in Lanka" ;
    rdfs:comment "The bridge is built. Indrajit, Kumbhakarna and Ravana fall, and Vibhishana is crowned." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:leadsTo :t_return ;
    yc:involves :angada, :atikaya, :dvivida, :hanuman, :indrajit, :jambavan, :kumbhakarna, :lakshmana, :mandodari, :nala, :nila, :prahasta, :rama, :ravana, :sanjeevani, :sarama, :sushena, :vibhishana ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Yuddha 6.22" ; schema:url <https://valmikiramayan.net/yuddha/sarga22/yuddha_22_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.112" ; schema:url <https://valmikiramayan.net/yuddha/sarga112/yuddha_112_frame.htm> ] .

:t_leap a yc:Story ;
    rdfs:label "Hanuman's leap" ;
    rdfs:comment "Reminded of his strength by Jambavan, Hanuman leaps to Lanka, finds Sita and burns the city." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:leadsTo :t_lanka ;
    yc:involves :akshayakumara, :hanuman, :indrajit, :jambavan, :lankaburn, :lankini, :ravana, :sampati, :simhika, :sita, :surasa, :trijata ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Kishkindha 4.66" ; schema:url <https://valmikiramayan.net/kish/sarga66/kishkindha_66_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Sundara 5.1" ; schema:url <https://valmikiramayan.net/sundara/sarga1/sundara_1_prose.htm> ] .

:t_panch a yc:Story ;
    rdfs:label "Panchavati" ;
    rdfs:comment "Lakshmana cuts off Shurpanakha's nose, and she goes to Ravana for revenge." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:leadsTo :t_abduct ;
    yc:involves :khara, :lakshmana, :rama, :ravana, :shurpanakha, :viradha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Aranya 3.18" ; schema:url <https://valmikiramayan.net/aranya/sarga18/aranya_18_frame.htm> ] .

:t_return a yc:Story ;
    rdfs:label "Return & Uttara Kanda" ;
    rdfs:comment "Rama is crowned. Later Sita is exiled, Lava and Kusha sing the Ramayana, and Sita returns to the earth." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:involves :bharatar, :lavakusha, :pushpaka, :rama, :sita, :valmiki ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Yuddha 6.128" ; schema:url <https://valmikiramayan.net/yuddha/sarga128/yuddha_128_frame.htm> ] .

:tapati a yc:Person ;
    rdfs:label "Tapati" ;
    rdfs:comment "Daughter of Surya. A gandharva tells her story to Arjuna and calls him Tapatya, her descendant." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :kuru ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.94; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.94; MBh 1.175" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.173; MBh 1.175" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxxiii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.175" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxxv> ] .

:tara a yc:Person ;
    rdfs:label "Tara" ;
    rdfs:comment "Vali's wise wife, daughter of Sushena. After Vali's death she marries Sugriva." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-vanara ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Kishkindha 4.19" ; schema:url <https://valmikiramayan.net/kish/sarga19/kishkindha_19_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Kishkindha 4.22" ; schema:url <https://valmikiramayan.net/kish/sarga22/kishkindha_22_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Kishkindha 4.33" ; schema:url <https://valmikiramayan.net/kish/sarga33/kishkindha_33_frame.htm> ] .

:tataka a yc:Person ;
    rdfs:label "Tataka" ;
    rdfs:comment "Yakshi, daughter of Suketu, turned into a rakshasi. Mother of Maricha. Rama kills her on Vishvamitra's word." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-rakshasa ;
    yc:role yc:role-woman ;
    yc:parentOf :maricha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.25" ; schema:url <https://valmikiramayan.net/baala/sarga25/bala_5F25_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.26" ; schema:url <https://valmikiramayan.net/baala/sarga26/bala_26_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Aranya 3.38" ; schema:url <https://valmikiramayan.net/aranya/sarga38/aranya_38_frame.htm> ] .

:tilottama a yc:Person ;
    rdfs:label "Tilottama" ;
    rdfs:comment "Apsara Vishvakarma makes from the finest part of everything, to divide Sunda and Upasunda." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-apsara ;
    yc:role yc:role-woman ;
    dcterms:source
