:ravana a aoa:Person ;
    rdfs:label "Ravana" ;
    rdfs:comment "Rakshasa king of Lanka and Jaya's second birth. Abducts Sita and is killed by Rama." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-rakshasa ;
