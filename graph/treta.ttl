:urmila a yc:Person ;
    rdfs:label "Urmila" ;
    rdfs:comment "Sita's sister and Lakshmana's wife, who stays in Ayodhya through the exile." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
