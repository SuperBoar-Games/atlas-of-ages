:vashishtha a yc:Sage, yc:SpansYugas ;
    rdfs:label "Vashishtha" ;
    rdfs:comment "Mind-born son of Brahma and priest of the Ikshvakus. Old rival of Vishvamitra. His curse sends the eight Vasus into human birth. Great-grandfather of Vyasa." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
