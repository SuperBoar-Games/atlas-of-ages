:yayati a yc:Person ;
    rdfs:label "Yayati" ;
    rdfs:comment "Son of Nahusha. Cursed with old age, he asks his sons to take it. Only Puru agrees." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
