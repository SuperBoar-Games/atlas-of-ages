:vibhishana a yc:Person, yc:Chiranjivi ;
    rdfs:label "Vibhishana" ;
    rdfs:comment "Ravana's brother who joins Rama and becomes king of Lanka. One of the chiranjivis." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    yc:role yc:role-king ;
