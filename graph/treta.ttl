:renuka a aoa:Person ;
    rdfs:label "Renuka" ;
    rdfs:comment "Jamadagni's wife. On his order Parashurama beheads her, then asks for and receives her life back." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :parashurama ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.116" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxvi> ] .

:rishyashringa a aoa:Sage ;
    rdfs:label "Rishyashringa" ;
    rdfs:comment "Sage raised in the forest who has never seen a woman. Brought to Anga to end a drought, he marries Shanta and later performs Dasharatha's sacrifice for sons. Told in both epics." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.10" ; schema:url <https://valmikiramayan.net/baala/sarga10/bala_10_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.15" ; schema:url <https://valmikiramayan.net/baala/sarga15/bala_15_frame.htm> ] .

:rohita a aoa:Person ;
    rdfs:label "Rohita" ;
    rdfs:comment "Harishchandra's son, promised to Varuna as a sacrifice and saved." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.70" ; schema:url <https://valmikiramayan.net/baala/sarga70/bala_70_frame.htm> ] .

:ruma a aoa:Person ;
    rdfs:label "Ruma" ;
    rdfs:comment "Sugriva's wife, seized by Vali." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-vanara ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.10" ; schema:url <https://valmikiramayan.net/kish/sarga10/kishkindha_10_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.18" ; schema:url <https://valmikiramayan.net/kish/sarga18/kishkindha_18_frame.htm> ] .

:sagara a aoa:Person ;
    rdfs:label "Sagara" ;
    rdfs:comment "Son of Asita, born with poison. Indra steals his Ashvamedha horse in a demon's form, and his 60,000 sons dig up the earth looking for it." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:parentOf :asamanja, :sagarasons ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.38" ; schema:url <https://valmikiramayan.net/baala/sarga38/bala_38_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.39" ; schema:url <https://valmikiramayan.net/baala/sarga39/bala_39_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.70" ; schema:url <https://valmikiramayan.net/baala/sarga70/bala_70_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Ayodhya 2.110" ; schema:url <https://valmikiramayan.net/ayodhya/sarga110/ayodhya_110_prose.htm> ] .

:sagarasons a aoa:Person, aoa:Catastrophe ;
    rdfs:label "Sagara's 60,000 sons" ;
    rdfs:comment "They accuse Kapila of stealing the horse and are burned to ash by a single sound from him. Only Ganga's water can free their souls, which is why Bhagiratha brings her down." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.38" ; schema:url <https://valmikiramayan.net/baala/sarga38/bala_38_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.40" ; schema:url <https://valmikiramayan.net/baala/sarga40/bala_5F40_frame.htm> ] .

:sahasrakavacha a aoa:Person ;
    rdfs:label "Sahasrakavacha" ;
    rdfs:comment "The demon Dambhodbhava with a thousand armours from Surya. Nara and Narayana break 999 of them. Folk tradition says he is reborn as Karna wearing the last." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-folk ;
    aoa:being aoa:being-asura .

:sampati a aoa:Person ;
    rdfs:label "Sampati" ;
    rdfs:comment "Jatayu's elder brother, whose wings burned when he shielded Jatayu from the sun. He tells the vanaras that Sita is in Lanka." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-beast ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Aranya 3.14" ; schema:url <https://valmikiramayan.net/aranya/sarga14/aranya_14_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.58" ; schema:url <https://valmikiramayan.net/kish/sarga58/kishkindha_58_frame.htm> ] .

:samvarana a aoa:Person ;
    rdfs:label "Samvarana" ;
    rdfs:comment "Puru-line king who marries Tapati with Vashishtha's help." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:parentOf :kuru ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.94; MBh 1.175" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.94; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.175" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxxv> ] .

:sanjeevani a aoa:Event ;
    rdfs:label "Sanjeevani mountain" ;
    rdfs:comment "Hanuman flies to the Himalaya twice: first for four healing herbs when Indrajit's weapon fells Rama, Lakshmana and the army, then for a whole mountain when Ravana's spear fells Lakshmana and Sushena treats him." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Yuddha 6.74" ; schema:url <https://valmikiramayan.net/yuddha/sarga74/yuddha_74_frame.htm> ] .

:sarama a aoa:Person ;
    rdfs:label "Sarama" ;
    rdfs:comment "Rakshasi who guards Sita for Ravana and comforts her. Commentators call her Vibhishana's wife." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-rakshasa ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Yuddha 6.33" ; schema:url <https://valmikiramayan.net/yuddha/sarga33/yuddha_33_frame.htm> ] .

:satyavan a aoa:Person ;
    rdfs:label "Satyavan" ;
    rdfs:comment "Savitri's husband, fated to die within a year of marriage." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.292" ; schema:url <https://www.sacred-texts.com/hin/m03/m03292.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.293" ; schema:url <https://www.sacred-texts.com/hin/m03/m03293.htm> ] .

:savitri a aoa:Person ;
    rdfs:label "Savitri" ;
    rdfs:comment "Princess who follows Yama as he takes her husband Satyavan's life, and wins it back with her answers." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.292" ; schema:url <https://www.sacred-texts.com/hin/m03/m03292.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.293" ; schema:url <https://www.sacred-texts.com/hin/m03/m03293.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.295" ; schema:url <https://www.sacred-texts.com/hin/m03/m03295.htm> ] .

:shabari a aoa:Person ;
    rdfs:label "Shabari" ;
    rdfs:comment "Ascetic woman at Lake Pampa who has waited years for Rama. She welcomes him, shows him the Matanga forest, and enters the fire." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Aranya 3.74" ; schema:url <https://valmikiramayan.net/aranya/sarga74/aranya_74_frame.htm> ] .

:shakuntala a aoa:Person ;
    rdfs:label "Shakuntala" ;
    rdfs:comment "Daughter of Vishvamitra and Menaka, raised in Kanva's hermitage." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :bharata ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.72" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.73; MBh 1.74" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.74" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxiv> ] .

:shanta a aoa:Person ;
    rdfs:label "Shanta" ;
    rdfs:comment "Daughter of King Romapada of Anga and wife of Rishyashringa. Later tradition makes her Dasharatha's daughter, adopted by Romapada." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.10" ; schema:url <https://valmikiramayan.net/baala/sarga10/bala_10_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.11" ; schema:url <https://valmikiramayan.net/baala/sarga11/bala_11_frame.htm> ] .

:sharmishtha a aoa:Person ;
    rdfs:label "Sharmishtha" ;
    rdfs:comment "Asura princess made Devayani's servant. Secretly bears Yayati three sons, the youngest of them Puru." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-asura ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :puru ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.75; MBh 1.83" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.80; MBh 1.83" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.80" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxx> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.83" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxxiii> ] .

:shatrughna a aoa:Person ;
    rdfs:label "Shatrughna" ;
    rdfs:comment "Lakshmana's twin, who stays by Bharata. Kills the demon Lavana and founds Mathura, the city where Krishna is later born." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.18" ; schema:url <https://valmikiramayan.net/baala/sarga18/bala_18_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.73" ; schema:url <https://valmikiramayan.net/baala/sarga73/bala_73_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Ayodhya 2.78" ; schema:url <https://valmikiramayan.net/ayodhya/sarga78/ayodhya_78_prose.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Ayodhya 2.115" ; schema:url <https://valmikiramayan.net/ayodhya/sarga115/ayodhya_115_prose.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.69" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424843.html> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.70" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424844.html> ] .

:shibi a aoa:Person ;
    rdfs:label "Shibi" ;
    rdfs:comment "King who offers his own flesh to save a dove from a hawk. The birds are Agni and Indra, testing him." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.196 (also 3.131)" ; schema:url <https://www.sacred-texts.com/hin/m03/m03196.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.196" ; schema:url <https://www.sacred-texts.com/hin/m03/m03196.htm> ] .

:shravana a aoa:Person ;
    rdfs:label "Shravana" ;
    rdfs:comment "Young ascetic fetching water for his blind, aged parents. Valmiki leaves him unnamed; later tradition calls him Shravana. Dasharatha shoots him by mistake, and the father curses Dasharatha to die grieving for a son." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Ayodhya 2.63" ; schema:url <https://valmikiramayan.net/ayodhya/sarga63/ayodhya_63_prose.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Ayodhya 2.64" ; schema:url <https://valmikiramayan.net/ayodhya/sarga64/ayodhya_64_prose.htm> ] .

:shrutakirti a aoa:Person ;
    rdfs:label "Shrutakirti" ;
    rdfs:comment "Shatrughna's wife, a niece of Janaka." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.72" ; schema:url <https://valmikiramayan.net/baala/sarga72/bala_72_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.73" ; schema:url <https://valmikiramayan.net/baala/sarga73/bala_73_frame.htm> ] .

:shukra a aoa:Sage ;
    rdfs:label "Shukracharya" ;
    rdfs:comment "Guru of the asuras, master of the Sanjivani revival art. Curses Yayati with old age for secretly taking Sharmishtha." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    aoa:parentOf :devayani ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.76; MBh 1.83" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.76" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxvi> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.83" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxxiii> ] .

:shurpanakha a aoa:Person ;
    rdfs:label "Shurpanakha" ;
    rdfs:comment "Ravana's sister. Lakshmana cuts off her ears and nose when she attacks Sita, and she urges Ravana to take revenge." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-rakshasa ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Aranya 3.17" ; schema:url <https://valmikiramayan.net/aranya/sarga17/aranya_17_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Aranya 3.18" ; schema:url <https://valmikiramayan.net/aranya/sarga18/aranya_18_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.9" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424770.html> ] .

:simhika a aoa:Person ;
    rdfs:label "Simhika" ;
    rdfs:comment "Sea demoness who seizes shadows. Hanuman kills her on his leap. The Mahabharata names her the mother of Rahu." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-rakshasa ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :rahu ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Sundara 5.1" ; schema:url <https://valmikiramayan.net/sundara/sarga1/sundara_1_prose.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.6" ; schema:url <https://vedabase.io/en/library/sb/6/6/> ] .

:sita a aoa:Person ;
    rdfs:label "Sita" ;
    rdfs:comment "Found in a furrow by Janaka and won by Rama. Some Puranas say a shadow-Sita is reborn as Draupadi." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :lavakusha ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.4" ; schema:url <https://valmikiramayan.net/baala/sarga4/bala_4_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.66" ; schema:url <https://valmikiramayan.net/baala/sarga66/bala_66_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.73" ; schema:url <https://valmikiramayan.net/baala/sarga73/bala_73_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Aranya 3.49" ; schema:url <https://valmikiramayan.net/aranya/sarga49/aranya_49_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Sundara 5.15" ; schema:url <https://valmikiramayan.net/sundara/sarga15/sundara_15_prose.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Sundara 5.27" ; schema:url <https://valmikiramayan.net/sundara/sarga27/sundara_27_prose.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Yuddha 6.33" ; schema:url <https://valmikiramayan.net/yuddha/sarga33/yuddha_33_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Yuddha 6.48" ; schema:url <https://valmikiramayan.net/yuddha/sarga48/yuddha_48_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Yuddha 6.117" ; schema:url <https://valmikiramayan.net/yuddha/sarga117/yuddha_117_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.17" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424778.html> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.66" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424840.html> ] ,
        [ a aoa:Citation ; rdfs:label "Vishnu P. 1.9" ; schema:url <https://sacred-texts.com/hin/vp/vp044.htm> ] .

:sugriva a aoa:Person ;
    rdfs:label "Sugriva" ;
    rdfs:comment "Vanara prince, son of Surya. Allies with Rama to win back his kingdom from Vali." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-vanara ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.5" ; schema:url <https://valmikiramayan.net/kish/sarga5/kishkindha_5_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.8" ; schema:url <https://valmikiramayan.net/kish/sarga8/kishkindha_8_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.16" ; schema:url <https://valmikiramayan.net/kish/sarga16/kishkindha_16_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.18" ; schema:url <https://valmikiramayan.net/kish/sarga18/kishkindha_18_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.33" ; schema:url <https://valmikiramayan.net/kish/sarga33/kishkindha_33_frame.htm> ] .

:sumali a aoa:Person ;
    rdfs:label "Sumali" ;
    rdfs:comment "Rakshasa chief driven out of Lanka by Vishnu. He marries his daughter Kaikasi to Vishrava for grandsons as mighty as Kubera, and later urges Ravana to take Lanka back." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-rakshasa ;
    aoa:parentOf :kaikasi ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Uttara 7.9" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424770.html> ] .

:sumantra a aoa:Person ;
    rdfs:label "Sumantra" ;
    rdfs:comment "Dasharatha's charioteer and minister, who drives Rama into exile." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Ayodhya 2.40" ; schema:url <https://valmikiramayan.net/ayodhya/sarga40/ayodhya_5F40_prose.htm> ] .

:sumitra a aoa:Person ;
    rdfs:label "Sumitra" ;
    rdfs:comment "Dasharatha's queen, mother of Lakshmana and Shatrughna." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :lakshmana, :shatrughna ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.16" ; schema:url <https://valmikiramayan.net/baala/sarga16/bala_16_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.18" ; schema:url <https://valmikiramayan.net/baala/sarga18/bala_18_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Ayodhya 2.40" ; schema:url <https://valmikiramayan.net/ayodhya/sarga40/ayodhya_5F40_prose.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Ayodhya 2.64" ; schema:url <https://valmikiramayan.net/ayodhya/sarga64/ayodhya_64_prose.htm> ] .

:sundaupasunda a aoa:Person, aoa:Catastrophe ;
    rdfs:label "Sunda & Upasunda" ;
    rdfs:comment "Asura brothers who conquer the three worlds, then kill each other over the apsara Tilottama. Narada tells their story to the Pandavas so they agree a rule for sharing Draupadi." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-asura ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.211-214" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxiv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.214" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxiv> ] .

:surasa a aoa:Person ;
    rdfs:label "Surasa" ;
    rdfs:comment "Mother of serpents, sent to test Hanuman mid-leap. He shrinks, enters her mouth and slips out." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-naga ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Sundara 5.1" ; schema:url <https://valmikiramayan.net/sundara/sarga1/sundara_1_prose.htm> ] .

:sushena a aoa:Person ;
    rdfs:label "Sushena" ;
    rdfs:comment "Vanara physician and Tara's father, who revives Lakshmana with the herbs Hanuman brings." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-vanara ;
    aoa:parentOf :tara ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.22" ; schema:url <https://valmikiramayan.net/kish/sarga22/kishkindha_22_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.42" ; schema:url <https://valmikiramayan.net/kish/sarga42/kishkindha_42_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Yuddha 6.101" ; schema:url <https://valmikiramayan.net/yuddha/sarga101/yuddha_101_frame.htm> ] .

:t_abduct a aoa:Story ;
    rdfs:label "Sita abducted" ;
    rdfs:comment "Maricha lures Rama away as a golden deer. Ravana carries Sita off and cuts down Jatayu." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:leadsTo :t_kish ;
    aoa:involves :jatayu, :maricha, :rama, :ravana, :sita ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Aranya 3.49" ; schema:url <https://valmikiramayan.net/aranya/sarga49/aranya_49_frame.htm> ] .

:t_ahalya a aoa:Story ;
    rdfs:label "Tataka & Ahalya" ;
    rdfs:comment "Rama guards Vishvamitra's sacrifice, kills Tataka, and frees Ahalya on the way to Mithila." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-layer ;
    aoa:leadsTo :t_bow ;
    aoa:involves :ahalya, :gautama, :lakshmana, :rama, :tataka, :vishvamitra ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.49" ; schema:url <https://valmikiramayan.net/baala/sarga49/bala_49_frame.htm> ] .

:t_bow a aoa:Story ;
    rdfs:label "Bow of Shiva" ;
    rdfs:comment "Rama breaks Shiva's bow at Janaka's court and wins Sita. Parashurama confronts him and yields." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-layer ;
    aoa:leadsTo :t_exile ;
    aoa:involves :janaka, :parashurama, :rama, :shiva, :sita, :vishvamitra ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.67" ; schema:url <https://valmikiramayan.net/baala/sarga67/bala_67_frame.htm> ] .

:t_exile a aoa:Story ;
    rdfs:label "Exile" ;
    rdfs:comment "Kaikeyi's boons send Rama, Sita and Lakshmana to the forest for fourteen years. Bharata rules in his name." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:leadsTo :t_panch ;
    aoa:involves :bharatar, :dasharatha, :guha, :kaikeyi, :kausalya, :lakshmana, :manthara, :rama, :shatrughna, :sita, :sumantra, :sumitra, :urmila ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Ayodhya 2.11" ; schema:url <https://valmikiramayan.net/ayodhya/sarga11/ayodhya_11_prose.htm> ] .

:t_kish a aoa:Story ;
    rdfs:label "Kishkindha pact" ;
    rdfs:comment "Rama kills Vali and makes Sugriva king. The vanaras search for Sita." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:leadsTo :t_leap ;
    aoa:involves :angada, :hanuman, :kabandha, :rama, :ruma, :shabari, :sugriva, :tara, :vali ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.26" ; schema:url <https://valmikiramayan.net/kish/sarga26/kishkindha_26_frame.htm> ] .

:t_lanka a aoa:Story ;
    rdfs:label "War in Lanka" ;
    rdfs:comment "The bridge is built. Indrajit, Kumbhakarna and Ravana fall, and Vibhishana is crowned." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:leadsTo :t_return ;
    aoa:involves :angada, :atikaya, :dvivida, :hanuman, :indrajit, :jambavan, :kumbhakarna, :lakshmana, :mandodari, :nala, :nila, :prahasta, :rama, :ravana, :sanjeevani, :sarama, :sushena, :vibhishana ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Yuddha 6.22" ; schema:url <https://valmikiramayan.net/yuddha/sarga22/yuddha_22_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Yuddha 6.112" ; schema:url <https://valmikiramayan.net/yuddha/sarga112/yuddha_112_frame.htm> ] .

:t_leap a aoa:Story ;
    rdfs:label "Hanuman's leap" ;
    rdfs:comment "Reminded of his strength by Jambavan, Hanuman leaps to Lanka, finds Sita and burns the city." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:leadsTo :t_lanka ;
    aoa:involves :akshayakumara, :hanuman, :indrajit, :jambavan, :lankaburn, :lankini, :ravana, :sampati, :simhika, :sita, :surasa, :trijata ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.66" ; schema:url <https://valmikiramayan.net/kish/sarga66/kishkindha_66_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Sundara 5.1" ; schema:url <https://valmikiramayan.net/sundara/sarga1/sundara_1_prose.htm> ] .

:t_panch a aoa:Story ;
    rdfs:label "Panchavati" ;
    rdfs:comment "Lakshmana cuts off Shurpanakha's nose, and she goes to Ravana for revenge." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:leadsTo :t_abduct ;
    aoa:involves :khara, :lakshmana, :rama, :ravana, :shurpanakha, :viradha ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Aranya 3.18" ; schema:url <https://valmikiramayan.net/aranya/sarga18/aranya_18_frame.htm> ] .

:t_return a aoa:Story ;
    rdfs:label "Return & Uttara Kanda" ;
    rdfs:comment "Rama is crowned. Later Sita is exiled, Lava and Kusha sing the Ramayana, and Sita returns to the earth." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-layer ;
    aoa:involves :bharatar, :lavakusha, :pushpaka, :rama, :sita, :valmiki ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Yuddha 6.128" ; schema:url <https://valmikiramayan.net/yuddha/sarga128/yuddha_128_frame.htm> ] .

:tapati a aoa:Person ;
    rdfs:label "Tapati" ;
    rdfs:comment "Daughter of Surya. A gandharva tells her story to Arjuna and calls him Tapatya, her descendant." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :kuru ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.94; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.94; MBh 1.175" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.173; MBh 1.175" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.175" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxxv> ] .

:tara a aoa:Person ;
    rdfs:label "Tara" ;
    rdfs:comment "Vali's wise wife, daughter of Sushena. After Vali's death she marries Sugriva." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-vanara ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.19" ; schema:url <https://valmikiramayan.net/kish/sarga19/kishkindha_19_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.22" ; schema:url <https://valmikiramayan.net/kish/sarga22/kishkindha_22_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.33" ; schema:url <https://valmikiramayan.net/kish/sarga33/kishkindha_33_frame.htm> ] .

:tataka a aoa:Person ;
    rdfs:label "Tataka" ;
    rdfs:comment "Yakshi, daughter of Suketu, turned into a rakshasi. Mother of Maricha. Rama kills her on Vishvamitra's word." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-rakshasa ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :maricha ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.25" ; schema:url <https://valmikiramayan.net/baala/sarga25/bala_5F25_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.26" ; schema:url <https://valmikiramayan.net/baala/sarga26/bala_26_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Aranya 3.38" ; schema:url <https://valmikiramayan.net/aranya/sarga38/aranya_38_frame.htm> ] .

:tilottama a aoa:Person ;
    rdfs:label "Tilottama" ;
    rdfs:comment "Apsara Vishvakarma makes from the finest part of everything, to divide Sunda and Upasunda." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-apsara ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.213" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxiii> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.214" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxiv> ] .

:trijata a aoa:Person ;
    rdfs:label "Trijata" ;
    rdfs:comment "Rakshasi guard who dreams of Ravana's fall and befriends Sita." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-rakshasa ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Sundara 5.27" ; schema:url <https://valmikiramayan.net/sundara/sarga27/sundara_27_prose.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Yuddha 6.48" ; schema:url <https://valmikiramayan.net/yuddha/sarga48/yuddha_48_frame.htm> ] .

:trishanku a aoa:Person ;
    rdfs:label "Trishanku" ;
    rdfs:comment "King who wants to enter heaven in his body. Vashishtha refuses, so Vishvamitra sends him up himself. The devas push him back, and he hangs upside down in a heaven of his own." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.57" ; schema:url <https://valmikiramayan.net/baala/sarga57/bala_57_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.60" ; schema:url <https://valmikiramayan.net/baala/sarga60/bala_60_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Ayodhya 2.110" ; schema:url <https://valmikiramayan.net/ayodhya/sarga110/ayodhya_110_prose.htm> ] .

:urmila a aoa:Person ;
    rdfs:label "Urmila" ;
    rdfs:comment "Sita's sister and Lakshmana's wife, who stays in Ayodhya through the exile." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.71" ; schema:url <https://valmikiramayan.net/baala/sarga71/bala_71_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.73" ; schema:url <https://valmikiramayan.net/baala/sarga73/bala_73_frame.htm> ] .

:urvashi a aoa:Person, aoa:SpansYugas ;
    rdfs:label "Urvashi" ;
    rdfs:comment "Apsara who lives with Pururavas on conditions the Gandharvas trick him into breaking. Mother of Ayu. In the Dvapara she curses Arjuna to live as a eunuch, and Indra limits the curse to one year." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-apsara ;
    aoa:role aoa:role-woman ;
    aoa:parentOf :ayu ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 3.46" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-xlvi> ] .

:vali a aoa:Person ;
    rdfs:label "Vali" ;
    rdfs:comment "Vanara king, son of Indra. Rama kills him from hiding while he fights Sugriva. In the Uttara Kanda he once humbled Ravana." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-vanara ;
    aoa:role aoa:role-king ;
    aoa:parentOf :angada ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.8" ; schema:url <https://valmikiramayan.net/kish/sarga8/kishkindha_8_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.10" ; schema:url <https://valmikiramayan.net/kish/sarga10/kishkindha_10_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.16" ; schema:url <https://valmikiramayan.net/kish/sarga16/kishkindha_16_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.17" ; schema:url <https://valmikiramayan.net/kish/sarga17/kishkindha_17_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.19" ; schema:url <https://valmikiramayan.net/kish/sarga19/kishkindha_19_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Kishkindha 4.26" ; schema:url <https://valmikiramayan.net/kish/sarga26/kishkindha_26_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Yuddha 6.41" ; schema:url <https://valmikiramayan.net/yuddha/sarga41/yuddha_41_frame.htm> ] .

:valmiki a aoa:Sage ;
    rdfs:label "Valmiki" ;
    rdfs:comment "Sage-poet who composes the Ramayana. Shelters Sita in her exile and teaches the poem to Lava and Kusha." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.1" ; schema:url <https://valmikiramayan.net/baala/sarga1/bala_1_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.4" ; schema:url <https://valmikiramayan.net/baala/sarga4/bala_4_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.93" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424868.html> ] .

:vamana a aoa:Avatar ;
    rdfs:label "Vamana" ;
    rdfs:comment "Fifth avatar, the dwarf brahmin who asks Bali for three steps of land and covers the three worlds." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-god ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 1.3" ; schema:url <https://vedabase.io/en/library/sb/1/3/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 6.18" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.19-8.20" ; schema:url <https://vedabase.io/en/library/sb/8/19/> ] ,
        [ a aoa:Citation ; rdfs:label "Bhagavata 8.21" ; schema:url <https://vedabase.io/en/library/sb/8/21/> ] .

:vashishtha a aoa:Sage, aoa:SpansYugas ;
    rdfs:label "Vashishtha" ;
    rdfs:comment "Mind-born son of Brahma and priest of the Ikshvakus. Old rival of Vishvamitra. His curse sends the eight Vasus into human birth. Great-grandfather of Vyasa." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.18" ; schema:url <https://valmikiramayan.net/baala/sarga18/bala_18_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.56" ; schema:url <https://valmikiramayan.net/baala/sarga56/bala_56_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.57" ; schema:url <https://valmikiramayan.net/baala/sarga57/bala_57_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.70" ; schema:url <https://valmikiramayan.net/baala/sarga70/bala_70_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Ayodhya 2.111" ; schema:url <https://valmikiramayan.net/ayodhya/sarga111/ayodhya_111_prose.htm> ] ,
