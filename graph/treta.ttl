@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

:agastya a yc:Sage, yc:SpansYugas ;
    rdfs:label "Agastya" ;
    rdfs:comment "Sage who curses Nahusha into a python. In the Ramayana he gives Rama divine weapons." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Aranya 3.12" ; schema:url <https://valmikiramayan.net/aranya/sarga12/aranya_12_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.108" ; schema:url <https://valmikiramayan.net/yuddha/sarga108/yuddha_108_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.104-105" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.104" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-civ> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.178" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxviii> ] .

:agastyaocean a yc:Event, yc:Catastrophe ;
    rdfs:label "Agastya drinks the ocean" ;
    rdfs:comment "The Kalakeya demons hide in the ocean after Vritra's death. Agastya drinks the whole sea so the gods can reach them (Vana Parva)." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 3.100-101" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-ci> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.101, 3.104-105" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.104-105" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cv> ] .

:ahalya a yc:Person ;
    rdfs:label "Ahalya" ;
    rdfs:comment "Gautama's wife, cursed after Indra's deception and freed by Rama's visit." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.48" ; schema:url <https://valmikiramayan.net/baala/sarga48/bala_48_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.49" ; schema:url <https://valmikiramayan.net/baala/sarga49/bala_49_frame.htm> ] .

:ahiravana a yc:Person ;
    rdfs:label "Ahiravana" ;
    rdfs:comment "Ravana's brother in later tellings, king of the underworld, who kidnaps Rama and Lakshmana. Hanuman kills him in his five-faced form." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-folk ;
    yc:being yc:being-rakshasa .

:aja a yc:Person ;
    rdfs:label "Aja" ;
    rdfs:comment "Father of Dasharatha. In Valmiki's king list he is the son of Nabhaga, about eleven generations after Raghu; Kalidasa makes him Raghu's son." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :dasharatha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.70" ; schema:url <https://valmikiramayan.net/baala/sarga70/bala_70_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.110" ; schema:url <https://valmikiramayan.net/ayodhya/sarga110/ayodhya_110_prose.htm> ] .

:akshayakumara a yc:Person ;
    rdfs:label "Aksha" ;
    rdfs:comment "Aksha, Ravana's son, killed by Hanuman at the Ashoka grove." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Sundara 5.47" ; schema:url <https://valmikiramayan.net/sundara/sarga47/sundara_47_prose.htm> ] .

:ambarisha a yc:Person ;
    rdfs:label "Ambarisha" ;
    rdfs:comment "Devout king of Manu's line through Nabhaga. When Durvasa curses him, Vishnu's Sudarshana disc chases the sage until he begs Ambarisha's pardon (Bhagavata)." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-purana ;
    yc:being yc:being-human ;
    yc:role yc:role-king .

:amshuman a yc:Person ;
    rdfs:label "Amshuman" ;
    rdfs:comment "Sagara's grandson. Finds the horse at Kapila's hermitage and learns that only Ganga can free his uncles." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:parentOf :dilipa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.38" ; schema:url <https://valmikiramayan.net/baala/sarga38/bala_38_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.41" ; schema:url <https://valmikiramayan.net/baala/sarga41/bala_41_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.42" ; schema:url <https://valmikiramayan.net/baala/sarga42/bala_42_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.110" ; schema:url <https://valmikiramayan.net/ayodhya/sarga110/ayodhya_110_prose.htm> ] .

:anaranya a yc:Person ;
    rdfs:label "Anaranya" ;
    rdfs:comment "Ikshvaku king killed by Ravana. Dying, he curses Ravana to fall to a man of his line." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.70" ; schema:url <https://valmikiramayan.net/baala/sarga70/bala_70_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.110" ; schema:url <https://valmikiramayan.net/ayodhya/sarga110/ayodhya_110_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.60" ; schema:url <https://valmikiramayan.net/yuddha/sarga60/yuddha_60_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.19" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424780.html> ] .

:angada a yc:Person ;
    rdfs:label "Angada" ;
    rdfs:comment "Vali's son, made crown prince by Rama. Rama's envoy to Ravana's court." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-vanara ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Kishkindha 4.26" ; schema:url <https://valmikiramayan.net/kish/sarga26/kishkindha_26_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Kishkindha 4.58" ; schema:url <https://valmikiramayan.net/kish/sarga58/kishkindha_58_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.41" ; schema:url <https://valmikiramayan.net/yuddha/sarga41/yuddha_41_frame.htm> ] .

:anjana a yc:Person ;
    rdfs:label "Anjana" ;
    rdfs:comment "Apsara born as a vanara under a curse. Mother of Hanuman by Vayu." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-vanara ;
    yc:role yc:role-woman ;
    yc:parentOf :hanuman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Kishkindha 4.66" ; schema:url <https://valmikiramayan.net/kish/sarga66/kishkindha_66_frame.htm> ] .

:asamanja a yc:Person ;
    rdfs:label "Asamanja" ;
    rdfs:comment "Sagara's cruel son, banished by his father. Father of Amshuman." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:parentOf :amshuman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.38" ; schema:url <https://valmikiramayan.net/baala/sarga38/bala_38_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.110" ; schema:url <https://valmikiramayan.net/ayodhya/sarga110/ayodhya_110_prose.htm> ] .

:atikaya a yc:Person ;
    rdfs:label "Atikaya" ;
    rdfs:comment "Ravana's giant son, killed by Lakshmana with a weapon of Brahma." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Yuddha 6.71" ; schema:url <https://valmikiramayan.net/yuddha/sarga71/yuddha_71_frame.htm> ] .

:ayu a yc:Person ;
    rdfs:label "Ayu" ;
    rdfs:comment "Son of Pururavas and Urvashi." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :nahusha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] .

:bali a yc:Person, yc:Chiranjivi ;
    rdfs:label "Bali" ;
    rdfs:comment "Asura king, Prahlada's grandson. Vishnu as Vamana takes back the three worlds from him in three steps. Father of Bana." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-asura ;
    yc:role yc:role-king ;
    yc:parentOf :bana ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.65" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxv> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.117" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485658.html> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 6.18, 8.19-8.20, 10.62" ; schema:url <https://vedabase.io/en/library/sb/8/20/> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 6.18" ; schema:url <https://vedabase.io/en/library/sb/6/18/> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 8.19-8.20" ; schema:url <https://vedabase.io/en/library/sb/8/20/> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 10.62" ; schema:url <https://vedabase.io/en/library/sb/10/62/> ] .

:bhagiratha a yc:Person ;
    rdfs:label "Bhagiratha" ;
    rdfs:comment "Dilipa's son, whose penance finally brings Ganga down from heaven to free the souls of Sagara's sons. One of the Mahabharata's sixteen great kings." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:ancestorOf :raghu ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.42" ; schema:url <https://valmikiramayan.net/baala/sarga42/bala_42_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.70" ; schema:url <https://valmikiramayan.net/baala/sarga70/bala_70_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.110" ; schema:url <https://valmikiramayan.net/ayodhya/sarga110/ayodhya_110_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.108-109" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cix> ] .

:bharadvaja a yc:Sage ;
    rdfs:label "Bharadvaja" ;
    rdfs:comment "Sage whom the Puranas say Bharata adopted. Rama visits his hermitage at Prayaga. Father of Drona." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    yc:parentOf :drona ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Ayodhya 2.54" ; schema:url <https://valmikiramayan.net/ayodhya/sarga54/ayodhya_54_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.131" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxxi> ] .

:bharata a yc:Person ;
    rdfs:label "Bharata" ;
    rdfs:comment "Son of Dushyanta and Shakuntala. The Bharata race takes its name from him, and with it the epic's title. Later tradition names Bharatavarsha after him." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:ancestorOf :hasti ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.74; MBh 1.94" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxiv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.74" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxiv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 5.4" ; schema:url <https://vedabase.io/en/library/sb/5/4/> ] .

:bharatar a yc:Person ;
    rdfs:label "Bharata of Ayodhya" ;
    rdfs:comment "Rama's half-brother, Kaikeyi's son. Refuses the throne and rules with Rama's sandals on it." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.18" ; schema:url <https://valmikiramayan.net/baala/sarga18/bala_18_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.73" ; schema:url <https://valmikiramayan.net/baala/sarga73/bala_73_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.72" ; schema:url <https://valmikiramayan.net/ayodhya/sarga72/ayodhya_72_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.73" ; schema:url <https://valmikiramayan.net/ayodhya/sarga73/ayodhya_73_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.115" ; schema:url <https://valmikiramayan.net/ayodhya/sarga115/ayodhya_115_prose.htm> ] .

:damayanti a yc:Person ;
    rdfs:label "Damayanti" ;
    rdfs:comment "Princess of Vidarbha who picks Nala over the gods at her svayamvara and finds him again after their separation." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 3.53, 3.57, 3.77" ; schema:url <https://www.sacred-texts.com/hin/m03/m03057.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.57" ; schema:url <https://www.sacred-texts.com/hin/m03/m03057.htm> ] .

:dasharatha a yc:Person ;
    rdfs:label "Dasharatha" ;
    rdfs:comment "King of Ayodhya. Bound by Kaikeyi's boons, he exiles Rama and dies of grief, as the father of the boy he shot had cursed." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :bharatar, :lakshmana, :rama, :shatrughna ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.11" ; schema:url <https://valmikiramayan.net/baala/sarga11/bala_11_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.15" ; schema:url <https://valmikiramayan.net/baala/sarga15/bala_15_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.16" ; schema:url <https://valmikiramayan.net/baala/sarga16/bala_16_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.18" ; schema:url <https://valmikiramayan.net/baala/sarga18/bala_18_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.70" ; schema:url <https://valmikiramayan.net/baala/sarga70/bala_70_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.11" ; schema:url <https://valmikiramayan.net/ayodhya/sarga11/ayodhya_11_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.40" ; schema:url <https://valmikiramayan.net/ayodhya/sarga40/ayodhya_5F40_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.63" ; schema:url <https://valmikiramayan.net/ayodhya/sarga63/ayodhya_63_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.64" ; schema:url <https://valmikiramayan.net/ayodhya/sarga64/ayodhya_64_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.72" ; schema:url <https://valmikiramayan.net/ayodhya/sarga72/ayodhya_72_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.78" ; schema:url <https://valmikiramayan.net/ayodhya/sarga78/ayodhya_78_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.110" ; schema:url <https://valmikiramayan.net/ayodhya/sarga110/ayodhya_110_prose.htm> ] .

:devayani a yc:Person ;
    rdfs:label "Devayani" ;
    rdfs:comment "Shukracharya's daughter. Rejected by Kacha, she marries Yayati and makes the princess Sharmishtha her servant. Mother of Yadu." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :yadu ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.76" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.77; MBh 1.80; MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.77" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.80" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxx> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 1.30" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485507.html> ] .

:dilipa a yc:Person ;
    rdfs:label "Dilipa" ;
    rdfs:comment "Amshuman's son, who also tries and fails to bring Ganga down. Father of Bhagiratha." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :bhagiratha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.42" ; schema:url <https://valmikiramayan.net/baala/sarga42/bala_42_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.110" ; schema:url <https://valmikiramayan.net/ayodhya/sarga110/ayodhya_110_prose.htm> ] .

:dushyanta a yc:Person ;
    rdfs:label "Dushyanta" ;
    rdfs:comment "Puru-line king who marries Shakuntala. When she brings their son to court he pretends not to know her, to protect her name, until a voice from heaven confirms the boy. In Kalidasa's play he forgets her under a curse." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :bharata ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.68; MBh 1.74" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.73; MBh 1.74" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxiii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.74" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxiv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] .

:dvivida a yc:Person ;
    rdfs:label "Dvivida" ;
    rdfs:comment "Vanara in Rama's army. In the Bhagavata he lives on into the Dvapara, turns rogue, and is killed by Balarama." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-vanara ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 2.116" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485657.html> ] .

:gautama a yc:Sage ;
    rdfs:label "Gautama" ;
    rdfs:comment "Sage who curses his wife Ahalya after Indra seduces her. Grandfather of Kripa and Kripi through Sharadvan." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.48" ; schema:url <https://valmikiramayan.net/baala/sarga48/bala_48_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.130" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxx> ] .

:guha a yc:Person ;
    rdfs:label "Guha" ;
    rdfs:comment "Nishada chief and Rama's friend, who ferries him across the Ganga." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Ayodhya 2.52" ; schema:url <https://valmikiramayan.net/ayodhya/sarga52/ayodhya_52_prose.htm> ] .

:hanuman a yc:Person, yc:Chiranjivi ;
    rdfs:label "Hanuman" ;
    rdfs:comment "Son of Vayu and one of the chiranjivis. Finds Sita in Lanka. Meets his half-brother Bhima in the Vana Parva and rides on Arjuna's flag at Kurukshetra." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-vanara ;
    yc:kills :akshayakumara, :simhika ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Kishkindha 4.3" ; schema:url <https://valmikiramayan.net/kish/sarga3/kishkindha_3_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Kishkindha 4.66" ; schema:url <https://valmikiramayan.net/kish/sarga66/kishkindha_66_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Sundara 5.1" ; schema:url <https://valmikiramayan.net/sundara/sarga1/sundara_1_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Sundara 5.3" ; schema:url <https://valmikiramayan.net/sundara/sarga3/sundara_3_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Sundara 5.15" ; schema:url <https://valmikiramayan.net/sundara/sarga15/sundara_15_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Sundara 5.35" ; schema:url <https://valmikiramayan.net/sundara/sarga35/sundara_35_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Sundara 5.47" ; schema:url <https://valmikiramayan.net/sundara/sarga47/sundara_47_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Sundara 5.54" ; schema:url <https://valmikiramayan.net/sundara/sarga54/sundara_54_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.74" ; schema:url <https://valmikiramayan.net/yuddha/sarga74/yuddha_74_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.35" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424801.html> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.146" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxlvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.150" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cl> ] .

:harishchandra a yc:Person ;
    rdfs:label "Harishchandra" ;
    rdfs:comment "Ikshvaku king famed for never breaking his word. He is not in Valmiki's king list; the Aitareya Brahmana tells of him and his son Rohita, and the Puranas make him Trishanku's son. The Markandeya Purana has Vishvamitra take his kingdom." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :rohita .

:hasti a yc:Person ;
    rdfs:label "Hasti" ;
    rdfs:comment "Descendant of Bharata. Founds Hastinapura, the Kuru capital." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:ancestorOf :samvarana ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] .

:indrajit a yc:Person ;
    rdfs:label "Indrajit" ;
    rdfs:comment "Meghanada, son of Ravana and Mandodari, called the conqueror of Indra. Killed by Lakshmana." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Sundara 5.48" ; schema:url <https://valmikiramayan.net/sundara/sarga48/sundara_48_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.90" ; schema:url <https://valmikiramayan.net/yuddha/sarga90/yuddha_90_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.92" ; schema:url <https://valmikiramayan.net/yuddha/sarga92/yuddha_92_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.111" ; schema:url <https://valmikiramayan.net/yuddha/sarga111/yuddha_111_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.12" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424773.html> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.29" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424795.html> ] .

:indumati a yc:Person ;
    rdfs:label "Indumati" ;
    rdfs:comment "Princess of Vidarbha who chooses Aja at her svayamvara. Her early death leaves him heartbroken (Kalidasa's Raghuvamsha)." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-purana ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :dasharatha .

:jahnu a yc:Event, yc:Catastrophe ;
    rdfs:label "Jahnu swallows the Ganga" ;
    rdfs:comment "The descending Ganga floods the sage Jahnu's sacrifice, so he drinks her up. When the gods and sages appease him he lets her out from his ears, and she is called Jahnavi." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.43" ; schema:url <https://valmikiramayan.net/baala/sarga43/bala_43_frame.htm> ] .

:jamadagni a yc:Sage ;
    rdfs:label "Jamadagni" ;
    rdfs:comment "Sage of the Bhrigu line, father of Parashurama. Kartavirya takes the calf of the cow that gives his sacrificial butter, and Kartavirya's sons later kill him (Vana Parva)." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    yc:parentOf :parashurama ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.75" ; schema:url <https://valmikiramayan.net/baala/sarga75/bala_75_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.116" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.116-117" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxvi> ] .

:jambavan a yc:Person, yc:SpansYugas ;
    rdfs:label "Jambavan" ;
    rdfs:comment "Son of Brahma and an elder of Rama's army, usually shown as king of the bears. Reminds Hanuman of his powers. In the Dvapara he fights Krishna over the Syamantaka gem." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-riksha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Kishkindha 4.41" ; schema:url <https://valmikiramayan.net/kish/sarga41/kishkindha_41_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Kishkindha 4.66" ; schema:url <https://valmikiramayan.net/kish/sarga66/kishkindha_66_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 1.38" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485515.html> ] .

:janaka a yc:Person ;
    rdfs:label "Janaka" ;
    rdfs:comment "King of Videha who finds Sita in a furrow. Sets Shiva's bow as the test for her hand." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :urmila ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.66" ; schema:url <https://valmikiramayan.net/baala/sarga66/bala_66_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.71" ; schema:url <https://valmikiramayan.net/baala/sarga71/bala_71_frame.htm> ] .

:jatayu a yc:Person ;
    rdfs:label "Jatayu" ;
    rdfs:comment "Vulture king, son of Aruna. Fights Ravana to stop Sita's abduction and is cut down." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-beast ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Aranya 3.14" ; schema:url <https://valmikiramayan.net/aranya/sarga14/aranya_14_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Aranya 3.51" ; schema:url <https://valmikiramayan.net/aranya/sarga51/aranya_51_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Kishkindha 4.58" ; schema:url <https://valmikiramayan.net/kish/sarga58/kishkindha_58_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] .

:kabandha a yc:Person ;
    rdfs:label "Kabandha" ;
    rdfs:comment "Headless demon with a mouth in his belly. Freed by Rama, he sends him to Sugriva." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Aranya 3.72" ; schema:url <https://valmikiramayan.net/aranya/sarga72/aranya_72_frame.htm> ] .

:kacha a yc:Person ;
    rdfs:label "Kacha" ;
    rdfs:comment "Son of Brihaspati. The gods send him to learn the Sanjivani art from Shukracharya. Devayani loves him, and when he refuses her they curse each other (Adi Parva)." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.76; MBh 1.77" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.76" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.77" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxvii> ] .

:kaikasi a yc:Person ;
    rdfs:label "Kaikasi" ;
    rdfs:comment "Sumali's daughter and Vishrava's wife. Mother of Ravana, Kumbhakarna, Vibhishana and Shurpanakha." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-rakshasa ;
    yc:role yc:role-woman ;
    yc:parentOf :kumbhakarna, :ravana, :shurpanakha, :vibhishana ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Uttara 7.9" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424770.html> ] .

:kaikeyi a yc:Person ;
    rdfs:label "Kaikeyi" ;
    rdfs:comment "Dasharatha's queen. Uses two old boons to make her son Bharata king and send Rama into exile." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :bharatar ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.16" ; schema:url <https://valmikiramayan.net/baala/sarga16/bala_16_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.18" ; schema:url <https://valmikiramayan.net/baala/sarga18/bala_18_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.9" ; schema:url <https://valmikiramayan.net/ayodhya/sarga9/ayodhya_9_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.11" ; schema:url <https://valmikiramayan.net/ayodhya/sarga11/ayodhya_11_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.73" ; schema:url <https://valmikiramayan.net/ayodhya/sarga73/ayodhya_73_prose.htm> ] .

:kailasa a yc:Event ;
    rdfs:label "Lifting Kailasa" ;
    rdfs:comment "Ravana tries to lift Shiva's mountain. Shiva presses it down with a toe and pins him for a thousand years. His roar gives him the name Ravana, and Shiva gives him the sword Chandrahasa." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Uttara 7.16" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424777.html> ] .

:kalidemon a yc:Person ;
    rdfs:label "Kali (demon)" ;
    rdfs:comment "Spirit of the Kali Yuga, who possesses Nala out of jealousy." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-asura ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.67" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.58-59" ; schema:url <https://www.sacred-texts.com/hin/m03/m03058.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.59" ; schema:url <https://www.sacred-texts.com/hin/m03/m03059.htm> ] .

:kapila a yc:Sage ;
    rdfs:label "Kapila" ;
    rdfs:comment "Sage counted as an avatar of Vishnu and teacher of Samkhya. Burns Sagara's sons to ash with a single sound." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.40" ; schema:url <https://valmikiramayan.net/baala/sarga40/bala_5F40_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.41" ; schema:url <https://valmikiramayan.net/baala/sarga41/bala_41_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 1.3, 3.24" ; schema:url <https://vedabase.io/en/library/sb/1/3/> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 3.24" ; schema:url <https://vedabase.io/en/library/sb/3/24/> ] .

:kartavirya a yc:Person ;
    rdfs:label "Kartavirya Arjuna" ;
    rdfs:comment "Thousand-armed Haihaya king of Yadu's line. Once holds Ravana captive. Seizes Jamadagni's cow and is killed by Parashurama." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.75" ; schema:url <https://valmikiramayan.net/baala/sarga75/bala_75_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.116" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.116-117" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxvi> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 1.33" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485510.html> ] .

:kausalya a yc:Person ;
    rdfs:label "Kausalya" ;
    rdfs:comment "Dasharatha's chief queen and Rama's mother." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :rama ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.16" ; schema:url <https://valmikiramayan.net/baala/sarga16/bala_16_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.18" ; schema:url <https://valmikiramayan.net/baala/sarga18/bala_18_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.20" ; schema:url <https://valmikiramayan.net/ayodhya/sarga20/ayodhya_20_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.64" ; schema:url <https://valmikiramayan.net/ayodhya/sarga64/ayodhya_64_prose.htm> ] .

:kesari a yc:Person ;
    rdfs:label "Kesari" ;
    rdfs:comment "Vanara chief and Anjana's husband. Hanuman, Vayu's son, is called Kesari's son through his wife." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-vanara ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Kishkindha 4.66" ; schema:url <https://valmikiramayan.net/kish/sarga66/kishkindha_66_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Sundara 5.35" ; schema:url <https://valmikiramayan.net/sundara/sarga35/sundara_35_prose.htm> ] .

:khara a yc:Person ;
    rdfs:label "Khara & Dushana" ;
    rdfs:comment "Shurpanakha's brothers, killed with their army of 14,000 by Rama at Janasthana." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Aranya 3.17" ; schema:url <https://valmikiramayan.net/aranya/sarga17/aranya_17_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Aranya 3.30" ; schema:url <https://valmikiramayan.net/aranya/sarga30/aranya_30_frame.htm> ] .

:kshatriya21 a yc:Event, yc:Catastrophe ;
    rdfs:label "Kshatriyas wiped out 21 times" ;
    rdfs:comment "After Kartavirya's sons kill Jamadagni, Parashurama clears the earth of kshatriyas thrice seven times and fills five lakes with their blood at Samantapanchaka, later Kurukshetra." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.75" ; schema:url <https://valmikiramayan.net/baala/sarga75/bala_75_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.116-117" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.117" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxvii> ] .

:kumbhakarna a yc:Person ;
    rdfs:label "Kumbhakarna" ;
    rdfs:comment "Ravana's giant brother. Brahma curses him to sleep six months at a time; the Uttara Kanda tells it as a boon twisted by Saraswati. Vijaya's second birth in the Bhagavata. Killed by Rama." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Aranya 3.17" ; schema:url <https://valmikiramayan.net/aranya/sarga17/aranya_17_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.61" ; schema:url <https://valmikiramayan.net/yuddha/sarga61/yuddha_61_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.67" ; schema:url <https://valmikiramayan.net/yuddha/sarga67/yuddha_67_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.9" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424770.html> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.10" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424771.html> ] ,
        [ a yc:Citation ; rdfs:label "Bhagavata 7.1" ; schema:url <https://vedabase.io/en/library/sb/7/1/> ] .

:kuru a yc:Person ;
    rdfs:label "Kuru" ;
    rdfs:comment "Son of Samvarana and Tapati. Kurukshetra, made holy by his austerities, takes his name, and so do the Kurus and the Kauravas." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:ancestorOf :pratipa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.94" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.94; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] .

:lakshmana a yc:Person ;
    rdfs:label "Lakshmana" ;
    rdfs:comment "Rama's brother and companion in exile, Shesha incarnate in the Puranas. Kills Indrajit." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:kills :atikaya, :indrajit ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.18" ; schema:url <https://valmikiramayan.net/baala/sarga18/bala_18_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.73" ; schema:url <https://valmikiramayan.net/baala/sarga73/bala_73_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.40" ; schema:url <https://valmikiramayan.net/ayodhya/sarga40/ayodhya_5F40_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Aranya 3.18" ; schema:url <https://valmikiramayan.net/aranya/sarga18/aranya_18_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.71" ; schema:url <https://valmikiramayan.net/yuddha/sarga71/yuddha_71_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.90" ; schema:url <https://valmikiramayan.net/yuddha/sarga90/yuddha_90_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.101" ; schema:url <https://valmikiramayan.net/yuddha/sarga101/yuddha_101_frame.htm> ] .

:lankaburn a yc:Event, yc:Catastrophe ;
    rdfs:label "Lanka burned" ;
    rdfs:comment "Ravana has Hanuman's tail set alight. Hanuman leaps across the roofs and burns the city." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Sundara 5.53" ; schema:url <https://valmikiramayan.net/sundara/sarga53/sundara_53_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Sundara 5.54" ; schema:url <https://valmikiramayan.net/sundara/sarga54/sundara_54_prose.htm> ] .

:lankini a yc:Person ;
    rdfs:label "Lankini" ;
    rdfs:comment "The city of Lanka in her own form, guarding the gate. Later tellings call her Lankini. Hanuman knocks her down and she lets him in." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Sundara 5.3" ; schema:url <https://valmikiramayan.net/sundara/sarga3/sundara_3_prose.htm> ] .

:lavakusha a yc:Person ;
    rdfs:label "Lava & Kusha" ;
    rdfs:comment "Twin sons of Rama and Sita, born in Valmiki's hermitage. They sing the Ramayana at Rama's court." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.4" ; schema:url <https://valmikiramayan.net/baala/sarga4/bala_4_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.66" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424840.html> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.93" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424868.html> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.94" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424869.html> ] .

:mahabhisha a yc:Person ;
    rdfs:label "Mahabhisha" ;
    rdfs:comment "Ikshvaku king who reached heaven. Brahma curses him to be reborn for gazing at Ganga, and he returns as Shantanu (Adi Parva). His yuga is not specified." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:rebornAs :shantanu ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.96; MBh 1.97" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.96" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcvi> ] .

:mandavi a yc:Person ;
    rdfs:label "Mandavi" ;
    rdfs:comment "Bharata's wife, a niece of Janaka." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.72" ; schema:url <https://valmikiramayan.net/baala/sarga72/bala_72_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.73" ; schema:url <https://valmikiramayan.net/baala/sarga73/bala_73_frame.htm> ] .

:mandhata a yc:Person ;
    rdfs:label "Mandhata" ;
    rdfs:comment "Ikshvaku emperor, son of Yuvanashva. In Valmiki he comes after Trishanku and Dhundhumara, and his son is Susandhi. One of the sixteen great kings the Mahabharata lists. The Harivamsa makes Muchukunda his son." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :muchukunda ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.70" ; schema:url <https://valmikiramayan.net/baala/sarga70/bala_70_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.110" ; schema:url <https://valmikiramayan.net/ayodhya/sarga110/ayodhya_110_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 1.12" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485489.html> ] .

:mandodari a yc:Person ;
    rdfs:label "Mandodari" ;
    rdfs:comment "Ravana's chief queen and mother of Indrajit. She calls herself Sumali's granddaughter; the Uttara Kanda names her father as Maya." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    yc:role yc:role-woman ;
    yc:parentOf :indrajit ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Sundara 5.10" ; schema:url <https://valmikiramayan.net/sundara/sarga10/sundara_10_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.111" ; schema:url <https://valmikiramayan.net/yuddha/sarga111/yuddha_111_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.12" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424773.html> ] .

:manthara a yc:Person ;
    rdfs:label "Manthara" ;
    rdfs:comment "Kaikeyi's hunchbacked maid, who persuades her to claim her two boons." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Ayodhya 2.7" ; schema:url <https://valmikiramayan.net/ayodhya/sarga7/ayodhya_7_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.9" ; schema:url <https://valmikiramayan.net/ayodhya/sarga9/ayodhya_9_prose.htm> ] .

:maricha a yc:Person ;
    rdfs:label "Maricha" ;
    rdfs:comment "Tataka's son. Rama spares him at Vishvamitra's sacrifice, hurling him into the ocean. Later he becomes the golden deer that draws Rama away, and Rama kills him." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.25" ; schema:url <https://valmikiramayan.net/baala/sarga25/bala_5F25_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.30" ; schema:url <https://valmikiramayan.net/baala/sarga30/bala_30_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Aranya 3.38" ; schema:url <https://valmikiramayan.net/aranya/sarga38/aranya_38_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Aranya 3.44" ; schema:url <https://valmikiramayan.net/aranya/sarga44/aranya_44_frame.htm> ] .

:mayasura a yc:Person, yc:SpansYugas ;
    rdfs:label "Mayasura" ;
    rdfs:comment "Architect of the asuras and father of Mandodari. In the Dvapara, Arjuna spares him in the Khandava fire, and he builds the Pandavas' Maya Sabha." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-asura ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Yuddha 6.111" ; schema:url <https://valmikiramayan.net/yuddha/sarga111/yuddha_111_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.12" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424773.html> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.230; MBh 2.1" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxx> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.230; 2.1" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxxx> ] .

:menaka a yc:Person ;
    rdfs:label "Menaka" ;
    rdfs:comment "Apsara sent by Indra to break Vishvamitra's penance. Mother of Shakuntala." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-apsara ;
    yc:role yc:role-woman ;
    yc:parentOf :shakuntala ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.71; MBh 1.72" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.71" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.72" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxii> ] .

:muchukunda a yc:Person, yc:SpansYugas ;
    rdfs:label "Muchukunda" ;
    rdfs:comment "Son of Mandhata. After fighting for the devas he asks for undisturbed sleep, and whoever wakes him burns. He sleeps into the Dvapara, when Krishna leads Kalayavana into his cave." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Harivamsa 1.12" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485489.html> ] ,
        [ a yc:Citation ; rdfs:label "Harivamsa 2.58" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485599.html> ] .

:nahusha a yc:Person ;
    rdfs:label "Nahusha" ;
    rdfs:comment "Son of Ayu. Rules heaven as Indra for a time, until Agastya curses him into a python. In the Vana Parva he seizes Bhima, and Yudhishthira's answers free him." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :yayati ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.178, 3.180" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.178" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxviii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.180" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-clxxx> ] .

:nala a yc:Person ;
    rdfs:label "Nala (vanara)" ;
    rdfs:comment "Son of Vishvakarma, who leads the building of the bridge to Lanka." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-vanara ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Yuddha 6.22" ; schema:url <https://valmikiramayan.net/yuddha/sarga22/yuddha_22_frame.htm> ] .

:nalak a yc:Person ;
    rdfs:label "Nala" ;
    rdfs:comment "King of Nishadha who loses everything at dice when the demon Kali possesses him. His story is told to Yudhishthira, another king ruined by dice." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 3.52, 3.59" ; schema:url <https://www.sacred-texts.com/hin/m03/m03052.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.52" ; schema:url <https://www.sacred-texts.com/hin/m03/m03052.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.57" ; schema:url <https://www.sacred-texts.com/hin/m03/m03057.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.59" ; schema:url <https://www.sacred-texts.com/hin/m03/m03059.htm> ] .

:nalakuvara a yc:Person ;
    rdfs:label "Nalakuvara" ;
    rdfs:comment "Kubera's son. After Ravana assaults his wife Rambha, he curses Ravana that his head will split if he forces any unwilling woman." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-yaksha ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Yuddha 6.60" ; schema:url <https://valmikiramayan.net/yuddha/sarga60/yuddha_60_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.26" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424792.html> ] .

:nandi a yc:Person ;
    rdfs:label "Nandi" ;
    rdfs:comment "Shiva's attendant. When Ravana mocks his monkey face, Nandi curses him that monkeys will ruin his kingdom." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-beast ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Yuddha 6.60" ; schema:url <https://valmikiramayan.net/yuddha/sarga60/yuddha_60_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.16" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424777.html> ] .

:narada a yc:Sage, yc:SpansYugas ;
    rdfs:label "Narada" ;
    rdfs:comment "Wandering divine sage. Tells Valmiki the story of Rama and turns up throughout the Mahabharata with advice and news." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.1" ; schema:url <https://valmikiramayan.net/baala/sarga1/bala_1_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.211-214" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-ccxi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 2.5" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-2-sabha-parva/section-v> ] .

:nila a yc:Person ;
    rdfs:label "Nila" ;
    rdfs:comment "Son of Agni and commander of Rama's army. Kills Prahasta." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-vanara ;
    yc:kills :prahasta ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Kishkindha 4.41" ; schema:url <https://valmikiramayan.net/kish/sarga41/kishkindha_41_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.30" ; schema:url <https://valmikiramayan.net/yuddha/sarga30/yuddha_30_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.58" ; schema:url <https://valmikiramayan.net/yuddha/sarga58/yuddha_58_frame.htm> ] .

:parashurama a yc:Avatar, yc:Chiranjivi ;
    rdfs:label "Parashurama" ;
    rdfs:comment "Sixth avatar of Vishnu. Kills Kartavirya and clears the earth of kshatriyas 21 times. Yields to Rama, and lives on into the Dvapara to teach Bhishma, Drona and Karna." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-god ;
    yc:kills :kartavirya ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.75" ; schema:url <https://valmikiramayan.net/baala/sarga75/bala_75_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.76" ; schema:url <https://valmikiramayan.net/baala/sarga76/bala_76_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.66" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.131" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-cxxxi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.116" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxvi> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.117" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxvii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 5.181; MBh 5.188" ; schema:url <https://sacred-texts.com/hin/m05/m05181.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 12.3" ; schema:url <https://sacred-texts.com/hin/m12/m12a003.htm> ] .

:prahasta a yc:Person ;
    rdfs:label "Prahasta" ;
    rdfs:comment "Ravana's commander-in-chief, killed by Nila." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Yuddha 6.58" ; schema:url <https://valmikiramayan.net/yuddha/sarga58/yuddha_58_frame.htm> ] .

:puru a yc:Person ;
    rdfs:label "Puru" ;
    rdfs:comment "Youngest son of Yayati. Takes his father's old age and inherits the kingdom. Ancestor of the Kurus." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:ancestorOf :dushyanta ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.75; MBh 1.83" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.84; MBh 1.85; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxxiv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] .

:pururavas a yc:Person ;
    rdfs:label "Pururavas" ;
    rdfs:comment "Son of Budha and Ila, husband of the apsara Urvashi. The Bhagavata Purana credits him with the three sacred fires that open the Treta Yuga." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :ayu ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] .

:pushpaka a yc:Event ;
    rdfs:label "Pushpaka" ;
    rdfs:comment "Flying chariot Vishvakarma made for Kubera. Ravana seizes it, and Rama flies home to Ayodhya in it." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Aranya 3.48" ; schema:url <https://valmikiramayan.net/aranya/sarga48/aranya_48_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Sundara 5.8" ; schema:url <https://valmikiramayan.net/sundara/sarga8/sundara_8_prose.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.121" ; schema:url <https://valmikiramayan.net/yuddha/sarga121/yuddha_121_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Yuddha 6.122" ; schema:url <https://valmikiramayan.net/yuddha/sarga122/yuddha_122_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.3" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424764.html> ] ,
        [ a yc:Citation ; rdfs:label "Uttara 7.15" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424776.html> ] .

:raghu a yc:Person ;
    rdfs:label "Raghu" ;
    rdfs:comment "Conquering king. Rama's line, the Raghuvamsha, is named after him." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.70" ; schema:url <https://valmikiramayan.net/baala/sarga70/bala_70_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.110" ; schema:url <https://valmikiramayan.net/ayodhya/sarga110/ayodhya_110_prose.htm> ] .

:rama a yc:Avatar ;
    rdfs:label "Rama" ;
    rdfs:comment "Seventh avatar of Vishnu. In the Vana Parva the sage Markandeya tells his whole story (the Ramopakhyana) to Yudhishthira." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-god ;
    yc:role yc:role-king ;
    yc:parentOf :lavakusha ;
