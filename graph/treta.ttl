        [ a aoa:Citation ; rdfs:label "MBh 1.99; MBh 1.177" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcix> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.175" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.179; MBh 1.180" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxxix> ] .

:vedavati a aoa:Person ;
    rdfs:label "Vedavati" ;
    rdfs:comment "Woman doing penance to marry Vishnu. Ravana molests her, and she enters the fire vowing to cause his death. Reborn as Sita (Uttara Kanda)." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-layer ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-woman ;
    aoa:rebornAs :sita ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Uttara 7.17" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424778.html> ] .

:vibhishana a aoa:Person, aoa:Chiranjivi ;
    rdfs:label "Vibhishana" ;
    rdfs:comment "Ravana's brother who joins Rama and becomes king of Lanka. One of the chiranjivis." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-rakshasa ;
    aoa:role aoa:role-king ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Aranya 3.17" ; schema:url <https://valmikiramayan.net/aranya/sarga17/aranya_17_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Sundara 5.52" ; schema:url <https://valmikiramayan.net/sundara/sarga52/sundara_52_prose.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Yuddha 6.17" ; schema:url <https://valmikiramayan.net/yuddha/sarga17/yuddha_17_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Yuddha 6.19" ; schema:url <https://valmikiramayan.net/yuddha/sarga19/yuddha_19_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Yuddha 6.33" ; schema:url <https://valmikiramayan.net/yuddha/sarga33/yuddha_33_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Yuddha 6.112" ; schema:url <https://valmikiramayan.net/yuddha/sarga112/yuddha_112_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.9" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424770.html> ] ,
        [ a aoa:Citation ; rdfs:label "Uttara 7.10" ; schema:url <https://www.wisdomlib.org/hinduism/book/the-ramayana-of-valmiki/d/doc424771.html> ] .

:vindhya a aoa:Event, aoa:Catastrophe ;
    rdfs:label "Vindhya bows" ;
    rdfs:comment "The Vindhya mountain grows until it blocks the sun. Agastya asks it to stop growing until he returns from the south, and he never returns." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 3.104" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-civ> ] .

:viradha a aoa:Person ;
    rdfs:label "Viradha" ;
    rdfs:comment "Rakshasa who seizes Sita as they enter the Dandaka forest. Rama and Lakshmana kill and bury him, freeing a cursed gandharva." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-rakshasa ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Aranya 3.4" ; schema:url <https://valmikiramayan.net/aranya/sarga4/aranya_4_frame.htm> ] .

:vishvamitra a aoa:Sage ;
    rdfs:label "Vishvamitra" ;
    rdfs:comment "King turned brahmarshi, rival of Vashishtha over the cow Shabala. Father of Shakuntala by Menaka in the Mahabharata. Takes young Rama and Lakshmana to guard his sacrifice and leads them to Janaka's bow at Mithila." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-sage ;
    aoa:parentOf :shakuntala ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "Bala 1.27" ; schema:url <https://valmikiramayan.net/baala/sarga27/bala_27_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.56" ; schema:url <https://valmikiramayan.net/baala/sarga56/bala_56_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.60" ; schema:url <https://valmikiramayan.net/baala/sarga60/bala_60_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "Bala 1.63" ; schema:url <https://valmikiramayan.net/baala/sarga63/bala_63_frame.htm> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.72" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxii> ] .

:yadu a aoa:Person ;
    rdfs:label "Yadu" ;
    rdfs:comment "Eldest son of Yayati. Refuses the exchange and loses the throne. Ancestor of the Yadavas." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:ancestorOf :kartavirya, :shura, :ugrasena ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.75; MBh 1.84" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.84; MBh 1.85" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxxiv> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.30" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485507.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.33" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485510.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.34" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485511.html> ] ,
        [ a aoa:Citation ; rdfs:label "Harivamsa 1.37" ; schema:url <https://www.wisdomlib.org/hinduism/book/harivamsha-purana-dutt/d/doc485514.html> ] .

:yayati a aoa:Person ;
    rdfs:label "Yayati" ;
    rdfs:comment "Son of Nahusha. Cursed with old age, he asks his sons to take it. Only Puru agrees." ;
    aoa:period aoa:period-treta ;
    aoa:tier aoa:tier-core ;
    aoa:being aoa:being-human ;
    aoa:role aoa:role-king ;
    aoa:parentOf :puru, :yadu ;
    dcterms:source
        [ a aoa:Citation ; rdfs:label "MBh 1.75; MBh 1.84" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
        [ a aoa:Citation ; rdfs:label "MBh 1.75" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
