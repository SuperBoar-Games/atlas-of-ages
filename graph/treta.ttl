:renuka a yc:Person ;
    rdfs:label "Renuka" ;
    rdfs:comment "Jamadagni's wife. On his order Parashurama beheads her, then asks for and receives her life back." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :parashurama ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 3.116" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-3-vana-parva/section-cxvi> ] .

:rishyashringa a yc:Sage ;
    rdfs:label "Rishyashringa" ;
    rdfs:comment "Sage raised in the forest who has never seen a woman. Brought to Anga to end a drought, he marries Shanta and later performs Dasharatha's sacrifice for sons. Told in both epics." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.10" ; schema:url <https://valmikiramayan.net/baala/sarga10/bala_10_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.15" ; schema:url <https://valmikiramayan.net/baala/sarga15/bala_15_frame.htm> ] .

:rohita a yc:Person ;
    rdfs:label "Rohita" ;
    rdfs:comment "Harishchandra's son, promised to Varuna as a sacrifice and saved." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.70" ; schema:url <https://valmikiramayan.net/baala/sarga70/bala_70_frame.htm> ] .

:ruma a yc:Person ;
    rdfs:label "Ruma" ;
    rdfs:comment "Sugriva's wife, seized by Vali." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-vanara ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Kishkindha 4.10" ; schema:url <https://valmikiramayan.net/kish/sarga10/kishkindha_10_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Kishkindha 4.18" ; schema:url <https://valmikiramayan.net/kish/sarga18/kishkindha_18_frame.htm> ] .

:sagara a yc:Person ;
    rdfs:label "Sagara" ;
    rdfs:comment "Son of Asita, born with poison. Indra steals his Ashvamedha horse in a demon's form, and his 60,000 sons dig up the earth looking for it." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :asamanja, :sagarasons ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.38" ; schema:url <https://valmikiramayan.net/baala/sarga38/bala_38_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.39" ; schema:url <https://valmikiramayan.net/baala/sarga39/bala_39_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.70" ; schema:url <https://valmikiramayan.net/baala/sarga70/bala_70_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Ayodhya 2.110" ; schema:url <https://valmikiramayan.net/ayodhya/sarga110/ayodhya_110_prose.htm> ] .

:sagarasons a yc:Person, yc:Catastrophe ;
    rdfs:label "Sagara's 60,000 sons" ;
    rdfs:comment "They accuse Kapila of stealing the horse and are burned to ash by a single sound from him. Only Ganga's water can free their souls, which is why Bhagiratha brings her down." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.38" ; schema:url <https://valmikiramayan.net/baala/sarga38/bala_38_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.40" ; schema:url <https://valmikiramayan.net/baala/sarga40/bala_5F40_frame.htm> ] .

:sahasrakavacha a yc:Person ;
    rdfs:label "Sahasrakavacha" ;
    rdfs:comment "The demon Dambhodbhava with a thousand armours from Surya. Nara and Narayana break 999 of them. Folk tradition says he is reborn as Karna wearing the last." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-folk ;
    yc:being yc:being-asura .

:sampati a yc:Person ;
    rdfs:label "Sampati" ;
    rdfs:comment "Jatayu's elder brother, whose wings burned when he shielded Jatayu from the sun. He tells the vanaras that Sita is in Lanka." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-beast ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Aranya 3.14" ; schema:url <https://valmikiramayan.net/aranya/sarga14/aranya_14_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Kishkindha 4.58" ; schema:url <https://valmikiramayan.net/kish/sarga58/kishkindha_58_frame.htm> ] .

:samvarana a yc:Person ;
    rdfs:label "Samvarana" ;
    rdfs:comment "Puru-line king who marries Tapati with Vashishtha's help." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-king ;
    yc:parentOf :kuru ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.94; MBh 1.175" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.94; MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xciv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.95" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-xcv> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.175" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-clxxv> ] .

:sanjeevani a yc:Event ;
    rdfs:label "Sanjeevani mountain" ;
    rdfs:comment "Hanuman flies to the Himalaya twice: first for four healing herbs when Indrajit's weapon fells Rama, Lakshmana and the army, then for a whole mountain when Ravana's spear fells Lakshmana and Sushena treats him." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Yuddha 6.74" ; schema:url <https://valmikiramayan.net/yuddha/sarga74/yuddha_74_frame.htm> ] .

:sarama a yc:Person ;
    rdfs:label "Sarama" ;
    rdfs:comment "Rakshasi who guards Sita for Ravana and comforts her. Commentators call her Vibhishana's wife." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-rakshasa ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Yuddha 6.33" ; schema:url <https://valmikiramayan.net/yuddha/sarga33/yuddha_33_frame.htm> ] .

:satyavan a yc:Person ;
    rdfs:label "Satyavan" ;
    rdfs:comment "Savitri's husband, fated to die within a year of marriage." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 3.292" ; schema:url <https://www.sacred-texts.com/hin/m03/m03292.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.293" ; schema:url <https://www.sacred-texts.com/hin/m03/m03293.htm> ] .

:savitri a yc:Person ;
    rdfs:label "Savitri" ;
    rdfs:comment "Princess who follows Yama as he takes her husband Satyavan's life, and wins it back with her answers." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 3.292" ; schema:url <https://www.sacred-texts.com/hin/m03/m03292.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.293" ; schema:url <https://www.sacred-texts.com/hin/m03/m03293.htm> ] ,
        [ a yc:Citation ; rdfs:label "MBh 3.295" ; schema:url <https://www.sacred-texts.com/hin/m03/m03295.htm> ] .

:shabari a yc:Person ;
    rdfs:label "Shabari" ;
    rdfs:comment "Ascetic woman at Lake Pampa who has waited years for Rama. She welcomes him, shows him the Matanga forest, and enters the fire." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Aranya 3.74" ; schema:url <https://valmikiramayan.net/aranya/sarga74/aranya_74_frame.htm> ] .

:shakuntala a yc:Person ;
    rdfs:label "Shakuntala" ;
    rdfs:comment "Daughter of Vishvamitra and Menaka, raised in Kanva's hermitage." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    yc:parentOf :bharata ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.72" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.73; MBh 1.74" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxiii> ] ,
        [ a yc:Citation ; rdfs:label "MBh 1.74" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxiv> ] .

:shanta a yc:Person ;
    rdfs:label "Shanta" ;
    rdfs:comment "Daughter of King Romapada of Anga and wife of Rishyashringa. Later tradition makes her Dasharatha's daughter, adopted by Romapada." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-layer ;
    yc:being yc:being-human ;
    yc:role yc:role-woman ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "Bala 1.10" ; schema:url <https://valmikiramayan.net/baala/sarga10/bala_10_frame.htm> ] ,
        [ a yc:Citation ; rdfs:label "Bala 1.11" ; schema:url <https://valmikiramayan.net/baala/sarga11/bala_11_frame.htm> ] .

:sharmishtha a yc:Person ;
    rdfs:label "Sharmishtha" ;
    rdfs:comment "Asura princess made Devayani's servant. Secretly bears Yayati three sons, the youngest of them Puru." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-asura ;
    yc:role yc:role-woman ;
    yc:parentOf :puru ;
    dcterms:source
        [ a yc:Citation ; rdfs:label "MBh 1.75; MBh 1.83" ; schema:url <https://sacred-texts.com/book/the-mahabharata-book-1-adi-parva/section-lxxv> ] ,
