:valmiki a yc:Sage ;
    rdfs:label "Valmiki" ;
    rdfs:comment "Sage-poet who composes the Ramayana. Shelters Sita in her exile and teaches the poem to Lava and Kusha." ;
    yc:period yc:period-treta ;
    yc:tier yc:tier-core ;
    yc:being yc:being-sage ;
    dcterms:source
